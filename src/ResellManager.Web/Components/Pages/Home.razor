@page "/"
@rendermode InteractiveServer
@inject IDashboardService DashboardService
@inject TimeProvider TimeProvider
@inject ILogger<Home> Logger

<PageTitle>Inicio | ResellManager</PageTitle>

<div class="min-w-0 space-y-8 pb-4">
    <section aria-labelledby="titulo-dashboard">
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-dashboard">Inicio</h1>
    </section>

    @if (CargandoDashboard)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando resumen del negocio...
        </div>
    }
    else if (Dashboard is null)
    {
        <section class="ui-card space-y-4 border-ui-danger/20 p-6" role="alert">
            <h2 class="m-0 text-xl font-semibold text-ui-ink">No fue posible cargar el resumen</h2>
            <p class="m-0 text-sm text-ui-muted">@ErrorDashboard</p>
            <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="button" @onclick="CargarDashboardAsync">Reintentar</button>
        </section>
    }
    else
    {
        <section aria-labelledby="titulo-resumen">
            <h2 class="mt-0 mb-4 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-resumen">Resumen</h2>
            <div class="grid grid-cols-2 gap-3 sm:gap-5 xl:grid-cols-4">
                <article class="ui-card col-span-2 min-w-0 border-ui-accent/20 p-4 sm:col-span-1 sm:p-5">
                    <span class="mb-4 inline-flex size-10 items-center justify-center rounded-2xl bg-ui-accent/10 text-ui-accent"><NavIcon Name="wallet" /></span>
                    <span class="block text-sm font-medium text-ui-muted">Total por cobrar</span>
                    <strong class="mt-2 block text-[clamp(1.35rem,2.5vw,2rem)] font-semibold leading-tight tracking-tight text-ui-accent tabular-nums">@ClientePresentacion.Moneda(Dashboard.TotalAdeudado)</strong>
                    <a class="mt-3 inline-flex min-h-11 items-center text-xs font-medium text-ui-accent no-underline hover:underline sm:text-sm" href="/clientes?saldo=pendiente">Ver saldos de clientes</a>
                </article>
                <article class="ui-card min-w-0 p-4 sm:p-5">
                    <span class="mb-4 inline-flex size-10 items-center justify-center rounded-2xl bg-ui-accent/10 text-ui-accent"><NavIcon Name="boxes" /></span>
                    <span class="block text-sm font-medium text-ui-muted">Unidades disponibles</span>
                    <strong class="mt-2 block text-[clamp(1.35rem,2.5vw,2rem)] font-semibold leading-tight tracking-tight tabular-nums">@Dashboard.UnidadesDisponibles</strong>
                    <a class="mt-3 inline-flex min-h-11 items-center text-xs font-medium text-ui-accent no-underline hover:underline sm:text-sm" href="/inventario?estado=disponible">Ver inventario</a>
                </article>
                <article class="ui-card min-w-0 p-4 sm:p-5">
                    <span class="mb-4 inline-flex size-10 items-center justify-center rounded-2xl bg-ui-warning/10 text-ui-warning"><NavIcon Name="truck" /></span>
                    <span class="block text-sm font-medium text-ui-muted">Pendiente de entregar</span>
                    <strong class="mt-2 block text-[clamp(1.35rem,2.5vw,2rem)] font-semibold leading-tight tracking-tight tabular-nums">@Dashboard.PendientesEntrega</strong>
                    <a class="mt-3 inline-flex min-h-11 items-center text-xs font-medium text-ui-accent no-underline hover:underline sm:text-sm" href="/inventario?estado=vendida">Ver pendientes</a>
                </article>
                <article class="ui-card col-span-2 min-w-0 p-4 sm:col-span-1 sm:p-5">
                    <span class="mb-4 inline-flex size-10 items-center justify-center rounded-2xl bg-ui-success/10 text-ui-success"><NavIcon Name="bag" /></span>
                    <span class="block text-sm font-medium text-ui-muted">Inventario al costo</span>
                    <strong class="mt-2 block text-[clamp(1.35rem,2.5vw,2rem)] font-semibold leading-tight tracking-tight tabular-nums">@ClientePresentacion.Moneda(Dashboard.ValorInventarioDisponible)</strong>
                    <a class="mt-3 inline-flex min-h-11 items-center text-xs font-medium text-ui-accent no-underline hover:underline sm:text-sm" href="/inventario?estado=disponible">Unidades disponibles</a>
                </article>
            </div>
        </section>
    }

    <section aria-labelledby="titulo-acciones-rapidas">
        <h2 class="mt-0 mb-4 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-acciones-rapidas">Acciones rápidas</h2>
        <div class="grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-4">
            <a class="ui-button min-h-24 flex-col border-ui-border bg-white text-ui-ink shadow-ui-card hover:bg-ui-accent/5 sm:flex-row sm:justify-start" href="/pagos">Registrar abono
                <span class="order-first inline-flex size-10 shrink-0 items-center justify-center rounded-2xl bg-ui-accent/10 text-ui-accent"><NavIcon Name="wallet" /></span>
            </a>
            <a class="ui-button min-h-24 flex-col bg-ui-accent text-white shadow-ui-card hover:bg-ui-accent-hover sm:flex-row sm:justify-start" href="/ventas/nueva?modo=directa">Venta directa
                <span class="order-first inline-flex size-10 shrink-0 items-center justify-center rounded-2xl bg-white/15"><NavIcon Name="cart" /></span>
            </a>
            <a class="ui-button min-h-24 flex-col border-ui-border bg-white text-ui-ink shadow-ui-card hover:bg-ui-accent/5 sm:flex-row sm:justify-start" href="/pedidos/nuevo">Registrar pedido
                <span class="order-first inline-flex size-10 shrink-0 items-center justify-center rounded-2xl bg-ui-warning/10 text-ui-warning"><NavIcon Name="clipboard" /></span>
            </a>
            <a class="ui-button min-h-24 flex-col border-ui-border bg-white text-ui-ink shadow-ui-card hover:bg-ui-accent/5 sm:flex-row sm:justify-start" href="/clientes">Buscar cliente
                <span class="order-first inline-flex size-10 shrink-0 items-center justify-center rounded-2xl bg-ui-success/10 text-ui-success"><NavIcon Name="users" /></span>
            </a>
        </div>
    </section>

    <section class="ui-card min-w-0 p-5 sm:p-6" aria-labelledby="titulo-utilidad">
        <h2 class="mt-0 mb-5 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-utilidad">Ganancia total</h2>
        <form class="grid min-w-0 gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] md:items-end" @onsubmit="ConsultarUtilidadAsync" @onsubmit:preventDefault>
            <div class="grid min-w-0 gap-2">
                <label class="text-sm font-medium" for="dashboard-desde">Desde</label>
                <input class="ui-input" id="dashboard-desde" type="date" @bind="Desde" disabled="@ConsultandoUtilidad" />
            </div>
            <div class="grid min-w-0 gap-2">
                <label class="text-sm font-medium" for="dashboard-hasta">Hasta</label>
                <input class="ui-input" id="dashboard-hasta" type="date" @bind="Hasta" disabled="@ConsultandoUtilidad" />
            </div>
            <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="submit" disabled="@ConsultandoUtilidad">
                @(ConsultandoUtilidad ? "Consultando..." : "Consultar")
            </button>
        </form>
        @if (!string.IsNullOrWhiteSpace(ErrorUtilidad))
        {
            <div class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger mt-5 mb-0" role="alert">@ErrorUtilidad</div>
        }
        else if (ConsultandoUtilidad)
        {
            <p class="mt-5 mb-0 text-sm text-ui-muted" role="status">Calculando ganancia...</p>
        }
        else if (Utilidad.HasValue)
        {
            <div class="mt-5 flex min-w-0 flex-col gap-3 rounded-2xl bg-ui-canvas p-4 sm:flex-row sm:items-center sm:justify-between" aria-live="polite">
                <span class="text-sm text-ui-muted">Ganancia del @DesdeConsultado.ToString("dd/MM/yyyy") al @HastaConsultado.ToString("dd/MM/yyyy")</span>
                <strong class="text-2xl font-semibold tracking-tight tabular-nums">@ClientePresentacion.Moneda(Utilidad.Value)</strong>
            </div>
        }
    </section>

    @if (Dashboard is not null)
    {
        <section class="ui-card min-w-0 overflow-hidden" aria-labelledby="titulo-canales">
            <div class="p-5 sm:p-6">
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-canales">Ventas por canal</h2>
                <p class="mt-2 mb-0 text-sm text-ui-muted">Pedidos no cancelados y ventas registradas.</p>
            </div>
            <div class="rm-desktop-list hidden overflow-x-visible md:block">
                <table class="w-full border-collapse text-sm [&_td]:border-0 [&_td]:border-t [&_td]:border-solid [&_td]:border-ui-border [&_td]:px-6 [&_td]:py-4">
                    <thead class="bg-ui-canvas/70">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-ui-muted">Canal</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-ui-muted">Pedidos</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-ui-muted">Ventas</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-ui-muted">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var canal in Dashboard.Canales)
                        {
                            <tr>
                                <td>@PedidoPresentacion.Canal(canal.Canal)</td>
                                <td class="text-right tabular-nums">@canal.CantidadPedidos</td>
                                <td class="text-right tabular-nums">@canal.CantidadVentas</td>
                                <td class="text-right font-semibold tabular-nums">@ClientePresentacion.Moneda(canal.MontoVentas)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rm-mobile-list grid gap-3 px-4 pb-4 md:hidden">
                @foreach (var canal in Dashboard.Canales)
                {
                    <article class="min-w-0 rounded-2xl bg-ui-canvas/70 p-4">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                            <h3 class="m-0 text-sm font-semibold">@PedidoPresentacion.Canal(canal.Canal)</h3>
                            <strong class="text-base font-semibold tabular-nums">@ClientePresentacion.Moneda(canal.MontoVentas)</strong>
                        </div>
                        <dl class="m-0 mt-4 grid grid-cols-2 gap-3 text-sm">
                            <div><dt class="text-ui-muted">Pedidos</dt><dd class="m-0 mt-1 font-medium tabular-nums">@canal.CantidadPedidos</dd></div>
                            <div><dt class="text-ui-muted">Ventas</dt><dd class="m-0 mt-1 font-medium tabular-nums">@canal.CantidadVentas</dd></div>
                        </dl>
                    </article>
                }
            </div>
        </section>

        <div class="grid min-w-0 gap-5 xl:grid-cols-2">
            <section class="ui-card min-w-0 p-5 sm:p-6" aria-labelledby="titulo-pagos-recientes">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-pagos-recientes">Últimos pagos</h2>
                    <a class="inline-flex min-h-11 items-center text-sm font-medium text-ui-accent no-underline hover:underline" href="/pagos">Ver pagos</a>
                </div>
                @if (Dashboard.UltimosPagos.Count == 0)
                {
                    <div class="mt-4 rounded-2xl bg-ui-canvas/70 px-4 py-8 text-center text-sm text-ui-muted">
                        <span class="mx-auto mb-3 flex size-12 items-center justify-center rounded-2xl bg-white"><NavIcon Name="wallet" /></span>
                        <p class="m-0">Sin pagos recientes</p>
                    </div>
                }
                else
                {
                    <div class="mt-4 space-y-3">
                        @foreach (var pago in Dashboard.UltimosPagos)
                        {
                            <article class="min-w-0 rounded-2xl bg-ui-canvas/70 p-4">
                                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                                    <h3 class="m-0 min-w-0 text-sm font-semibold"><a class="inline-flex min-h-11 items-center text-ui-accent no-underline hover:underline" href="/clientes/@pago.ClienteId">@pago.Cliente</a></h3>
                                    <strong class="text-lg font-semibold tabular-nums">@ClientePresentacion.Moneda(pago.Monto)</strong>
                                </div>
                                <p class="mt-1 mb-0 text-sm text-ui-muted">@pago.Fecha.ToString("dd/MM/yyyy") · @PagoPresentacion.Metodo(pago.MetodoPago)</p>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="ui-card min-w-0 p-5 sm:p-6" aria-labelledby="titulo-ventas-recientes">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-ventas-recientes">Últimas ventas</h2>
                    <a class="inline-flex min-h-11 items-center text-sm font-medium text-ui-accent no-underline hover:underline" href="/ventas">Ver historial</a>
                </div>
                @if (Dashboard.UltimasVentas.Count == 0)
                {
                    <div class="mt-4 rounded-2xl bg-ui-canvas/70 px-4 py-8 text-center text-sm text-ui-muted">
                        <span class="mx-auto mb-3 flex size-12 items-center justify-center rounded-2xl bg-white"><NavIcon Name="cart" /></span>
                        <p class="m-0">Sin ventas recientes</p>
                    </div>
                }
                else
                {
                    <div class="mt-4 space-y-3">
                        @foreach (var venta in Dashboard.UltimasVentas)
                        {
                            <article class="min-w-0 rounded-2xl bg-ui-canvas/70 p-4">
                                <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                                    <h3 class="m-0 min-w-0 text-sm font-semibold">@venta.CodigoInterno</h3>
                                    <strong class="text-lg font-semibold tabular-nums">@ClientePresentacion.Moneda(venta.Total)</strong>
                                </div>
                                <p class="mt-2 mb-0 text-sm text-ui-muted">@venta.Fecha.ToString("dd/MM/yyyy") · @PedidoPresentacion.Canal(venta.Canal)</p>
                                <a class="inline-flex min-h-11 items-center text-sm font-medium text-ui-accent no-underline hover:underline" href="/clientes/@venta.ClienteId">@venta.Cliente</a>
                                <div class="mt-3 border-0 border-t border-solid border-ui-border pt-3">
                                    <a class="ui-button w-full border-ui-control bg-white text-ui-ink hover:bg-white/60 sm:w-auto" href="/ventas/@venta.Id">Ver detalle</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private const int CantidadRecientes = 5;

    private DashboardDto? Dashboard { get; set; }
    private DateOnly Desde { get; set; }
    private DateOnly Hasta { get; set; }
    private DateOnly DesdeConsultado { get; set; }
    private DateOnly HastaConsultado { get; set; }
    private decimal? Utilidad { get; set; }
    private bool CargandoDashboard { get; set; }
    private bool ConsultandoUtilidad { get; set; }
    private string? ErrorDashboard { get; set; }
    private string? ErrorUtilidad { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var hoy = DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);
        Desde = new DateOnly(hoy.Year, hoy.Month, 1);
        Hasta = hoy;

        await CargarDashboardAsync();
        await ConsultarUtilidadAsync();
    }

    private async Task CargarDashboardAsync()
    {
        if (CargandoDashboard)
            return;

        CargandoDashboard = true;
        ErrorDashboard = null;
        try
        {
            Dashboard = await DashboardService.ObtenerAsync(CantidadRecientes);
        }
        catch (Exception ex)
        {
            Dashboard = null;
            ErrorDashboard = "Ocurrió un error al consultar los indicadores. Intenta nuevamente.";
            Logger.LogError(ex, "No fue posible cargar el Dashboard.");
        }
        finally
        {
            CargandoDashboard = false;
        }
    }

    private async Task ConsultarUtilidadAsync()
    {
        if (ConsultandoUtilidad)
            return;

        ConsultandoUtilidad = true;
        ErrorUtilidad = null;
        Utilidad = null;
        var desdeConsultado = Desde;
        var hastaConsultado = Hasta;
        try
        {
            var resultado = await DashboardService.ObtenerUtilidadAsync(desdeConsultado, hastaConsultado);
            if (!resultado.IsSuccess)
            {
                ErrorUtilidad = resultado.ErrorMessage;
                return;
            }

            Utilidad = resultado.Value;
            DesdeConsultado = desdeConsultado;
            HastaConsultado = hastaConsultado;
        }
        catch (Exception ex)
        {
            ErrorUtilidad = "Ocurrió un error al consultar la ganancia. Intenta nuevamente.";
            Logger.LogError(ex, "No fue posible consultar la utilidad del Dashboard.");
        }
        finally
        {
            ConsultandoUtilidad = false;
        }
    }
}
