@page "/login"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Iniciar sesión | ResellManager</PageTitle>

<section class="ui-card grid w-full min-w-0 max-w-md gap-6 p-5 sm:p-8" aria-labelledby="titulo-login">
    <div class="min-w-0 border-0 border-b border-solid border-ui-border pb-5">
        <img src="branding/resellmanager-logo-dark.png" alt="ResellManager"
             class="block h-14 w-56 max-w-full object-cover" width="1536" height="1024" />
        <p class="m-0 mt-2 text-xs text-ui-muted">Administración familiar</p>
    </div>

    <div class="min-w-0 space-y-2">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Acceso privado</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink" id="titulo-login">Iniciar sesión</h1>
        <p class="m-0 text-sm leading-6 text-ui-muted">Ingresa con la cuenta configurada para continuar.</p>
    </div>

    @if (Error == "credenciales")
    {
        <div class="rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger" role="alert">El correo o la contraseña son incorrectos.</div>
    }
    else if (SesionCerrada)
    {
        <div class="rounded-2xl border border-solid border-ui-success/20 bg-ui-success/5 px-4 py-3 text-sm leading-6 text-ui-success" role="status">La sesión se cerró correctamente.</div>
    }

    <form class="grid min-w-0 gap-4" method="post" action="/account/login" data-enhance="false">
        <AntiforgeryToken />

        <div class="grid min-w-0 gap-2">
            <label class="text-sm font-semibold text-ui-ink" for="correo">Correo electrónico</label>
            <input class="ui-input" id="correo" name="correo" type="email" autocomplete="username"
                   placeholder="nombre@correo.com" required autofocus />
        </div>

        <div class="grid min-w-0 gap-2">
            <label class="text-sm font-semibold text-ui-ink" for="contrasena">Contraseña</label>
            <input class="ui-input" id="contrasena" name="contrasena" type="password" autocomplete="current-password" required />
        </div>

        <label class="flex min-h-12 min-w-0 cursor-pointer items-center gap-3 rounded-2xl py-2 text-sm leading-6 text-ui-ink touch-manipulation">
            <input class="m-0 size-5 shrink-0 accent-ui-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" name="recordar" type="checkbox" value="true" />
            <span class="min-w-0">Mantener la sesión iniciada</span>
        </label>

        <button class="ui-button w-full bg-ui-accent text-white hover:bg-ui-accent-hover" type="submit">Entrar</button>
    </form>

    <p class="m-0 text-xs leading-5 text-ui-muted">Esta aplicación es de uso privado. Si necesitas acceso, consulta al administrador.</p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "sesionCerrada")]
    public bool SesionCerrada { get; set; }
}
