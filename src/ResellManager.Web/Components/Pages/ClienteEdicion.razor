@page "/clientes/nuevo"
@page "/clientes/{Id:int}/editar"
@rendermode InteractiveServer
@inject IClienteService ClienteService
@inject NavigationManager Navigation
@inject ILogger<ClienteEdicion> Logger

<PageTitle>@(EsEdicion ? "Editar cliente" : "Nuevo cliente") | ResellManager</PageTitle>

<div class="mx-auto min-w-0 max-w-5xl space-y-6 pb-[env(safe-area-inset-bottom)]">
    <section class="space-y-2" aria-labelledby="titulo-formulario-cliente">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Clientes</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-formulario-cliente">@(EsEdicion ? "Editar cliente" : "Nuevo cliente")</h1>
        <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">@(EsEdicion ? "Actualiza la información de contacto del cliente." : "Registra la información básica del cliente.")</p>
    </section>

    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando cliente...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorCarga))
    {
        <section class="ui-card grid gap-4 border-ui-danger/20 p-5 sm:p-6" role="alert">
            <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink">No fue posible abrir el cliente</h2>
            <p class="m-0 text-sm leading-6 text-ui-muted">@ErrorCarga</p>
            <div class="grid gap-3 sm:flex sm:flex-wrap">
                <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="button" @onclick="CargarClienteAsync">Reintentar</button>
                <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/clientes">Volver a clientes</a>
            </div>
        </section>
    }
    else
    {
        <section class="rm-client-form min-w-0" aria-label="Formulario de cliente">
            <ClienteForm Modelo="Modelo"
                         Guardando="Guardando"
                         ErrorMessage="@ErrorGuardado"
                         OnGuardar="GuardarAsync"
                         CancelarHref="@CancelarHref" />
        </section>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ClienteFormModel Modelo { get; set; } = new();
    private bool Guardando { get; set; }
    private bool Cargando { get; set; }
    private string? ErrorCarga { get; set; }
    private string? ErrorGuardado { get; set; }
    private int? IdCargado { get; set; }

    private bool EsEdicion => Id.HasValue;
    private string CancelarHref => Id > 0 ? $"/clientes/{Id}" : "/clientes";

    protected override async Task OnParametersSetAsync()
    {
        if (!EsEdicion)
        {
            ErrorCarga = null;
            ErrorGuardado = null;
            Cargando = false;
            Modelo = new ClienteFormModel();
            IdCargado = null;

            return;
        }

        if (IdCargado != Id)
        {
            await CargarClienteAsync();
        }
    }

    private async Task CargarClienteAsync()
    {
        Cargando = true;
        ErrorCarga = null;

        try
        {
            var resultado = await ClienteService.ObtenerPorIdAsync(Id.GetValueOrDefault());
            if (!resultado.IsSuccess || resultado.Value is null)
            {
                ErrorCarga = resultado.ErrorMessage ?? "Cliente no encontrado.";
                return;
            }

            Modelo = ClienteFormModel.FromDto(resultado.Value);
            IdCargado = Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar el cliente {ClienteId} para edición.", Id);
            ErrorCarga = "Ocurrió un problema inesperado al cargar el cliente. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task GuardarAsync(ClienteFormModel modelo)
    {
        if (Guardando || Id is <= 0 || ErrorCarga is not null)
        {
            return;
        }

        Guardando = true;
        ErrorGuardado = null;

        try
        {
            var resultado = EsEdicion
                ? await ClienteService.EditarAsync(Id!.Value, modelo.ToInput())
                : await ClienteService.CrearAsync(modelo.ToInput());

            if (!resultado.IsSuccess)
            {
                ErrorGuardado = resultado.ErrorMessage ?? "No fue posible guardar el cliente.";
                return;
            }

            Navigation.NavigateTo(
                EsEdicion
                    ? "/clientes?mensaje=cliente-editado"
                    : "/clientes?mensaje=cliente-creado");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No fue posible {Operacion} el cliente {ClienteId}.",
                EsEdicion ? "editar" : "crear",
                EsEdicion ? Id : null);
            ErrorGuardado = "Ocurrió un problema inesperado al guardar. Intenta nuevamente.";
        }
        finally
        {
            Guardando = false;
        }
    }
}
