@page "/proveedores/nuevo"
@rendermode InteractiveServer
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation
@inject ILogger<ProveedorNuevo> Logger

<PageTitle>Nuevo proveedor | ResellManager</PageTitle>

<div class="rm-providers min-w-0 space-y-6 pb-[env(safe-area-inset-bottom)]">
    <section class="grid min-w-0 gap-2" aria-labelledby="titulo-nuevo-proveedor">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Proveedores</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-nuevo-proveedor">Nuevo proveedor</h1>
        <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">Registra los datos básicos para seleccionarlo en futuras compras.</p>
    </section>

    <section class="ui-card min-w-0 max-w-3xl p-5 sm:p-6" aria-label="Formulario de proveedor">
        <ProveedorForm Modelo="Modelo" Guardando="Guardando" ErrorGuardado="@ErrorGuardado" OnGuardar="GuardarAsync" />
    </section>
</div>

@code {
    private ProveedorFormModel Modelo { get; } = new();
    private bool Guardando { get; set; }
    private string? ErrorGuardado { get; set; }

    private async Task GuardarAsync()
    {
        if (Guardando)
            return;

        Guardando = true;
        ErrorGuardado = null;
        try
        {
            var resultado = await ProveedorService.CrearAsync(Modelo.ToInput());
            if (!resultado.IsSuccess)
            {
                ErrorGuardado = resultado.ErrorMessage ?? "No fue posible guardar el proveedor.";
                return;
            }

            Navigation.NavigateTo("/proveedores?mensaje=proveedor-creado");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible registrar el proveedor.");
            ErrorGuardado = "Ocurrió un problema inesperado al guardar. Intenta nuevamente.";
        }
        finally
        {
            Guardando = false;
        }
    }
}
