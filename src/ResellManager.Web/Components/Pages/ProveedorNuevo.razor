@page "/proveedores/nuevo"
@rendermode InteractiveServer
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation
@inject ILogger<ProveedorNuevo> Logger

<PageTitle>Nuevo proveedor | ResellManager</PageTitle>

<section class="page-heading" aria-labelledby="titulo-nuevo-proveedor">
    <div>
        <p class="eyebrow">Proveedores</p>
        <h1 id="titulo-nuevo-proveedor">Nuevo proveedor</h1>
        <p class="page-lead">Registra los datos básicos para seleccionarlo en futuras compras.</p>
    </div>
</section>

<section class="form-panel" aria-label="Formulario de proveedor">
    <EditForm Model="Modelo" OnValidSubmit="GuardarAsync" class="entity-form">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrWhiteSpace(ErrorGuardado))
        {
            <div class="mensaje-error" role="alert">@ErrorGuardado</div>
        }

        <ValidationSummary class="validation-summary" role="alert" />

        <div class="form-grid">
            <div class="form-field">
                <label for="proveedor-nombre">Nombre <span aria-hidden="true">*</span></label>
                <InputText disabled="@Guardando" id="proveedor-nombre" aria-describedby="proveedor-nombre-validacion" @bind-Value="Modelo.Nombre" autocomplete="organization" />
                <div id="proveedor-nombre-validacion"><ValidationMessage For="() => Modelo.Nombre" /></div>
            </div>

            <div class="form-field">
                <label for="proveedor-pais">Código de país</label>
                <InputText disabled="@Guardando" id="proveedor-pais" aria-describedby="proveedor-pais-validacion" @bind-Value="Modelo.CodigoPais" maxlength="10" autocomplete="country" />
                <div id="proveedor-pais-validacion"><ValidationMessage For="() => Modelo.CodigoPais" /></div>
            </div>

            <div class="form-field">
                <label for="proveedor-telefono">Teléfono</label>
                <InputText disabled="@Guardando" id="proveedor-telefono" aria-describedby="proveedor-telefono-validacion" @bind-Value="Modelo.Telefono" inputmode="tel" autocomplete="tel" />
                <div id="proveedor-telefono-validacion"><ValidationMessage For="() => Modelo.Telefono" /></div>
            </div>

            <div class="form-field form-field-wide">
                <label for="proveedor-descripcion">Descripción</label>
                <InputTextArea disabled="@Guardando" id="proveedor-descripcion" aria-describedby="proveedor-descripcion-validacion" @bind-Value="Modelo.Descripcion" rows="4" />
                <div id="proveedor-descripcion-validacion"><ValidationMessage For="() => Modelo.Descripcion" /></div>
            </div>
        </div>

        <p class="required-note"><span aria-hidden="true">*</span> Campos obligatorios</p>

        <div class="form-actions">
            <button class="primary-button" type="submit" disabled="@Guardando">
                @(Guardando ? "Guardando..." : "Guardar proveedor")
            </button>
            <a class="secondary-button" href="/proveedores">Cancelar</a>
        </div>
    </EditForm>
</section>

@code {
    private ProveedorFormModel Modelo { get; } = new();
    private bool Guardando { get; set; }
    private string? ErrorGuardado { get; set; }

    private async Task GuardarAsync()
    {
        if (Guardando)
            return;

        Guardando = true;
        ErrorGuardado = null;
        try
        {
            var resultado = await ProveedorService.CrearAsync(Modelo.ToInput());
            if (!resultado.IsSuccess)
            {
                ErrorGuardado = resultado.ErrorMessage ?? "No fue posible guardar el proveedor.";
                return;
            }

            Navigation.NavigateTo("/proveedores?mensaje=proveedor-creado");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible registrar el proveedor.");
            ErrorGuardado = "Ocurrió un problema inesperado al guardar. Intenta nuevamente.";
        }
        finally
        {
            Guardando = false;
        }
    }
}
