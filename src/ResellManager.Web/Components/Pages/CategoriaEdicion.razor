@page "/categorias/nueva"
@page "/categorias/{Id:int}/editar"
@rendermode InteractiveServer
@inject ICategoriaService CategoriaService
@inject NavigationManager Navigation
@inject ILogger<CategoriaEdicion> Logger

<PageTitle>@(EsEdicion ? "Editar categoría" : "Nueva categoría") | ResellManager</PageTitle>

<div class="rm-categories min-w-0 max-w-3xl space-y-6 pb-4">
    <section class="space-y-2" aria-labelledby="titulo-formulario-categoria">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Categorías</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-formulario-categoria">@(EsEdicion ? "Editar categoría" : "Nueva categoría")</h1>
        <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">@(EsEdicion ? "Actualiza la definición de la categoría." : "Crea una categoría para organizar las definiciones de productos.")</p>
    </section>

    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando categoría...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorCarga))
    {
        <section class="ui-card min-w-0 p-6 text-center text-ui-muted sm:p-8" role="alert">
            <div class="grid min-w-0 gap-4">
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink">No fue posible abrir la categoría</h2>
                <p class="m-0 text-sm leading-6 text-ui-muted [overflow-wrap:anywhere]">@ErrorCarga</p>
                <div class="grid min-w-0 gap-2 sm:flex sm:justify-center">
                    <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="button" @onclick="CargarCategoriaAsync">Reintentar</button>
                    <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/categorias">Volver a categorías</a>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="ui-card min-w-0 p-5 sm:p-6" aria-label="Formulario de categoría">
            <CategoriaForm Modelo="Modelo"
                           PadresDisponibles="PadresDisponibles"
                           TieneSubcategorias="TieneSubcategorias"
                           Guardando="Guardando"
                           ErrorMessage="@ErrorGuardado"
                           OnGuardar="GuardarAsync" />
        </section>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private CategoriaFormModel Modelo { get; set; } = new();
    private IReadOnlyList<CategoriaDto> PadresDisponibles { get; set; } = [];
    private bool TieneSubcategorias;
    private bool Guardando { get; set; }
    private bool Cargando { get; set; }
    private string? ErrorCarga { get; set; }
    private string? ErrorGuardado { get; set; }
    private int? IdCargado { get; set; }

    private bool EsEdicion => Id.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        if (!EsEdicion || IdCargado != Id)
        {
            await CargarCategoriaAsync();
        }
    }

    private async Task CargarCategoriaAsync()
    {
        Cargando = true;
        ErrorCarga = null;

        try
        {
            var categorias = await CategoriaService.ListarAsync();
            PadresDisponibles = categorias.Where(x => x.CategoriaPadreId is null && x.Id != Id).ToArray();
            TieneSubcategorias = false;
            if (!EsEdicion)
            {
                Modelo = new CategoriaFormModel();
                IdCargado = null;
                return;
            }
            var resultado = await CategoriaService.ObtenerPorIdAsync(Id.GetValueOrDefault());
            if (!resultado.IsSuccess || resultado.Value is null)
            {
                ErrorCarga = resultado.ErrorMessage ?? "Categoría no encontrada.";
                return;
            }

            Modelo = CategoriaFormModel.FromDto(resultado.Value);
            TieneSubcategorias = resultado.Value.TieneSubcategorias;
            IdCargado = Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar la categoría {CategoriaId} para edición.", Id);
            ErrorCarga = "Ocurrió un problema inesperado al cargar la categoría. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task GuardarAsync(CategoriaFormModel modelo)
    {
        if (Guardando || Id is <= 0 || ErrorCarga is not null)
        {
            return;
        }

        Guardando = true;
        ErrorGuardado = null;

        try
        {
            var resultado = EsEdicion
                ? await CategoriaService.EditarAsync(Id!.Value, modelo.ToInput())
                : await CategoriaService.CrearAsync(modelo.ToInput());

            if (!resultado.IsSuccess)
            {
                ErrorGuardado = resultado.ErrorMessage ?? "No fue posible guardar la categoría.";
                return;
            }

            Navigation.NavigateTo(
                EsEdicion
                    ? "/categorias?mensaje=categoria-editada"
                    : "/categorias?mensaje=categoria-creada");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No fue posible {Operacion} la categoría {CategoriaId}.",
                EsEdicion ? "editar" : "crear",
                EsEdicion ? Id : null);
            ErrorGuardado = "Ocurrió un problema inesperado al guardar. Intenta nuevamente.";
        }
        finally
        {
            Guardando = false;
        }
    }
}
