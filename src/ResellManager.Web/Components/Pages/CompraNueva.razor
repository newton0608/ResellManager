@page "/compras/nueva"
@rendermode InteractiveServer
@using ResellManager.Domain.Enums
@inject IRegistroCompraConComprobanteService RegistroCompraService
@inject NavigationManager Navigation
@inject ILogger<CompraNueva> Logger

<PageTitle>Nueva compra | ResellManager</PageTitle>

<section class="page-heading" aria-labelledby="titulo-nueva-compra">
    <div>
        <p class="eyebrow">Compras</p>
        <h1 id="titulo-nueva-compra">Nueva compra</h1>
        <p class="page-lead">Registra productos, costos y un comprobante opcional. El código interno se genera automáticamente.</p>
    </div>
</section>

    @if (AltaProveedor)
    {
        <ProveedorAltaPanel OnCreado="ProveedorCreado" OnCancelar="CerrarAltaProveedor" />
    }
    @if (DetalleAlta is not null)
    {
        <ProductoAltaPanel OnCreado="ProductoCreado" OnCancelar="CerrarAlta" />
    }
    @if (ConfirmacionProducto is not null)
    {
        <p class="mensaje-exito" role="status">@ConfirmacionProducto</p>
    }
    <section class="form-panel purchase-form-panel" aria-label="Formulario de compra">
        <EditForm Model="Modelo" OnValidSubmit="RevisarCompra" class="entity-form">
            <DataAnnotationsValidator />
            <fieldset class="purchase-fields" disabled="@(Guardando || AltaAbierta)">

            @if (!string.IsNullOrWhiteSpace(ErrorGuardado))
            {
                <div class="mensaje-error" role="alert">@ErrorGuardado</div>
            }

            <ValidationSummary class="validation-summary" />

            <div class="form-grid">
                <div class="form-field">
                    <label for="compra-fecha">Fecha de compra <span aria-hidden="true">*</span></label>
                    <InputDate id="compra-fecha" @bind-Value="Modelo.FechaCompra" />
                </div>

                <div class="form-field">
                    <label for="compra-origen">Origen <span aria-hidden="true">*</span></label>
                    <select id="compra-origen" value="@Modelo.Origen" @onchange="CambiarOrigen">
                        @foreach (var origen in Enum.GetValues<OrigenCompra>())
                        {
                            <option value="@origen">@CompraPresentacion.Origen(origen)</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <ProveedorBuscador Seleccionado="ProveedorSeleccionado" Deshabilitado="@(Guardando || AltaAbierta)"
                                       OnSeleccionado="SeleccionarProveedor" OnAgregar="AbrirAltaProveedor" />
                    <ValidationMessage For="() => Modelo.ProveedorId" />
                </div>

                @if (RequiereFechaIngreso)
                {
                    <div class="form-field">
                        <label for="compra-ingreso">Fecha de ingreso <span aria-hidden="true">*</span></label>
                        <InputDate id="compra-ingreso" @bind-Value="Modelo.FechaIngreso" />
                        <p class="field-help">La mercancía ya está recibida y quedará disponible.</p>
                    </div>
                }

                <div class="form-field form-field-wide">
                    <label for="compra-observaciones">Observaciones</label>
                    <InputTextArea id="compra-observaciones" @bind-Value="Modelo.Observaciones" rows="3" />
                    <ValidationMessage For="() => Modelo.Observaciones" />
                </div>
            </div>

            @if (Modelo.Origen == OrigenCompra.Importacion)
            {
                <div class="origin-guidance">
                    <strong>Importación</strong>
                    <span>Las unidades se crean como Compradas, sin fecha de ingreso. La recepción se registra después en Inventario.</span>
                </div>
            }
            else if (Modelo.Origen == OrigenCompra.Catalogo)
            {
                <div class="origin-guidance catalog-origin-guidance">
                    <strong>Catálogo</strong>
                    <span>Se registran los detalles y costos, sin crear unidades de inventario.</span>
                </div>
            }

            <section class="order-lines-editor purchase-lines-editor" aria-labelledby="titulo-detalles-compra">
                <div class="data-panel-heading">
                    <div>
                        <h2 id="titulo-detalles-compra">Productos de la compra</h2>
                        <p>Revisa cantidades y costos; el total se confirma al registrar la compra.</p>
                    </div>
                    <button class="secondary-button" type="button" disabled="@Guardando" @onclick="AgregarFila">Agregar producto</button>
                </div>

                <div class="order-lines-list">
                    @for (var index = 0; index < Modelo.Detalles.Count; index++)
                    {
                        var detalle = Modelo.Detalles[index];
                        var numero = index + 1;
                        <article class="order-line-editor" @key="detalle">
                            <div class="order-line-heading">
                                <h3>Detalle @numero</h3>
                                <button class="table-action button-link" type="button"
                                        disabled="@(Guardando || Modelo.Detalles.Count == 1)"
                                        aria-label="Quitar detalle @numero"
                                        @onclick="() => QuitarFila(detalle)">Quitar</button>
                            </div>
                            <div class="purchase-line-grid">
                                <ProductoBuscador Id="@($"producto-compra-{numero}")"
                                                  Seleccionado="detalle.ProductoSeleccionado"
                                                  Deshabilitado="@(Guardando || AltaAbierta)"
                                                  OnSeleccionado="producto => SeleccionarProducto(detalle, producto)"
                                                  OnRegistrar="() => AbrirAlta(detalle)" />
                                <div class="form-field">
                                    <label for="cantidad-compra-@numero">Cantidad <span aria-hidden="true">*</span></label>
                                    <input inputmode="numeric" data-select-once="true" id="cantidad-compra-@numero" type="number" min="1" step="1" @bind="detalle.Cantidad" />
                                </div>
                                <div class="form-field">
                                    <label for="costo-compra-@numero">Costo unitario <span aria-hidden="true">*</span></label>
                                    <input inputmode="decimal" data-select-once="true" id="costo-compra-@numero" type="number" min="0" step="0.01" @bind="detalle.CostoUnitario" />
                                </div>
                                <div class="purchase-line-subtotal">
                                    <span>Subtotal</span>
                                    <strong>@CompraPresentacion.Moneda(detalle.Subtotal)</strong>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <div class="purchase-total-preview">
                    <span>Total visual</span>
                    <strong>@CompraPresentacion.Moneda(Modelo.TotalVisual)</strong>
                </div>
            </section>

            <section class="receipt-upload-panel" aria-labelledby="titulo-adjuntar-comprobante">
                <div class="receipt-upload-heading">
                    <div>
                        <h2 id="titulo-adjuntar-comprobante">Comprobante opcional</h2>
                        <p>Adjunta una imagen JPG, JPEG, PNG, WebP o un PDF de hasta 10 MB.</p>
                    </div>
                    <label class="receipt-toggle">
                        <InputCheckbox @bind-Value="Modelo.AdjuntarComprobante" disabled="@Guardando" />
                        Adjuntar comprobante
                    </label>
                </div>

                @if (Modelo.AdjuntarComprobante)
                {
                    <div class="receipt-upload-body">
                        @if (!string.IsNullOrWhiteSpace(ErrorArchivo))
                        {
                            <div class="mensaje-error" role="alert">@ErrorArchivo</div>
                        }

                        <div class="form-grid">
                            <div class="form-field">
                                <label for="comprobante-numero">Número de documento</label>
                                <InputText id="comprobante-numero" @bind-Value="Modelo.NumeroDocumento" autocomplete="off" />
                                <p class="field-help">Factura, recibo u otra referencia externa. Es opcional.</p>
                                <ValidationMessage For="() => Modelo.NumeroDocumento" />
                            </div>

                            <div class="form-field">
                                <label for="comprobante-fecha">Fecha del comprobante <span aria-hidden="true">*</span></label>
                                <InputDate id="comprobante-fecha" @bind-Value="Modelo.FechaComprobante" />
                            </div>

                            <div class="form-field form-field-wide">
                                <label for="comprobante-archivo">Archivo <span aria-hidden="true">*</span></label>
                                <InputFile id="comprobante-archivo"
                                           OnChange="SeleccionarArchivo"
                                           accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf"
                                           disabled="@Guardando" />
                                @if (ArchivoSeleccionado is not null)
                                {
                                    <p class="selected-file" role="status">
                                        <strong>@ArchivoSeleccionado.Name</strong>
                                        <span>@FormatoTamano(ArchivoSeleccionado.Size)</span>
                                    </p>
                                }
                            </div>

                            <div class="form-field form-field-wide">
                                <label for="comprobante-observaciones">Observaciones del comprobante</label>
                                <InputTextArea id="comprobante-observaciones" @bind-Value="Modelo.ObservacionesComprobante" rows="3" />
                                <ValidationMessage For="() => Modelo.ObservacionesComprobante" />
                            </div>
                        </div>
                    </div>
                }
            </section>

            <p class="required-note"><span aria-hidden="true">*</span> Campos obligatorios</p>

            <div class="form-actions purchase-submit-actions">
                <button class="primary-button" type="submit"
                        disabled="@(Guardando || AltaAbierta)">
                    @(Guardando ? "Registrando y procesando..." : "Revisar compra")
                </button>
                <a class="secondary-button" href="/compras">Cancelar</a>
            </div>
            </fieldset>
        </EditForm>
    </section>

@if (RevisandoCompra)
{
    <ConfirmacionOperacion Titulo="Revisar compra" TextoConfirmar="Confirmar compra" Ocupado="Guardando"
                           Error="@ErrorGuardado" OnEditar="EditarCompra" OnConfirmar="ConfirmarCompraAsync">
        <dl>
            <dt>Proveedor</dt><dd>@ProveedorSeleccionado?.Nombre</dd>
            <dt>Origen</dt><dd>@CompraPresentacion.Origen(Modelo.Origen)</dd>
            <dt>Fecha de compra</dt><dd>@Modelo.FechaCompra.ToString("dd/MM/yyyy")</dd>
            <dt>Fecha de ingreso</dt><dd>@(Modelo.FechaIngreso?.ToString("dd/MM/yyyy") ?? "Pendiente / no aplica")</dd>
        </dl>
        <ul>
            @foreach (var detalle in Modelo.Detalles)
            {
                <li><strong>@detalle.ProductoSeleccionado?.Nombre</strong>: @detalle.Cantidad × @CompraPresentacion.Moneda(detalle.CostoUnitario) = @CompraPresentacion.Moneda(detalle.Subtotal)</li>
            }
        </ul>
        <p><strong>Total: @CompraPresentacion.Moneda(Modelo.TotalVisual)</strong></p>
        <p>Comprobante: @(Modelo.AdjuntarComprobante ? ArchivoSeleccionado?.Name : "Sin archivo adjunto")</p>
        <p>La compra y sus unidades se registrarán únicamente al confirmar.</p>
    </ConfirmacionOperacion>
}

@code {
    private readonly string CodigoInterno = CodigosInternos.CrearCodigoCompra();
    private CompraFormModel Modelo { get; } = new();
    private ProveedorDto? ProveedorSeleccionado { get; set; }
    private bool AltaProveedor { get; set; }
    private bool AltaAbierta => AltaProveedor || DetalleAlta is not null;
    private bool RevisandoCompra { get; set; }
    private DetalleCompraFormModel? DetalleAlta { get; set; }
    private string? ConfirmacionProducto { get; set; }
    private IBrowserFile? ArchivoSeleccionado { get; set; }
    private bool Guardando { get; set; }
    private string? ErrorGuardado { get; set; }
    private string? ErrorArchivo { get; set; }

    private bool RequiereFechaIngreso =>
        Modelo.Origen is OrigenCompra.CompraLocal or OrigenCompra.EnvioHermano;

    private void SeleccionarProveedor(ProveedorDto? proveedor)
    {
        if (Guardando) return;
        ProveedorSeleccionado = proveedor;
        Modelo.ProveedorId = proveedor?.Id ?? 0;
    }

    private void AbrirAltaProveedor()
    {
        if (Guardando || AltaAbierta) return;
        ConfirmacionProducto = null;
        AltaProveedor = true;
    }

    private void CerrarAltaProveedor() => AltaProveedor = false;

    private void ProveedorCreado(ProveedorDto proveedor)
    {
        SeleccionarProveedor(proveedor);
        ConfirmacionProducto = $"Proveedor {proveedor.Nombre} registrado y seleccionado.";
        CerrarAltaProveedor();
    }

    private void RevisarCompra()
    {
        if (Guardando || AltaAbierta) return;
        ErrorGuardado = ValidacionFormulario.PrimerError(Modelo) ?? ValidarFormulario();
        RevisandoCompra = ErrorGuardado is null;
    }

    private void EditarCompra() { if (!Guardando) RevisandoCompra = false; }
    private Task ConfirmarCompraAsync() => RevisandoCompra && !Guardando ? GuardarAsync() : Task.CompletedTask;

    private void CambiarOrigen(ChangeEventArgs evento)
    {
        if (Guardando || !Enum.TryParse<OrigenCompra>(evento.Value?.ToString(), out var origen))
            return;

        Modelo.Origen = origen;
        Modelo.FechaIngreso =
            origen is OrigenCompra.CompraLocal or OrigenCompra.EnvioHermano
                ? Modelo.FechaIngreso ?? DateOnly.FromDateTime(DateTime.Today)
                : null;
    }

    private void AgregarFila()
    {
        if (!Guardando)
            Modelo.Detalles.Add(new DetalleCompraFormModel());
    }

    private void SeleccionarProducto(DetalleCompraFormModel detalle, ProductoDto? producto)
    {
        if (Guardando || !Modelo.Detalles.Contains(detalle)) return;
        detalle.ProductoSeleccionado = producto;
        detalle.ProductoId = producto?.Id ?? 0;
    }

    private void AbrirAlta(DetalleCompraFormModel detalle)
    {
        if (Guardando || AltaAbierta || !Modelo.Detalles.Contains(detalle)) return;
        ConfirmacionProducto = null;
        DetalleAlta = detalle;
    }

    private void CerrarAlta() => DetalleAlta = null;

    private void ProductoCreado(ProductoDto producto)
    {
        if (DetalleAlta is null) return;
        SeleccionarProducto(DetalleAlta, producto);
        ConfirmacionProducto = $"Producto {producto.Nombre} registrado y seleccionado. Continúa con cantidad y costo unitario.";
        CerrarAlta();
    }

    private void QuitarFila(DetalleCompraFormModel detalle)
    {
        if (!Guardando && Modelo.Detalles.Count > 1)
            Modelo.Detalles.Remove(detalle);
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs evento)
    {
        if (Guardando)
            return;

        ErrorArchivo = null;
        ArchivoSeleccionado = evento.File;
        if (ArchivoSeleccionado.Size > ReglasComprobanteCompra.TamanoMaximoBytes)
        {
            ErrorArchivo = "El comprobante supera el límite máximo de 10 MB.";
            ArchivoSeleccionado = null;
        }
    }

    private async Task GuardarAsync()
    {
        if (Guardando || AltaAbierta)
            return;

        ErrorGuardado = ValidarFormulario();
        if (ErrorGuardado is not null)
            return;

        Guardando = true;
        Stream? stream = null;
        try
        {
            ArchivoComprobanteInput? archivo = null;
            if (Modelo.AdjuntarComprobante && ArchivoSeleccionado is not null)
            {
                try
                {
                    stream = ArchivoSeleccionado.OpenReadStream(
                        ReglasComprobanteCompra.TamanoMaximoBytes
                    );
                }
                catch (IOException)
                {
                    ErrorGuardado = "El comprobante supera el límite máximo de 10 MB.";
                    return;
                }

                archivo = new ArchivoComprobanteInput(
                    stream,
                    ArchivoSeleccionado.Name,
                    ArchivoSeleccionado.ContentType
                );
            }

            var resultado = await RegistroCompraService.RegistrarAsync(
                Modelo.ToInput(CodigoInterno),
                Modelo.ToDatosComprobante(),
                archivo
            );
            if (!resultado.IsSuccess || resultado.Value is null)
            {
                ErrorGuardado = resultado.ErrorMessage ?? "No fue posible registrar la compra.";
                return;
            }

            RevisandoCompra = false;
            Navigation.NavigateTo($"/compras/{resultado.Value.Id}?mensaje=compra-creada");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible registrar la compra {CodigoCompra}.", CodigoInterno);
            ErrorGuardado = "Ocurrió un problema inesperado al registrar. Intenta nuevamente.";
        }
        finally
        {
            if (stream is not null)
                await stream.DisposeAsync();
            Guardando = false;
        }
    }

    private string? ValidarFormulario()
    {
        if (ProveedorSeleccionado is null || ProveedorSeleccionado.Id != Modelo.ProveedorId)
            return "Selecciona un proveedor válido.";
        if (Modelo.Detalles.Count == 0)
            return "Agrega al menos un detalle a la compra.";
        if (Modelo.Detalles.Any(x => x.ProductoId <= 0))
            return "Selecciona un producto válido en cada detalle.";
        if (Modelo.Detalles.Any(x => x.Cantidad <= 0))
            return "La cantidad de cada detalle debe ser mayor que cero.";
        if (Modelo.Detalles.Any(x => x.CostoUnitario < 0))
            return "El costo unitario no puede ser negativo.";
        if (RequiereFechaIngreso && !Modelo.FechaIngreso.HasValue)
            return "La fecha de ingreso es obligatoria para mercancía recibida.";
        if (Modelo.AdjuntarComprobante && !string.IsNullOrWhiteSpace(ErrorArchivo))
            return ErrorArchivo;
        if (Modelo.AdjuntarComprobante && ArchivoSeleccionado is null)
            return "Selecciona el archivo del comprobante o desactiva la opción de adjuntarlo.";
        return null;
    }

    private static string FormatoTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:F1} MB"
            : $"{Math.Max(1, Math.Ceiling(bytes / 1024d)):F0} KB";
}
