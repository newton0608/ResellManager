@page "/ventas/nueva"
@rendermode InteractiveServer
@using ResellManager.Domain.Enums
@inject IVentaService VentaService
@inject IPedidoService PedidoService
@inject IInventarioService InventarioService
@inject ISeleccionOperativaService SeleccionService
@inject NavigationManager Navigation
@inject ILogger<VentaNueva> Logger

<PageTitle>Nueva venta | ResellManager</PageTitle>

<div class="rm-sales grid min-w-0 gap-6 pb-4">
<section class="flex items-start justify-between gap-4" aria-labelledby="titulo-nueva-venta">
    <div class="grid min-w-0 gap-2">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Ventas</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-nueva-venta">Nueva venta</h1>
        <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">Toda venta conserva un pedido: selecciónalo o genera uno automáticamente para una venta presencial directa.</p>
    </div>
</section>
<section class="ui-card grid min-w-0 gap-4 p-4 sm:p-5 xl:flex xl:items-center xl:justify-between" aria-labelledby="titulo-modo-venta">
    <div>
        <p class="mt-0 mb-2 text-xs font-semibold tracking-wide text-ui-muted uppercase">Modo de registro</p>
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-modo-venta">¿Cómo nace la venta?</h2>
    </div>
    <div class="grid min-w-0 grid-cols-2 gap-3" role="group" aria-label="Modo de venta">
        <button class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:bg-ui-canvas @(ModoActual == ModoVenta.DesdePedido ? "sale-mode-active" : null)"
                type="button"
                disabled="@OperacionEnCurso"
                aria-pressed="@(ModoActual == ModoVenta.DesdePedido ? "true" : "false")"
                @onclick="() => CambiarModo(ModoVenta.DesdePedido)">
            Desde pedido
        </button>
        <button class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:bg-ui-canvas @(ModoActual == ModoVenta.VentaDirecta ? "sale-mode-active" : null)"
                type="button"
                disabled="@OperacionEnCurso"
                aria-pressed="@(ModoActual == ModoVenta.VentaDirecta ? "true" : "false")"
                @onclick="() => CambiarModo(ModoVenta.VentaDirecta)">
            Venta directa
        </button>
    </div>
</section>

<div hidden="@(ModoActual != ModoVenta.DesdePedido)">
<div class="grid min-w-0 gap-6">

@if (Cargando)
{
    <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        Cargando pedidos elegibles...
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorCarga))
{
    <section class="ui-card grid min-w-0 gap-4 p-5 sm:p-6" role="alert">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink">No fue posible abrir el formulario</h2>
        <p class="m-0 text-sm leading-6 text-ui-muted">@ErrorCarga</p>
        <div class="grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
            <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="button" @onclick="CargarAsync">Reintentar</button>
            <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/ventas">Volver a ventas</a>
        </div>
    </section>
}
else
{
    <section class="ui-card grid min-w-0 gap-4 p-4 sm:p-5" aria-labelledby="titulo-seleccionar-pedido">
        <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
            <div>
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-seleccionar-pedido">Pedido de origen</h2>
                <p class="mt-2 mb-0 text-sm leading-6 text-ui-muted">Se muestran pedidos no cancelados que todavía no tienen venta.</p>
            </div>
        </div>
        <div class="form-field min-w-0">
            <PedidoBuscador Seleccionado="PedidoSeleccionado" Deshabilitado="OperacionEnCurso" OnSeleccionado="pedido => SeleccionarPedidoAsync(pedido?.Id ?? 0)" />
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorGuardado))
    {
        <div class="mensaje-error" role="alert">@ErrorGuardado</div>
    }

    @if (CargandoPedido)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            Preparando el detalle exacto del pedido...
        </div>
    }
    else if (PedidoSeleccionado is not null)
    {
        <section class="grid min-w-0 gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Resumen del pedido seleccionado">
            <article class="ui-card grid min-w-0 content-start gap-2 p-4 sm:p-5">
                <span class="text-xs font-semibold tracking-wide text-ui-muted uppercase">Pedido</span>
                <strong class="min-w-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@PedidoSeleccionado.CodigoInterno</strong>
                <a class="inline-flex min-h-12 items-center rounded-xl text-sm font-semibold text-ui-accent no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" href="/pedidos/@PedidoSeleccionado.Id">Ver pedido</a>
            </article>
            <article class="ui-card grid min-w-0 content-start gap-2 p-4 sm:p-5">
                <span class="text-xs font-semibold tracking-wide text-ui-muted uppercase">Cliente</span>
                <strong class="min-w-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@PedidoSeleccionado.Cliente</strong>
                <span class="field-help">@PedidoPresentacion.Tipo(PedidoSeleccionado.TipoPedido)</span>
            </article>
            <article class="ui-card grid min-w-0 content-start gap-2 p-4 sm:p-5">
                <span class="text-xs font-semibold tracking-wide text-ui-muted uppercase">Cantidad exacta</span>
                <strong class="min-w-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@Detalles.Count @(Detalles.Count == 1 ? "artículo" : "artículos")</strong>
                <span class="field-help">No se pueden agregar ni quitar renglones.</span>
            </article>
        </section>

        <EditForm Model="Modelo" OnValidSubmit="RegistrarAsync" class="entity-form sale-form rm-sale-form">
            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />

            <section class="ui-card grid min-w-0 gap-4 p-4 sm:p-5" aria-label="Datos generales de la venta">
                <div class="grid min-w-0 gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
                    <div class="form-field min-w-0">
                        <label for="venta-fecha">Fecha <span aria-hidden="true">*</span></label>
                        <InputDate class="ui-input" id="venta-fecha" @bind-Value="Modelo.Fecha" disabled="@Registrando" aria-required="true" />
                    </div>
                    <div class="form-field min-w-0">
                        <label for="venta-observaciones">Observaciones</label>
                        <InputTextArea class="ui-input" id="venta-observaciones" @bind-Value="Modelo.Observaciones" rows="3" maxlength="500" disabled="@Registrando" aria-describedby="venta-observaciones-error" />
                        <ValidationMessage id="venta-observaciones-error" For="() => Modelo.Observaciones" />
                    </div>
                </div>
            </section>

            <section class="grid min-w-0 gap-4" aria-labelledby="titulo-articulos-venta">
                <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
                    <div>
                        <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-articulos-venta">Artículos de la venta</h2>
                        <p class="mt-2 mb-0 max-w-2xl text-sm leading-6 text-ui-muted">@(EsCatalogo
                            ? "Captura manualmente el costo histórico y confirma el precio real de cada artículo."
                            : "Selecciona una unidad disponible compatible para cada artículo; las reservas del mismo pedido aparecen primero.")</p>
                    </div>
                    <span class="text-sm text-ui-muted">@Detalles.Count renglones</span>
                </div>

                <div class="grid min-w-0 gap-4">
                    @foreach (var detalle in Detalles)
                    {
                        <article class="ui-card grid min-w-0 gap-4 p-4 sm:p-5" @key="detalle">
                            <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
                                <div>
                                    <span class="block text-xs leading-5 text-ui-muted [overflow-wrap:anywhere]">Unidad @detalle.Numero</span>
                                    <h3 class="mt-1 mb-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@detalle.Producto</h3>
                                </div>
                                <span class="status-badge status-badge-neutral">@(EsCatalogo ? "Catálogo" : "Inventario físico")</span>
                            </div>

                            <div class="grid min-w-0 gap-4 sm:grid-cols-2 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                                @if (EsCatalogo)
                                {
                                    <div class="form-field min-w-0">
                                        <label for="costo-@detalle.DetallePedidoId-@detalle.Numero">Costo unitario <span aria-hidden="true">*</span></label>
                                        <input class="ui-input" inputmode="decimal" data-select-once="true" id="costo-@detalle.DetallePedidoId-@detalle.Numero" type="number" min="0" step="0.01" required disabled="@Registrando" @bind="detalle.CostoUnitario" />
                                        <p class="field-help">Este costo queda registrado para calcular la utilidad; no se calculan comisiones.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="min-w-0">
                                    <UnidadBuscador Id="@($"unidad-{detalle.DetallePedidoId}-{detalle.Numero}")"
                                        Seleccionado="@UnidadesDisponibles.FirstOrDefault(x => x.Id == detalle.UnidadInventarioId)"
                                        ProductoId="detalle.ProductoId" PedidoId="PedidoSeleccionado.Id" Deshabilitado="Registrando"
                                        Excluir="@Detalles.Where(x => x != detalle && x.UnidadInventarioId.HasValue).Select(x => x.UnidadInventarioId!.Value).ToArray()"
                                        OnSeleccionado="unidad => ElegirUnidad(detalle, unidad)" />
                                    </div>
                                }

                                <div class="form-field min-w-0">
                                    <label for="precio-@detalle.DetallePedidoId-@detalle.Numero">Precio final <span aria-hidden="true">*</span></label>
                                    <input class="ui-input" inputmode="decimal" data-select-once="true" id="precio-@detalle.DetallePedidoId-@detalle.Numero" type="number" min="0" step="0.01" required disabled="@Registrando" @bind="detalle.PrecioFinal" />
                                    <p class="field-help">Precio real editable; no modifica el precio sugerido.</p>
                                </div>
                                <div class="form-field min-w-0 sm:col-span-2">
                                    <label for="nota-@detalle.DetallePedidoId-@detalle.Numero">Observaciones</label>
                                    <input class="ui-input" id="nota-@detalle.DetallePedidoId-@detalle.Numero" type="text" maxlength="500" disabled="@Registrando" @bind="detalle.Observaciones" />
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <div class="grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
                <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="submit" disabled="@Registrando">
                    @(Registrando ? "Registrando..." : "Registrar venta completa")
                </button>
                <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/ventas">Cancelar</a>
            </div>
        </EditForm>
    }
}
</div>
</div>
<div hidden="@(ModoActual != ModoVenta.VentaDirecta)">
    @if (DirectaInicializada)
    {
        <VentaDirectaForm OcupadoChanged="CambiarOcupacionDirecta" ClienteDesdeQuery="@ClienteDesdeQuery" />
    }
</div>

</div>

@code {
    private ModoVenta ModoActual { get; set; } = ModoVenta.DesdePedido;
    private bool DirectaInicializada { get; set; }
    private bool DirectaOcupada { get; set; }
    private bool OperacionEnCurso => Registrando || DirectaOcupada || CargandoPedido || Cargando;

    private void CambiarOcupacionDirecta(bool ocupado) => DirectaOcupada = ocupado;

    private void CambiarModo(ModoVenta modo)
    {
        if (OperacionEnCurso)
            return;

        ModoActual = modo;
        if (modo == ModoVenta.VentaDirecta)
            DirectaInicializada = true;
    }

    private VentaFormModel Modelo { get; set; } = new();
    private string CodigoVenta { get; } = CodigosInternos.CrearCodigoVenta();
    private IReadOnlyList<PedidoDto> PedidosElegibles { get; set; } = [];
    private IReadOnlyList<UnidadInventarioDto> UnidadesDisponibles { get; set; } = [];
    private List<DetalleVentaFormModel> Detalles { get; } = [];
    private PedidoDto? PedidoSeleccionado { get; set; }
    private int PedidoSeleccionadoId { get; set; }
    private bool Cargando { get; set; } = true;
    private bool CargandoPedido { get; set; }
    private bool Registrando { get; set; }
    private string? ErrorCarga { get; set; }
    private string? ErrorGuardado { get; set; }

    [SupplyParameterFromQuery(Name = "pedido")]
    public string? PedidoDesdeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "modo")]
    public string? ModoDesdeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "cliente")] public string? ClienteDesdeQuery { get; set; }


    private bool EsCatalogo => PedidoSeleccionado?.TipoPedido == TipoPedido.Catalogo;

    protected override async Task OnInitializedAsync()
    {
        if (string.Equals(ModoDesdeQuery, "directa", StringComparison.OrdinalIgnoreCase))
        {
            ModoActual = ModoVenta.VentaDirecta;
        }

        await CargarAsync();
        // La carga inicial termina antes de montar otro consumidor de la sesión de datos.
        // Una vez montado, el formulario conserva su pedido parcial incluso al recargar esta lista.
        if (ModoActual == ModoVenta.VentaDirecta)
            DirectaInicializada = true;
    }

    private async Task CargarAsync()
    {
        Cargando = true;
        ErrorCarga = null;
        try
        {
            // El buscador consulta pedidos elegibles bajo demanda.

            if (PedidoDesdeQuery is not null)
            {
                if (!int.TryParse(PedidoDesdeQuery, out var pedidoId) || pedidoId <= 0)
                    ErrorGuardado = "El enlace contiene un pedido inválido. Selecciona un pedido de la lista.";
                else
                    await SeleccionarPedidoAsync(pedidoId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar los pedidos elegibles para registrar una venta.");
            ErrorCarga = "Ocurrió un problema inesperado al cargar los pedidos. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task SeleccionarPedidoAsync(int pedidoId)
    {
        if (Registrando || CargandoPedido || DirectaOcupada)
            return;

        PedidoSeleccionadoId = pedidoId;
        PedidoSeleccionado = null;
        Detalles.Clear();
        UnidadesDisponibles = [];
        ErrorGuardado = null;
        Modelo = new VentaFormModel();

        if (pedidoId == 0)
            return;

        CargandoPedido = true;
        try
        {
            var resultado = await PedidoService.ObtenerPorIdAsync(pedidoId);
            if (!resultado.IsSuccess || resultado.Value is null)
            {
                ErrorGuardado = "El pedido seleccionado ya no es elegible para venta.";
                return;
            }
            if (resultado.Value.Estado == EstadoPedido.Cancelado || resultado.Value.VentaId.HasValue)
            {
                ErrorGuardado = "El pedido seleccionado ya no es elegible para venta.";
                return;
            }

            PedidoSeleccionado = resultado.Value;
            if (!EsCatalogo)
            {
                var reservadas = new List<UnidadInventarioDto>();
                IReadOnlyList<UnidadInventarioDto> lote;
                do
                {
                    lote = await SeleccionService.BuscarUnidadesAsync("", pedidoId: pedidoId, excluir: reservadas.Select(x => x.Id).ToArray(), soloReservadas: true);
                    reservadas.AddRange(lote);
                } while (lote.Count == 12);
                UnidadesDisponibles = reservadas;
            }
            ConstruirDetallesExactos();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible preparar el pedido {PedidoId} para venta.", pedidoId);
            PedidoSeleccionado = null;
            Detalles.Clear();
            ErrorGuardado = "No pudimos preparar el pedido. Intenta nuevamente.";
        }
        finally
        {
            CargandoPedido = false;
        }
    }

    private void ConstruirDetallesExactos()
    {
        Detalles.Clear();
        if (PedidoSeleccionado is null)
            return;

        var reservadasUsadas = new HashSet<int>();
        foreach (var pedidoDetalle in PedidoSeleccionado.Detalles)
        {
            for (var numero = 1; numero <= pedidoDetalle.Cantidad; numero++)
            {
                var detalle = new DetalleVentaFormModel
                {
                    DetallePedidoId = pedidoDetalle.Id,
                    ProductoId = pedidoDetalle.ProductoId,
                    Producto = pedidoDetalle.Producto,
                    Numero = numero,
                    PrecioFinal = pedidoDetalle.PrecioUnitario,
                    Observaciones = pedidoDetalle.Observaciones,
                };

                if (!EsCatalogo)
                {
                    var reservada = UnidadesDisponibles.FirstOrDefault(x =>
                        x.ProductoId == pedidoDetalle.ProductoId
                        && x.PedidoReservaId == PedidoSeleccionado.Id
                        && reservadasUsadas.Add(x.Id));
                    detalle.UnidadInventarioId = reservada?.Id;
                }

                Detalles.Add(detalle);
            }
        }
    }

    private IReadOnlyList<UnidadInventarioDto> OpcionesPara(DetalleVentaFormModel detalle)
    {
        if (PedidoSeleccionado is null)
            return [];

        var usadasPorOtros = Detalles
            .Where(x => !ReferenceEquals(x, detalle) && x.UnidadInventarioId.HasValue)
            .Select(x => x.UnidadInventarioId!.Value)
            .ToHashSet();

        return UnidadesDisponibles
            .Where(x =>
                x.Estado == EstadoUnidadInventario.Disponible
                && x.ProductoId == detalle.ProductoId
                && (!x.PedidoReservaId.HasValue || x.PedidoReservaId == PedidoSeleccionado.Id)
                && !usadasPorOtros.Contains(x.Id))
            .OrderByDescending(x => x.PedidoReservaId == PedidoSeleccionado.Id)
            .ThenBy(x => x.CodigoInterno)
            .ToList();
    }

    private void ElegirUnidad(DetalleVentaFormModel detalle, UnidadInventarioDto? unidad)
    {
        if (Registrando) return;
        if (unidad is not null)
        {
            if (unidad.ProductoId != detalle.ProductoId || Detalles.Any(x => x != detalle && x.UnidadInventarioId == unidad.Id)) return;
            UnidadesDisponibles = UnidadesDisponibles.Where(x => x.Id != unidad.Id).Append(unidad).ToArray();
        }
        detalle.UnidadInventarioId = unidad?.Id;
    }

    private void SeleccionarUnidad(DetalleVentaFormModel detalle, string? valor)
    {
        if (!Registrando)
            detalle.UnidadInventarioId = int.TryParse(valor, out var unidadId) ? unidadId : null;
    }

    private async Task RegistrarAsync()
    {
        if (Registrando || PedidoSeleccionado is null)
            return;

        ErrorGuardado = ValidarDetalles();
        if (ErrorGuardado is not null)
            return;

        Registrando = true;
        try
        {
            var input = new VentaInput(
                PedidoSeleccionado.Id,
                CodigoVenta,
                Modelo.Fecha,
                Modelo.Observaciones,
                Detalles.Select(x => x.ToInput(EsCatalogo)).ToArray());
            var resultado = await VentaService.RegistrarDesdePedidoAsync(input);
            if (!resultado.IsSuccess || resultado.Value is null)
            {
                ErrorGuardado = resultado.ErrorMessage ?? "No fue posible registrar la venta.";
                return;
            }

            Navigation.NavigateTo($"/ventas/{resultado.Value.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible registrar la venta desde el pedido {PedidoId}.", PedidoSeleccionado.Id);
            ErrorGuardado = "Ocurrió un problema inesperado al registrar la venta. Intenta nuevamente.";
        }
        finally
        {
            Registrando = false;
        }
    }

    private string? ValidarDetalles()
    {
        if (PedidoSeleccionado is null || Detalles.Count != PedidoSeleccionado.Detalles.Sum(x => x.Cantidad))
            return "Los artículos deben coincidir exactamente con el pedido.";
        if (Detalles.Any(x => x.PrecioFinal < 0))
            return "El precio final no puede ser negativo.";
        if (EsCatalogo)
            return Detalles.Any(x => !x.CostoUnitario.HasValue || x.CostoUnitario < 0)
                ? "Captura un costo unitario válido para cada artículo de catálogo."
                : null;
        if (Detalles.Any(x => !x.UnidadInventarioId.HasValue))
            return "Selecciona una unidad disponible para cada artículo físico.";
        if (Detalles.Select(x => x.UnidadInventarioId).Distinct().Count() != Detalles.Count)
            return "Una unidad de inventario no puede repetirse en la venta.";
        if (Detalles.Any(x => !OpcionesPara(x).Any(u => u.Id == x.UnidadInventarioId)))
            return "Una unidad seleccionada ya no está disponible o no es compatible con el pedido.";
        return null;
    }
    private enum ModoVenta
    {
        DesdePedido,
        VentaDirecta,
    }
}
