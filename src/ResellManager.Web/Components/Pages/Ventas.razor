@page "/ventas"
@rendermode InteractiveServer
@inject IVentaService VentaService
@inject NavigationManager Navigation
@inject ILogger<Ventas> Logger

<PageTitle>Ventas | ResellManager</PageTitle>

<div class="rm-sales grid min-w-0 gap-6 pb-4">
    <section class="flex items-start justify-between gap-4" aria-labelledby="titulo-ventas">
        <div class="grid min-w-0 gap-2">
            <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Operación</p>
            <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-ventas">Ventas</h1>
            <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">Consulta ventas registradas y canceladas. Toda venta se origina en un pedido.</p>
        </div>
        <a class="ui-button shrink-0 bg-ui-accent text-white hover:bg-ui-accent-hover" href="/ventas/nueva">
            <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            <span class="sr-only sm:not-sr-only">Nueva venta</span>
        </a>
    </section>

    <FiltrosHistorial Id="filtros-ventas" Modelo="Filtros" Placeholder="Buscar por código de venta" Ocupado="Cargando" OnAplicar="AplicarFiltrosAsync" OnLimpiar="LimpiarFiltrosAsync">
        <div class="grid min-w-0 gap-2 [&>label]:text-sm [&>label]:font-semibold">
            <label for="estado-historial">Estado</label>
            <select class="ui-input" id="estado-historial" @bind="Filtros.Estado" disabled="@Cargando">
                <option value="">Todos</option>
                <option value="registrada">Registrada</option>
                <option value="cancelada">Cancelada</option>
            </select>
        </div>
    </FiltrosHistorial>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger" role="alert">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <span>@ErrorMessage</span>
                <button class="ui-button border-ui-danger/30 bg-white text-ui-danger hover:bg-ui-danger/5" type="button" @onclick="CargarAsync">Reintentar</button>
            </div>
        </div>
    }

    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando ventas...
        </div>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage) && VentasRegistradas.Count == 0)
    {
        <section class="empty-state ui-card min-w-0 p-6 text-center text-ui-muted sm:p-8" aria-labelledby="titulo-sin-ventas">
            <div class="grid justify-items-center gap-4">
                <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-ui-accent/10 text-ui-accent" aria-hidden="true"><NavIcon Name="cart" /></span>
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-sin-ventas">@(Filtros.Activo ? "No se encontraron ventas con estos filtros" : "Aún no hay ventas")</h2>
                <p class="m-0 max-w-md text-sm leading-6 text-ui-muted">Elige un pedido pendiente para registrar la primera venta.</p>
                <a class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" href="/ventas/nueva">Registrar venta</a>
            </div>
        </section>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="grid min-w-0 gap-4" aria-labelledby="titulo-listado-ventas">
            <div class="flex flex-wrap items-center justify-between gap-2 px-1">
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-listado-ventas">Listado de ventas</h2>
                <span class="text-sm text-ui-muted">@VentasRegistradas.Count @(VentasRegistradas.Count == 1 ? "venta" : "ventas")</span>
            </div>
            @foreach (var grupo in Grupos)
            {
                <section class="grid min-w-0 gap-3" aria-label="@grupo.Titulo">
                    <h3 class="m-0">
                        <button class="ui-button w-full justify-between border-ui-border bg-ui-canvas text-left text-ui-ink hover:bg-white" type="button"
                                aria-expanded="@(Meses.Abierto(grupo.Anio, grupo.Mes) ? "true" : "false")"
                                @onclick="() => Meses.Alternar(grupo.Anio, grupo.Mes)">
                            <span>@grupo.Titulo</span>
                            <svg class="size-5 shrink-0 @(Meses.Abierto(grupo.Anio, grupo.Mes) ?"rotate-90" : "")" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
                        </button>
                    </h3>
                    @* A single responsive list serves both sale-desktop-table and sale-mobile-cards views. *@
                    <div class="sale-desktop-table sale-mobile-cards grid min-w-0 gap-3" role="list">
                        @foreach (var venta in Meses.Abierto(grupo.Anio, grupo.Mes) ? grupo.Registros : Array.Empty<VentaDto>())
                        {
                            <article class="ui-card min-w-0" role="listitem">
                                <a class="grid min-w-0 grid-cols-[minmax(0,1fr)_1.25rem] items-start gap-x-3 gap-y-2 rounded-3xl p-4 text-ui-ink no-underline transition-colors duration-150 hover:bg-ui-accent/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent motion-reduce:transition-none sm:grid-cols-[minmax(0,1fr)_auto_1.25rem] sm:items-center sm:gap-x-5 sm:p-5"
                                   href="/ventas/@venta.Id" aria-label="@($"Ver venta {venta.CodigoInterno}")">
                                    <div class="grid min-w-0 gap-1">
                                        <h3 class="m-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@venta.Cliente</h3>
                                        <span class="max-w-full font-mono text-xs leading-5 break-all text-ui-muted">@venta.CodigoInterno</span>
                                        <span class="text-sm leading-6 text-ui-muted">@venta.Fecha.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="col-start-1 min-w-0 sm:col-start-2 sm:row-start-1 sm:text-right">
                                        <p class="m-0 text-lg font-semibold leading-6 tracking-tight text-ui-ink tabular-nums [overflow-wrap:anywhere]">@VentaPresentacion.Moneda(venta.Total)</p>
                                        <span class="text-xs leading-5 text-ui-muted">Total · @venta.Detalles.Count @(venta.Detalles.Count == 1 ? "artículo" : "artículos")</span>
                                    </div>
                                    <svg class="col-start-2 row-start-1 row-span-2 mt-1 size-5 text-ui-muted sm:col-start-3 sm:row-span-1 sm:mt-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
                                </a>
                                <div class="flex flex-wrap items-center justify-between gap-2 border-0 border-t border-solid border-ui-border px-4 py-2 sm:px-5">
                                    <a class="ui-button min-w-0 border-ui-border bg-white text-ui-accent [overflow-wrap:anywhere] hover:bg-ui-accent/5" href="/pedidos/@venta.PedidoId">Pedido #@venta.PedidoId</a>
                                    <span class="inline-flex items-center rounded-full bg-ui-warning/5 px-3 py-1 text-xs font-semibold leading-5 text-ui-warning @VentaPresentacion.ClaseEstado(venta.Estado)">@VentaPresentacion.Estado(venta.Estado)</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </section>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarConsulta { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] public string? DesdeConsulta { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] public string? HastaConsulta { get; set; }
    private FiltroHistorialModelo Filtros { get; } = new();
    private MesesDesplegables Meses { get; } = new();
    private string? ErrorConsulta { get; set; }
    [SupplyParameterFromQuery(Name = "estado")] public string? EstadoConsulta { get; set; }
    private ResellManager.Domain.Enums.EstadoVenta? EstadoFiltrado => Filtros.Estado switch { "registrada" => ResellManager.Domain.Enums.EstadoVenta.Registrada, "cancelada" => ResellManager.Domain.Enums.EstadoVenta.Cancelada, _ => null };
    private IReadOnlyList<GrupoMensual<VentaDto>> Grupos { get; set; } = [];

    private IReadOnlyList<VentaDto> VentasRegistradas { get; set; } = [];
    private bool Cargando { get; set; } = true;
    private string? ErrorMessage { get; set; }

    protected override Task OnParametersSetAsync()
    {
        ErrorConsulta = Filtros.Cargar(BuscarConsulta, DesdeConsulta, HastaConsulta, EstadoConsulta);
        if (Filtros.Estado is not ("" or "registrada" or "cancelada")) ErrorConsulta = "El estado de venta no es válido. Selecciona una opción disponible.";
        return CargarAsync();
    }

    private Task AplicarFiltrosAsync()
    {
        if (Cargando) return Task.CompletedTask;
        ErrorConsulta = Filtros.Validar();
        if (ErrorConsulta is not null) { ErrorMessage = ErrorConsulta; return Task.CompletedTask; }
        return Filtros.NavegarAsync(Navigation, "/ventas", CargarAsync);
    }
    private Task LimpiarFiltrosAsync() { Filtros.Limpiar(); return AplicarFiltrosAsync(); }

    private async Task CargarAsync()
    {
        ErrorMessage = ErrorConsulta ?? Filtros.Validar();
        if (ErrorMessage is not null) { VentasRegistradas = []; Grupos = []; Cargando = false; return; }
        Cargando = true;
        try
        {
            VentasRegistradas = await VentaService.ListarAsync(filtro: Filtros.ToInput(), estado: EstadoFiltrado);
            Grupos = HistorialMensual.Agrupar(VentasRegistradas, x => x.Fecha, x => x.Id);
            Meses.Reiniciar(Grupos);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar el listado de ventas.");
            ErrorMessage = "No pudimos cargar las ventas. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }
}
