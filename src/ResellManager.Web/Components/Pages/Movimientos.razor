@page "/movimientos"
@rendermode InteractiveServer
@inject IFinanzasService Finanzas
@inject ICuentaOperativa Acceso
@inject IClienteService Clientes

<PageTitle>Movimientos y Ajustes | ResellManager</PageTitle>
<div class="min-w-0 space-y-6">
    <h1 class="text-3xl font-bold">Movimientos y Ajustes</h1>
    <p>Consulta el estado de cuenta. Los ajustes cambian la deuda y conservan su motivo.</p>
    @if (Administrador)
    {
        <a class="ui-button bg-ui-accent text-white" href="/clientes/apertura">Preparar apertura de cartera</a>
    }
    <form class="ui-card grid gap-4 p-5 sm:grid-cols-2" @onsubmit="Buscar" @onsubmit:preventDefault>
        <ClienteBuscador Id="movimientos-cliente" Seleccionado="ClienteFiltro" Deshabilitado="Ocupado" OnSeleccionado="FiltrarCliente" />
        <label>Tipo <select class="ui-input" @bind="Tipo"><option value="">Todos</option>@foreach (var t in Tipos) { <option>@t</option> }</select></label>
        <label>Desde <input class="ui-input" type="date" @bind="Desde" /></label>
        <label>Hasta <input class="ui-input" type="date" @bind="Hasta" /></label>
        <label>Referencia <input class="ui-input" maxlength="200" @bind="Referencia" /></label>
        <button class="ui-button bg-ui-accent text-white" disabled="@Ocupado">Consultar</button>
    </form>
    @if (Error is not null) { <p role="alert" class="text-ui-danger">@Error</p> }
    @if (Pagina is not null)
    {
        @if (Pagina.SaldoActual.HasValue) { <p class="text-xl font-semibold">Saldo actual global: Q @Pagina.SaldoActual.Value.ToString("N2")</p> }
        <div class="flex flex-wrap gap-3">
            <a class="ui-button border-ui-control bg-white" href="@Descarga("xlsx")" download>Excel</a>
            <a class="ui-button border-ui-control bg-white" href="@Descarga("pdf")" download>PDF</a>
        </div>
        <ul class="m-0 grid list-none gap-3 p-0">
            @foreach (var m in Pagina.Filas)
            {
                <li class="ui-card min-w-0 space-y-2 p-5" @key="m.Id">
                    <p class="font-semibold">@m.Tipo · @m.Cliente · Q @m.Importe.ToString("N2")</p>
                    <p>@m.Fecha.ToString("dd/MM/yyyy") · @m.Descripcion</p>
                    <p class="break-all text-sm text-ui-muted">Movimiento: @m.Id</p>
                    <div class="flex flex-wrap gap-3">
                        @if(m.ClienteId.HasValue) { <a href="/clientes/@m.ClienteId">Ver cliente</a> }
                        @if(Documento(m) is {} documento) { <a href="@documento">Ver documento de origen</a> }
                    </div>
                    <p class="break-words text-sm text-ui-muted">Referencia: @m.Referencia · Registro: @(m.RegistradoUtc?.ToString("u") ?? "Histórico sin hora registrada") · Usuario: @(m.UsuarioId ?? "Histórico sin autor registrado")</p>
                    @if (m.OriginalId is not null) { <p class="break-words text-sm">Movimiento original: @m.OriginalId</p> }
                    @if (Administrador && m.Tipo == "Ajuste")
                    {
                        <button type="button" class="ui-button border-ui-control bg-white" disabled="@Ocupado" @onclick="() => ElegirReversion(m)">Revertir ajuste</button>
                    }
                </li>
            }
        </ul>
        @if (Pagina.Filas.Count == 0) { <p>No hay movimientos para estos filtros.</p> }
        <div class="flex gap-3">
            <button class="ui-button border-ui-control bg-white" disabled="@(Ocupado || NumeroPagina == 1)" @onclick="Anterior">Anterior</button>
            <span>Página @NumeroPagina</span>
            <button class="ui-button border-ui-control bg-white" disabled="@(Ocupado || !Pagina.HayMas)" @onclick="Siguiente">Siguiente</button>
        </div>
    }
    @if (Administrador)
    {
        <section class="ui-card grid gap-4 p-5">
            <h2 class="text-xl font-semibold">@(Reversion is null ? "Crear ajuste" : "Revertir ajuste")</h2>
            @if(Reversion is null) { <ClienteBuscador Id="ajuste-cliente" Seleccionado="ClienteAjuste" Deshabilitado="@(Revision is not null || Ocupado)" OnSeleccionado="SeleccionarAjuste" /> } else { <p>Cliente: @NombreReversion</p> }
            <label>Importe con signo en Q <input class="ui-input" type="number" step="0.01" @bind="Importe" disabled="@(Reversion is not null || Revision is not null || Ocupado)" /></label>
            <label>Motivo obligatorio <textarea class="ui-input" maxlength="1000" @bind="Motivo" disabled="@(Revision is not null || Ocupado)"></textarea></label>
            <label>Referencia <input class="ui-input" maxlength="200" @bind="ReferenciaAjuste" disabled="@(Reversion is not null || Revision is not null || Ocupado)" /></label>
            @if (Revision is not null)
            {
                <p>Saldo anterior Q @Revision!.SaldoAnterior.ToString("N2") · Cambio Q @Importe.ToString("N2") · Resultado Q @(Revision!.SaldoResultante.ToString("N2"))</p>
                <p>El saldo se volverá a validar al confirmar.</p>
                <button class="ui-button bg-ui-accent text-white" disabled="@Ocupado" @onclick="Confirmar">Confirmar operación</button>
            }
            else { <button class="ui-button border-ui-control bg-white" disabled="@Ocupado" @onclick="Revisar">Revisar ajuste</button> }
            <button class="ui-button border-ui-control bg-white" disabled="@Ocupado" @onclick="Cancelar">Cancelar</button>
        </section>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "cliente")] public int? Cliente { get; set; }
    private bool Administrador, Ocupado;
    private ClienteDto? ClienteFiltro,ClienteAjuste;
    private string? NombreReversion;
    private string? Error, Tipo, Referencia;
    private DateOnly? Desde, Hasta;
    private PaginaMovimientosDto? Pagina;
    private int NumeroPagina = 1, AjusteCliente;
    private decimal Importe;
    private ResultadoAjusteDto? Revision;
    private string Motivo = "", ReferenciaAjuste = "", Clave = Guid.NewGuid().ToString("N");
    private Guid? Reversion;
    private FiltroMovimientos Aplicado = new();
    private static readonly string[] Tipos = ["Apertura", "Ajuste", "Reversion", "Venta", "Abono", "Cancelacion"];
    protected override async Task OnInitializedAsync()
    {
        Administrador=(await Acceso.ObtenerAsync())?.Administrador==true;
        if(Cliente.HasValue) { ClienteFiltro=(await Clientes.ObtenerPorIdAsync(Cliente.Value)).Value; ClienteAjuste=ClienteFiltro;AjusteCliente=ClienteFiltro?.Id??0; }
        await Buscar();
    }
    private void FiltrarCliente(ClienteDto? cliente){ClienteFiltro=cliente;Cliente=cliente?.Id;}
    private void SeleccionarAjuste(ClienteDto? cliente){ClienteAjuste=cliente;AjusteCliente=cliente?.Id??0;}
    private async Task Buscar() { NumeroPagina = 1; Aplicado = new(Cliente, Desde, Hasta, Tipo, Referencia); await Cargar(); }
    private async Task Cargar()
    {
        if (Ocupado) return; Ocupado = true; Error = null;
        try { var r = await Finanzas.ConsultarAsync(Aplicado with { Pagina = NumeroPagina }); if (r.IsSuccess) Pagina = r.Value; else Error = r.ErrorMessage; }
        catch { Error = "No fue posible consultar. Reintenta la operación."; }
        finally { Ocupado = false; }
    }
    private async Task Anterior() { NumeroPagina--; await Cargar(); }
    private async Task Siguiente() { NumeroPagina++; await Cargar(); }
    private string Descarga(string formato) => $"/informes/{(Aplicado.ClienteId.HasValue ? "cliente" : "movimientos")}/{formato}?cliente={Aplicado.ClienteId}&desde={Aplicado.Desde:yyyy-MM-dd}&hasta={Aplicado.Hasta:yyyy-MM-dd}&tipo={Uri.EscapeDataString(Aplicado.Tipo ?? "")}&referencia={Uri.EscapeDataString(Aplicado.Referencia ?? "")}";
    private string? Documento(MovimientoDto movimiento)
    {
        if(movimiento.Tipo is "Venta" or "Cancelacion" && int.TryParse(movimiento.Id.Split('-').Last(),out var ventaId)) return $"/ventas/{ventaId}";
        if(movimiento.Tipo=="Apertura" && Administrador) return "/clientes/apertura";
        if(movimiento.Tipo=="Abono") return $"/pagos?cliente={movimiento.ClienteId}";
        return null;
    }
    private void ElegirReversion(MovimientoDto m) { Cancelar(); Reversion = Guid.Parse(m.Id); AjusteCliente = m.ClienteId!.Value; NombreReversion=m.Cliente; Importe = -m.Importe; ReferenciaAjuste = m.Id; }
    private void Cancelar() { Reversion = null; Revision = null; Motivo = ""; ReferenciaAjuste = ""; Importe = 0; Clave = Guid.NewGuid().ToString("N"); }
    private async Task Revisar()
    {
        if(Ocupado)return;Ocupado=true;Error=null;
        try
        {
            if(string.IsNullOrWhiteSpace(Motivo)){Error="Introduce un motivo.";return;}
            var r = await Finanzas.RevisarAjusteAsync(AjusteCliente, Importe);
            if(!r.IsSuccess){Error=r.ErrorMessage;return;}
            Revision=r.Value;
        }
        catch{Error="No fue posible revisar el ajuste. Reintenta.";}
        finally{Ocupado=false;}
    }
    private async Task Confirmar()
    {
        if (Ocupado) return; Ocupado = true; Error = null;
        try
        {
            var r = Reversion.HasValue ? await Finanzas.RevertirAsync(Reversion.Value, Motivo, Clave)
                : await Finanzas.AjustarAsync(new(AjusteCliente, Importe, Motivo, Clave, ReferenciaAjuste));
            if (r.IsSuccess) Cancelar(); else Error = r.ErrorMessage;
        }
        catch { Error = "No se confirmó el resultado. Conserva los datos y reintenta con la misma operación."; }
        finally { Ocupado = false; }
        if (Error is null) await Cargar();
    }
}
