@page "/productos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IProductoService ProductoService
@inject ICategoriaService CategoriaService
@inject ILogger<Productos> Logger

<PageTitle>Productos | ResellManager</PageTitle>

<div class="min-w-0 space-y-6 pb-4" @ref="ElementoListado">
    <section class="flex items-start justify-between gap-4" aria-labelledby="titulo-productos">
        <div class="min-w-0 space-y-2">
            <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Catálogo</p>
            <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-productos">Productos</h1>
            <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">Administra las definiciones de artículos y sus precios sugeridos de referencia.</p>
        </div>
        <a class="ui-button shrink-0 bg-ui-accent text-white hover:bg-ui-accent-hover" href="/productos/nuevo">
            <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            <span class="sr-only sm:not-sr-only">Nuevo producto</span>
        </a>
    </section>

    @if (!string.IsNullOrWhiteSpace(MensajeExito))
    {
        <div class="rounded-2xl border border-solid border-ui-success/20 bg-ui-success/5 px-4 py-3 text-sm leading-6 text-ui-success" role="status">@MensajeExito</div>
    }

    <form class="ui-card grid min-w-0 gap-4 p-4 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_auto] md:items-end sm:p-5" @onsubmit="BuscarAsync" @onsubmit:preventDefault>
        <div class="grid min-w-0 gap-2">
            <label class="text-sm font-medium" for="buscar-producto">Buscar producto</label>
            <div class="relative min-w-0">
                <svg class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-ui-muted" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
                <input class="ui-input pl-11" id="buscar-producto" type="search" placeholder="Nombre, código interno o código de barras"
                       @bind="Termino" @bind:event="oninput" disabled="@Ocupado" />
            </div>
        </div>
        <div class="grid min-w-0 gap-2">
            <label class="text-sm font-medium" for="categoria-productos">Categoría</label>
            <select class="ui-input" id="categoria-productos" @bind="CategoriaId" disabled="@Ocupado">
                <option value="">Todas las categorías</option>
                @foreach (var categoria in CategoriaPresentacion.Ordenar(Categorias))
                {
                    <option value="@categoria.Id">@CategoriaPresentacion.Etiqueta(categoria)</option>
                }
            </select>
        </div>
        <div class="flex gap-2">
            <button class="ui-button flex-1 bg-ui-accent text-white hover:bg-ui-accent-hover" type="submit" disabled="@Ocupado">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Termino) || BusquedaActiva || CategoriaId.HasValue)
            {
                <button class="ui-button flex-1 border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" type="button" disabled="@Ocupado" @onclick="LimpiarBusquedaAsync">Limpiar</button>
            }
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger" role="alert">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <span>@ErrorMessage</span>
                <button class="ui-button border-ui-danger/30 bg-white text-ui-danger hover:bg-ui-danger/5" type="button" @onclick="CargarProductosAsync">Reintentar</button>
            </div>
        </div>
    }

    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando productos...
        </div>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage) && ProductosEncontrados.Count == 0)
    {
        <section class="empty-state ui-card min-w-0 p-6 text-center text-ui-muted sm:p-8" aria-labelledby="titulo-sin-productos">
            <div class="grid justify-items-center gap-4">
                <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-ui-accent/10 text-ui-accent" aria-hidden="true"><NavIcon Name="tag" /></span>
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-sin-productos">@(BusquedaActiva ? "No se encontraron productos" : "Aún no hay productos")</h2>
                <p class="m-0 max-w-md text-sm leading-6 text-ui-muted">@(BusquedaActiva ? "Prueba con otro nombre, código interno o código de barras." : "Registra la primera definición de producto para comenzar.")</p>
                @if (!BusquedaActiva)
                {
                    <a class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" href="/productos/nuevo">Registrar producto</a>
                }
            </div>
        </section>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="min-w-0 space-y-4" aria-labelledby="titulo-listado-productos">
            <div class="flex flex-wrap items-center justify-between gap-2 px-1">
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-listado-productos">Listado de productos</h2>
                <span class="text-sm text-ui-muted">@ProductosEncontrados.Count @(ProductosEncontrados.Count == 1 ? "producto cargado" : "productos cargados")</span>
            </div>

            <ul class="m-0 list-none space-y-3 p-0" role="list">
                @foreach (var producto in ProductosEncontrados)
                {
                    <li @key="producto.Id" class="ui-card min-w-0">
                        <article aria-label="@producto.Nombre">
                            <a class="grid min-w-0 grid-cols-[4.5rem_minmax(0,1fr)_1.25rem] items-start gap-x-3 gap-y-2 rounded-3xl p-4 text-ui-ink no-underline transition-colors duration-150 hover:bg-ui-accent/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent motion-reduce:transition-none sm:grid-cols-[5rem_minmax(0,1fr)_minmax(8rem,auto)_1.25rem] sm:items-center sm:gap-x-5 sm:p-5" href="/productos/@producto.Id" aria-label="@($"Ver detalle de {producto.Nombre}")">
                                <span class="row-span-2 flex size-18 items-center justify-center overflow-hidden rounded-2xl border border-solid border-ui-border bg-ui-canvas text-ui-muted sm:row-span-1 sm:size-20">
                                    <ImagenProducto ProductoId="producto.Id" Referencia="@producto.ImagenPrincipalRuta"
                                                    Nombre="@producto.Nombre" Miniatura="true" Decorativa="true" />
                                </span>
                                <div class="min-w-0 space-y-1.5">
                                    <h3 class="m-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@producto.Nombre</h3>
                                    @if (!string.IsNullOrWhiteSpace(ProductoPresentacion.DatosBreves(producto)))
                                    {
                                        <p class="m-0 text-sm leading-5 text-ui-muted [overflow-wrap:anywhere]">@ProductoPresentacion.DatosBreves(producto)</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(producto.Presentacion) || producto.ContenidoMl.HasValue || producto.PesoGramos.HasValue)
                                    {
                                        <p class="m-0 flex flex-wrap gap-x-2 text-sm leading-5 text-ui-muted [overflow-wrap:anywhere]">
                                            @if (!string.IsNullOrWhiteSpace(producto.Presentacion))
                                            {
                                                <span>@producto.Presentacion</span>
                                            }
                                            @if (producto.ContenidoMl.HasValue)
                                            {
                                                <span>@producto.ContenidoMl ml</span>
                                            }
                                            @if (producto.PesoGramos.HasValue)
                                            {
                                                <span>@producto.PesoGramos g</span>
                                            }
                                        </p>
                                    }
                                    <span class="inline-flex max-w-full rounded-full bg-ui-canvas px-2.5 py-1 text-xs font-medium leading-5 text-ui-muted [overflow-wrap:anywhere]">@CategoriaPresentacion.Etiqueta(producto, Categorias)</span>
                                </div>
                                <div class="col-start-2 min-w-0 sm:col-start-3 sm:text-right">
                                    <p class="m-0 text-base font-semibold leading-6 tracking-tight text-ui-ink tabular-nums [overflow-wrap:anywhere] sm:text-lg">@ProductoPresentacion.PrecioSugerido(producto.PrecioSugerido)</p>
                                    <span class="block text-xs leading-5 text-ui-muted">Precio sugerido</span>
                                </div>
                                <svg class="col-start-3 row-start-1 row-span-2 mt-1 size-5 text-ui-muted sm:col-start-4 sm:row-span-1 sm:mt-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
                            </a>
                            <div class="grid gap-3 border-0 border-t border-solid border-ui-border px-4 py-3 sm:flex sm:items-center sm:justify-between sm:px-5">
                                <div class="min-w-0 space-y-1 text-xs leading-5 text-ui-muted">
                                    <p class="m-0">Código interno · <span class="inline-block max-w-full align-top font-mono break-all">@producto.CodigoInterno</span></p>
                                    @if (!string.IsNullOrWhiteSpace(producto.CodigoBarras))
                                    {
                                        <p class="m-0">Código de barras · <span class="inline-block max-w-full align-top font-mono break-all">@producto.CodigoBarras</span></p>
                                    }
                                </div>
                                <div class="grid grid-cols-2 gap-2 sm:flex sm:shrink-0">
                                    <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/productos/@producto.Id">Ver detalle</a>
                                    <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/productos/@producto.Id/editar">Editar</a>
                                </div>
                            </div>
                        </article>
                    </li>
                }
            </ul>
            @if (HayMas)
            {
                <div @key="(VersionBusqueda, SiguienteCursor)" data-productos-sentinel
                     data-enabled="@(!Ocupado && ErrorMas is null ? "true" : "false")" aria-hidden="true"></div>
                @if (ErrorMas is not null)
                {
                    <p class="mensaje-error text-sm text-ui-danger" role="alert">@ErrorMas</p>
                }
                <div class="flex justify-center">
                    <button class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" type="button"
                            disabled="@Ocupado" @onclick="CargarMasAsync">
                        @(CargandoMas ? "Cargando más productos…" : ErrorMas is not null ? "Reintentar carga" : "Cargar más productos")
                    </button>
                </div>
                @if (CargandoMas)
                {
                    <p class="m-0 text-sm text-ui-muted" role="status" aria-live="polite">Cargando el siguiente grupo de productos…</p>
                }
            }
            else
            {
                <p class="m-0 text-center text-sm text-ui-muted" role="status">Mostrando todos los resultados.</p>
            }
        </section>
    }
</div>

@code {
    private List<ProductoDto> ProductosEncontrados { get; } = [];
    private readonly HashSet<int> IdsCargados = [];
    private readonly CancellationTokenSource Vida = new();
    private IReadOnlyList<CategoriaDto> Categorias { get; set; } = [];
    private int? CategoriaId { get; set; }
    private string Termino { get; set; } = string.Empty;
    private string TerminoAplicado = string.Empty;
    private int? CategoriaAplicada;
    private bool BusquedaActiva { get; set; }
    private bool Cargando { get; set; }
    private bool CargandoMas;
    private bool HayMas;
    private ProductoCursorDto? SiguienteCursor;
    private int VersionBusqueda;
    private string? ErrorMessage { get; set; }
    private string? ErrorMas;
    private bool Ocupado => Cargando || CargandoMas;
    private ElementReference ElementoListado;
    private IJSObjectReference? Modulo;
    private DotNetObjectReference<Productos>? Referencia;
    private bool Descartado;
    private bool Inicializando;

    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Mensaje { get; set; }

    private string? MensajeExito => Mensaje switch
    {
        "producto-creado" => "Producto registrado correctamente.",
        "producto-creado-sin-imagen-externa" => "Producto registrado. No pudimos incorporar la imagen externa; se guardó sin ella.",
        "producto-editado" => "Producto actualizado correctamente.",
        _ => null,
    };

    protected override Task OnInitializedAsync() => CargarProductosAsync();

    private void Anexar(ProductoPaginaDto pagina)
    {
        ProductosEncontrados.AddRange(pagina.Items.Where(x => IdsCargados.Add(x.Id)));
        HayMas = pagina.HayMas;
        SiguienteCursor = pagina.SiguienteCursor;
    }

    private async Task CargarProductosAsync()
    {
        if (Descartado || Ocupado) return;
        Cargando = true;
        ErrorMessage = null;
        ErrorMas = null;
        TerminoAplicado = Termino.Trim();
        CategoriaAplicada = CategoriaId;
        BusquedaActiva = TerminoAplicado.Length > 0 || CategoriaAplicada.HasValue;
        VersionBusqueda++;
        ProductosEncontrados.Clear();
        IdsCargados.Clear();
        SiguienteCursor = null;
        HayMas = false;
        var ct = Vida.Token;
        try
        {
            Categorias = await CategoriaService.ListarAsync(ct);
            var pagina = await ProductoService.ListarPaginaAsync(TerminoAplicado, CategoriaAplicada, ct: ct);
            if (!Descartado) Anexar(pagina);
        }
        catch (OperationCanceledException) when (Descartado) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar el listado de productos.");
            ErrorMessage = "No pudimos cargar los productos. Intenta nuevamente.";
        }
        finally { Cargando = false; }
    }

    private async Task CargarMasAsync()
    {
        if (Descartado || Ocupado || !HayMas) return;
        CargandoMas = true;
        ErrorMas = null;
        var ct = Vida.Token;
        try
        {
            var pagina = await ProductoService.ListarPaginaAsync(TerminoAplicado, CategoriaAplicada, SiguienteCursor, ct: ct);
            if (!Descartado) Anexar(pagina);
        }
        catch (OperationCanceledException) when (Descartado) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar otra página de productos.");
            ErrorMas = "No pudimos cargar más productos. Puedes reintentar sin perder los que ya aparecen.";
        }
        finally { CargandoMas = false; }
    }

    private Task BuscarAsync() => CargarProductosAsync();

    private async Task LimpiarBusquedaAsync()
    {
        if (Ocupado) return;
        Termino = string.Empty;
        CategoriaId = null;
        await CargarProductosAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Descartado || Inicializando) return;
        Inicializando = true;
        try
        {
            if (Modulo is null)
            {
                var nuevo = await JS.InvokeAsync<IJSObjectReference>("import", "./productos-listado.js");
                if (Descartado) { await nuevo.DisposeAsync(); return; }
                Modulo = nuevo;
                Referencia = DotNetObjectReference.Create(this);
                await Modulo.InvokeVoidAsync("iniciar", ElementoListado, Referencia);
            }
            if (!Descartado) await Modulo.InvokeVoidAsync("actualizar", ElementoListado);
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "La carga automática no está disponible; se conserva el botón de cargar más.");
        }
        finally { Inicializando = false; }
    }

    [JSInvokable]
    public async Task CargarMasDesdeScrollAsync()
    {
        if (Descartado || Ocupado || !HayMas || ErrorMas is not null) return;
        var carga = CargarMasAsync();
        await InvokeAsync(StateHasChanged);
        await carga;
        if (!Descartado) await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Descartado = true;
        Vida.Cancel();
        Vida.Dispose();
        Referencia?.Dispose();
        if (Modulo is null) return;
        try { await Modulo.InvokeVoidAsync("destruir", ElementoListado); await Modulo.DisposeAsync(); }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
    }
}
