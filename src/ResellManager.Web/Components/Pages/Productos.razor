@page "/productos"
@rendermode InteractiveServer
@inject IProductoService ProductoService
@inject ILogger<Productos> Logger

<PageTitle>Productos | ResellManager</PageTitle>

<section class="page-heading" aria-labelledby="titulo-productos">
    <div>
        <p class="eyebrow">Catálogo</p>
        <h1 id="titulo-productos">Productos</h1>
        <p class="page-lead">Administra las definiciones de artículos y sus precios sugeridos de referencia.</p>
    </div>
    <a class="primary-button" href="/productos/nuevo">Nuevo producto</a>
</section>

@if (!string.IsNullOrWhiteSpace(MensajeExito))
{
    <div class="mensaje-exito" role="status">@MensajeExito</div>
}

<form class="search-panel" @onsubmit="BuscarAsync" @onsubmit:preventDefault>
    <div class="search-field">
        <label for="buscar-producto">Buscar producto</label>
        <input id="buscar-producto" type="search" placeholder="Nombre, código interno o código de barras"
               @bind="Termino" @bind:event="oninput" />
    </div>
    <div class="search-actions">
        <button class="primary-button" type="submit" disabled="@Cargando">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Termino) || BusquedaActiva)
        {
            <button class="secondary-button" type="button" disabled="@Cargando" @onclick="LimpiarBusquedaAsync">Limpiar</button>
        }
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="mensaje-error alert-with-action" role="alert">
        <span>@ErrorMessage</span>
        <button class="inline-button" type="button" @onclick="CargarProductosAsync">Reintentar</button>
    </div>
}

@if (Cargando)
{
    <div class="loading-state" role="status" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        Cargando productos...
    </div>
}
else if (string.IsNullOrWhiteSpace(ErrorMessage) && ProductosEncontrados.Count == 0)
{
    <section class="empty-state" aria-labelledby="titulo-sin-productos">
        <span class="empty-state-icon" aria-hidden="true"><NavIcon Name="tag" /></span>
        <h2 id="titulo-sin-productos">@(BusquedaActiva ? "No se encontraron productos" : "Aún no hay productos")</h2>
        <p>@(BusquedaActiva ? "Prueba con otro nombre, código interno o código de barras." : "Registra la primera definición de producto para comenzar.")</p>
        @if (!BusquedaActiva)
        {
            <a class="primary-button" href="/productos/nuevo">Registrar producto</a>
        }
    </section>
}
else if (string.IsNullOrWhiteSpace(ErrorMessage))
{
    <section class="data-panel" aria-labelledby="titulo-listado-productos">
        <div class="data-panel-heading">
            <h2 id="titulo-listado-productos">Listado de productos</h2>
            <span>@ProductosEncontrados.Count @(ProductosEncontrados.Count == 1 ? "producto" : "productos")</span>
        </div>

        <div class="desktop-table">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Código interno</th>
                        <th scope="col">Producto</th>
                        <th scope="col">Categoría</th>
                        <th scope="col" class="numeric-cell">Precio sugerido</th>
                        <th scope="col" class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in ProductosEncontrados)
                    {
                        <tr>
                            <td><span class="code-value">@producto.CodigoInterno</span></td>
                            <td>
                                <strong>@producto.Nombre</strong>
                                @if (!string.IsNullOrWhiteSpace(ProductoPresentacion.DatosBreves(producto)))
                                {
                                    <span class="table-secondary">@ProductoPresentacion.DatosBreves(producto)</span>
                                }
                            </td>
                            <td>@producto.Categoria</td>
                            <td class="numeric-cell"><span class="reference-price">@ProductoPresentacion.PrecioSugerido(producto.PrecioSugerido)</span></td>
                            <td class="actions-cell">
                                <a class="table-action" href="/productos/@producto.Id">Ver detalle</a>
                                <a class="table-action" href="/productos/@producto.Id/editar">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mobile-card-list">
            @foreach (var producto in ProductosEncontrados)
            {
                <article class="entity-card">
                    <div class="entity-card-heading">
                        <div>
                            <span class="code-value">@producto.CodigoInterno</span>
                            <h3>@producto.Nombre</h3>
                            <p class="entity-card-subtitle">@producto.Categoria</p>
                            @if (!string.IsNullOrWhiteSpace(ProductoPresentacion.DatosBreves(producto)))
                            {
                                <p class="entity-card-subtitle">@ProductoPresentacion.DatosBreves(producto)</p>
                            }
                        </div>
                        <span class="reference-price">@ProductoPresentacion.PrecioSugerido(producto.PrecioSugerido)</span>
                    </div>
                    <p class="price-caption">Precio sugerido</p>
                    <div class="entity-card-actions">
                        <a class="secondary-button" href="/productos/@producto.Id">Ver detalle</a>
                        <a class="secondary-button" href="/productos/@producto.Id/editar">Editar</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@code {
    private IReadOnlyList<ProductoDto> ProductosEncontrados { get; set; } = [];
    private string Termino { get; set; } = string.Empty;
    private bool BusquedaActiva { get; set; }
    private bool Cargando { get; set; } = true;
    private string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Mensaje { get; set; }

    private string? MensajeExito => Mensaje switch
    {
        "producto-creado" => "Producto registrado correctamente.",
        "producto-editado" => "Producto actualizado correctamente.",
        _ => null,
    };

    protected override Task OnInitializedAsync() => CargarProductosAsync();

    private async Task CargarProductosAsync()
    {
        Cargando = true;
        ErrorMessage = null;
        BusquedaActiva = false;

        try
        {
            ProductosEncontrados = await ProductoService.ListarAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar el listado de productos.");
            ErrorMessage = "No pudimos cargar los productos. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(Termino))
        {
            await CargarProductosAsync();
            return;
        }

        Cargando = true;
        ErrorMessage = null;
        BusquedaActiva = true;

        try
        {
            ProductosEncontrados = await ProductoService.BuscarAsync(Termino);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible buscar productos.");
            ErrorMessage = "No pudimos realizar la búsqueda. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task LimpiarBusquedaAsync()
    {
        Termino = string.Empty;
        await CargarProductosAsync();
    }
}
