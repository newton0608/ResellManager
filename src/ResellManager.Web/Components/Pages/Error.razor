@page "/Error"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Error | ResellManager</PageTitle>

<section class="auth-card error-card" aria-labelledby="titulo-error">
    <div class="auth-brand">
        <span class="min-w-0">
            <img src="branding/resellmanager-logo-dark.png" alt="ResellManager"
                 class="block h-14 w-56 max-w-full object-cover" width="1536" height="1024" />
            <small>Administración familiar</small>
        </span>
    </div>
    <p class="eyebrow">Error</p>
    <h1 id="titulo-error">Ocurrió un error</h1>
    <p>No fue posible completar la solicitud.</p>
    <a class="primary-button" href="/">Volver al inicio</a>
</section>
