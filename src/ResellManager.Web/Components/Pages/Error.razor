@page "/Error"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Error | ResellManager</PageTitle>

<section class="ui-card grid w-full min-w-0 max-w-md gap-5 p-5 sm:p-8" aria-labelledby="titulo-error">
    <div class="min-w-0 border-0 border-b border-solid border-ui-border pb-5">
        <img src="branding/resellmanager-logo-dark.png" alt="ResellManager"
             class="block h-14 w-56 max-w-full object-cover" width="1536" height="1024" />
        <p class="m-0 mt-2 text-xs text-ui-muted">Administración familiar</p>
    </div>
    <div class="min-w-0 space-y-2">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Error</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink" id="titulo-error">Ocurrió un error</h1>
        <p class="m-0 text-sm leading-6 text-ui-muted">No fue posible completar la solicitud.</p>
    </div>
    <a class="ui-button w-full bg-ui-accent text-white hover:bg-ui-accent-hover" href="/">Volver al inicio</a>
</section>
