@page "/inventario"
@rendermode InteractiveServer
@using ResellManager.Domain.Enums
@inject IInventarioService InventarioService
@inject IConsultaProductoCodigoBarras ConsultaProductos
@inject ILogger<Inventario> Logger
@inject NavigationManager Navigation

<PageTitle>Inventario | ResellManager</PageTitle>

<div class="rm-inventory grid min-w-0 gap-6 pb-4">
    <section class="flex items-start justify-between gap-4" aria-labelledby="titulo-inventario">
        <div class="grid min-w-0 gap-2">
            <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Unidades físicas</p>
            <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-inventario">Inventario</h1>
            <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">Consulta cada ejemplar físico, su estado y su reserva comercial por separado.</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(MensajeExito))
    {
        <div class="rounded-2xl border border-solid border-ui-success/20 bg-ui-success/5 px-4 py-3 text-sm leading-6 text-ui-success" role="status">@MensajeExito</div>
    }

    <section class="ui-card grid min-w-0 gap-3 p-4 sm:p-5" aria-label="Abrir producto por código de barras" aria-busy="@(BuscandoCodigo ? "true" : "false")">
        <div class="grid min-w-0 gap-3 sm:flex sm:items-center sm:justify-between">
            <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink">Abrir producto por código</h2>
            <BarcodeScanner Disabled="@ScannerBloqueado" OnDetected="CodigoEscaneadoAsync" />
        </div>
        @if (BuscandoCodigo)
        {
            <p class="m-0 text-sm leading-6 text-ui-muted" role="status" aria-live="polite">Buscando producto...</p>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorCodigo))
        {
            <p class="m-0 rounded-2xl bg-ui-danger/5 p-3 text-sm leading-6 text-ui-danger [overflow-wrap:anywhere]" role="alert">@ErrorCodigo</p>
        }
    </section>

    <form class="ui-card grid min-w-0 gap-4 p-4 sm:grid-cols-2 sm:p-5 xl:grid-cols-[minmax(0,1fr)_14rem_auto]" @onsubmit="BuscarAsync" @onsubmit:preventDefault>
        <div class="grid min-w-0 gap-2 sm:col-span-2 xl:col-auto [&>label]:text-sm [&>label]:font-semibold">
            <label for="buscar-unidad">Buscar unidad</label>
            <input class="ui-input" id="buscar-unidad" type="search" placeholder="Producto, código de producto o código de unidad"
                   @bind="Termino" @bind:event="oninput" disabled="@Ocupado" />
        </div>
        <div class="grid min-w-0 gap-2 [&>label]:text-sm [&>label]:font-semibold">
            <label for="estado-unidad">Estado físico</label>
            <select class="ui-input" id="estado-unidad" @bind="EstadoFiltro" disabled="@Ocupado">
                <option value="">Todos los estados</option>
                @foreach (var estado in Enum.GetValues<EstadoUnidadInventario>())
                {
                    <option value="@estado">@InventarioPresentacion.Estado(estado)</option>
                }
            </select>
        </div>
        <div class="grid min-w-0 grid-cols-2 items-end gap-2 xl:flex">
            <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="submit" disabled="@Ocupado">Buscar</button>
            @if (FiltrosActivos || BusquedaActiva)
            {
                <button class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" type="button" disabled="@Ocupado" @onclick="LimpiarFiltrosAsync">Limpiar</button>
            }
        </div>
    </form>

    @if (EstadoFiltro.HasValue)
    {
        <div class="ui-card flex min-w-0 flex-wrap items-center justify-between gap-3 p-4 text-sm text-ui-ink" role="status">
            <span>Estado físico: @InventarioPresentacion.Estado(EstadoFiltro.Value)</span>
            <button class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" type="button" disabled="@Ocupado" @onclick="LimpiarFiltrosAsync">Quitar filtro de estado</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger flex min-w-0 flex-wrap items-center justify-between gap-3" role="alert">
            <span class="min-w-0 [overflow-wrap:anywhere]">@ErrorMessage</span>
            <button class="ui-button border-ui-danger/30 bg-white text-ui-danger hover:bg-ui-danger/5" type="button" disabled="@Ocupado" @onclick="RecargarAsync">Reintentar</button>
        </div>
    }

    <fieldset class="m-0 min-w-0 border-0 p-0" disabled="@BuscandoCodigo">
        <RecepcionCompras @ref="Recepcion" OnRecibido="RecargarDespuesDeOperacionAsync" />
    </fieldset>

    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando inventario...
        </div>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage) && Unidades.Count == 0)
    {
        <section class="empty-state ui-card min-w-0 p-6 text-center text-ui-muted sm:p-8" aria-labelledby="titulo-sin-inventario">
            <div class="grid justify-items-center gap-4">
                <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-ui-accent/10 text-ui-accent" aria-hidden="true"><NavIcon Name="boxes" /></span>
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-sin-inventario">@(BusquedaActiva ? "No se encontraron unidades" : "Aún no hay unidades de inventario")</h2>
                <p class="m-0 max-w-md text-sm leading-6 text-ui-muted">@(BusquedaActiva ? "Prueba con otros criterios o limpia los filtros." : "Las unidades físicas aparecerán cuando sean generadas por un flujo de compra que use inventario.")</p>
                @if (!BusquedaActiva)
                {
                    <a class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" href="/compras/nueva">Registrar primera compra</a>
                }
            </div>
        </section>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="grid min-w-0 gap-4" aria-labelledby="titulo-listado-inventario">
            <div class="flex flex-wrap items-center justify-between gap-2 px-1">
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-listado-inventario">Unidades de inventario</h2>
                <span class="text-sm text-ui-muted">@Unidades.Count @(Unidades.Count == 1 ? "unidad" : "unidades")</span>
            </div>
            <ul class="m-0 grid min-w-0 list-none gap-3 p-0" role="list">
                @foreach (var unidad in Unidades)
                {
                    var siguienteEstado = InventarioPresentacion.SiguienteEstadoManual(unidad);
                    <li class="inventory-card ui-card grid min-w-0 gap-4 p-4 sm:p-5 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)_auto]">
                        <div class="grid min-w-0 content-start gap-2">
                            <h3 class="m-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@unidad.Producto</h3>
                            <span class="max-w-full font-mono text-xs leading-5 text-ui-muted [overflow-wrap:anywhere]">@unidad.CodigoInterno</span>
                            <p class="m-0 text-xs leading-5 text-ui-muted [overflow-wrap:anywhere]">Producto @unidad.CodigoProducto</p>
                            <div class="grid justify-items-start gap-1">
                                <span class="text-xs leading-5 text-ui-muted">Estado físico</span>
                                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold leading-5 @InventarioPresentacion.ClaseEstado(unidad.Estado)">@InventarioPresentacion.Estado(unidad.Estado)</span>
                            </div>
                        </div>
                        <dl class="m-0 grid min-w-0 grid-cols-2 content-start gap-3 rounded-2xl bg-ui-canvas p-3 text-sm leading-6 [&_dt]:text-xs [&_dt]:leading-5 [&_dt]:text-ui-muted [&_dd]:m-0 [&_dd]:text-ui-ink [&_dd]:[overflow-wrap:anywhere]">
                            <div class="grid min-w-0 content-start gap-1"><dt>Ingreso</dt><dd>@(unidad.FechaIngreso?.ToString("dd/MM/yyyy") ?? (unidad.Estado == EstadoUnidadInventario.Perdida ? "Sin ingreso" : "Pendiente"))</dd></div>
                            <div class="grid min-w-0 content-start gap-1"><dt>Origen</dt><dd>@InventarioPresentacion.Origen(unidad.OrigenCompra)</dd></div>
                            <div class="grid min-w-0 content-start gap-1"><dt>Costo de unidad</dt><dd class="tabular-nums"><span class="inline-block max-w-full [overflow-wrap:anywhere]">@InventarioPresentacion.Moneda(unidad.Costo)</span></dd></div>
                            <div class="grid min-w-0 justify-items-start gap-1">
                                <dt>Reserva</dt>
                                <dd class="grid min-w-0 justify-items-start gap-1">
                                    @if (InventarioPresentacion.EstaReservada(unidad))
                                    {
                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold leading-5 reservation-badge">Reservada</span>
                                        <a class="inline-flex min-h-12 min-w-0 items-center rounded-xl text-sm font-semibold text-ui-accent no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" href="/pedidos/@unidad.PedidoReservaId">Ver pedido de la reserva</a>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold leading-5 no-reservation-badge">Sin reserva</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                        @if (siguienteEstado.HasValue || InventarioPresentacion.PuedeMarcarPerdida(unidad))
                        {
                            <div class="grid min-w-0 content-start gap-3 sm:flex sm:flex-wrap xl:grid xl:max-w-48">
                                @if (InventarioPresentacion.PuedeMarcarPerdida(unidad))
                                {
                                    <button class="ui-button min-w-0 border-ui-danger/30 bg-white text-ui-danger hover:border-ui-danger hover:bg-ui-danger/5" type="button" disabled="@Ocupado"
                                            @onclick="() => RevisarPerdida(unidad)">Marcar perdida</button>
                                }
                                @if (siguienteEstado.HasValue)
                                {
                                    <button class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" type="button" disabled="@Ocupado"
                                            @onclick="() => RevisarCambioAsync(unidad, siguienteEstado.Value)">
                                        @(UnidadProcesandoId == unidad.Id ? "Procesando..." : InventarioPresentacion.AccionEstado(siguienteEstado.Value))
                                    </button>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (UnidadEntrega is not null)
    {
        <ConfirmacionOperacion Titulo="Confirmar entrega" TextoConfirmar="Confirmar entrega"
            TextoEditar="Cancelar" Ocupado="Ocupado" Error="@ErrorMessage"
            OnEditar="CerrarRevisionInventario" OnConfirmar="ConfirmarInventarioAsync">
            <p class="m-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@UnidadEntrega.Producto · @UnidadEntrega.CodigoInterno</p>
            <p class="m-0 text-sm leading-6 text-ui-muted">La unidad pasará de Vendida a Entregada. Después no podrá cancelarse la venta por el flujo normal.</p>
        </ConfirmacionOperacion>
    }

    @if (UnidadPerdida is not null)
    {
        <div class="rm-inventory-loss">
            <ConfirmacionOperacion Titulo="Marcar unidad perdida" TextoConfirmar="Marcar perdida"
                TextoEditar="Cancelar" Ocupado="Ocupado" Error="@ErrorMessage"
                OnEditar="CerrarPerdida" OnConfirmar="ConfirmarPerdidaAsync">
                <p class="m-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@UnidadPerdida.Producto · @UnidadPerdida.CodigoInterno</p>
                <p class="m-0 text-sm leading-6 text-ui-muted">La unidad quedará Perdida y no podrá recibirse, reservarse ni venderse. Esta acción no puede revertirse en esta versión. La compra y su costo se conservan.</p>
                @if (UnidadPerdida.DetallePedidoReservaId.HasValue)
                {
                    <p class="m-0 rounded-2xl bg-ui-warning/5 p-3 text-sm leading-6 text-ui-warning">Se liberará su reserva. El pedido se conserva, con esa unidad pendiente de reservar; no se cancelará ni cambiará su cantidad.</p>
                }
            </ConfirmacionOperacion>
        </div>
    }
</div>

@code {
    private RecepcionCompras? Recepcion;
    private UnidadInventarioDto? UnidadPerdida { get; set; }
    private void RevisarPerdida(UnidadInventarioDto unidad)
    {
        if (Ocupado || UnidadEntrega is not null || UnidadPerdida is not null || !InventarioPresentacion.PuedeMarcarPerdida(unidad)) return;
        ErrorMessage = null;
        UnidadPerdida = unidad;
    }
    private void CerrarPerdida() { if (!Ocupado) UnidadPerdida = null; }
    private async Task ConfirmarPerdidaAsync()
    {
        if (Ocupado || UnidadPerdida is null) return;
        await CambiarEstadoAsync(UnidadPerdida, EstadoUnidadInventario.Perdida);
        if (ErrorMessage is null) CerrarPerdida();
    }
    private UnidadInventarioDto? UnidadEntrega { get; set; }
    private Task RevisarCambioAsync(UnidadInventarioDto unidad, EstadoUnidadInventario estado)
    {
        if (Ocupado) return Task.CompletedTask;
        if (estado != EstadoUnidadInventario.Entregada) return CambiarEstadoAsync(unidad, estado);
        ErrorMessage = null;
        UnidadEntrega = unidad;
        return Task.CompletedTask;
    }
    private void CerrarRevisionInventario()
    {
        if (Ocupado) return;
        UnidadEntrega = null;
    }
    private async Task ConfirmarInventarioAsync()
    {
        if (Ocupado) return;
        if (UnidadEntrega is not null) await CambiarEstadoAsync(UnidadEntrega, EstadoUnidadInventario.Entregada);
        if (ErrorMessage is null) CerrarRevisionInventario();
    }
    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoConsulta { get; set; }
    private IReadOnlyList<UnidadInventarioDto> Unidades { get; set; } = [];
    private string Termino { get; set; } = string.Empty;
    private EstadoUnidadInventario? EstadoFiltro { get; set; }
    private bool BusquedaActiva { get; set; }
    private bool Cargando { get; set; } = true;
    private int? UnidadProcesandoId { get; set; }
    private string? ErrorMessage { get; set; }
    private string? MensajeExito { get; set; }

    private bool FiltrosActivos => !string.IsNullOrWhiteSpace(Termino) || EstadoFiltro.HasValue;
    private bool Ocupado => Cargando || UnidadProcesandoId.HasValue || BuscandoCodigo;
    private bool ScannerBloqueado => Ocupado || UnidadEntrega is not null || UnidadPerdida is not null;
    private bool BuscandoCodigo { get; set; }
    private string? ErrorCodigo { get; set; }

    private async Task CodigoEscaneadoAsync(string codigo)
    {
        if (ScannerBloqueado) return;
        BuscandoCodigo = true;
        ErrorCodigo = null;
        try
        {
            var producto = await ConsultaProductos.ObtenerPorCodigoBarrasAsync(codigo);
            if (producto is null)
                ErrorCodigo = "No hay ningún producto registrado con este código de barras. Puedes continuar con la búsqueda manual.";
            else
                Navigation.NavigateTo($"/productos/{producto.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible buscar el producto escaneado desde Inventario.");
            ErrorCodigo = "No pudimos consultar el producto. Vuelve a escanear o continúa con la búsqueda manual.";
        }
        finally { BuscandoCodigo = false; }
    }

    protected override Task OnParametersSetAsync()
    {
        EstadoFiltro = Enum.TryParse<EstadoUnidadInventario>(EstadoConsulta, true, out var estado)
            && Enum.IsDefined(estado) ? estado : null;
        return BuscarAsync();
    }

    private async Task CargarInventarioAsync()
    {
        Cargando = true;
        ErrorMessage = null;
        BusquedaActiva = false;

        try
        {
            Unidades = await InventarioService.ListarAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar el listado de inventario.");
            ErrorMessage = "No pudimos cargar el inventario. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task BuscarAsync()
    {
        if (BuscandoCodigo) return;
        if (!FiltrosActivos)
        {
            await CargarInventarioAsync();
            return;
        }

        Cargando = true;
        ErrorMessage = null;
        MensajeExito = null;
        BusquedaActiva = true;

        try
        {
            Unidades = await InventarioService.BuscarAsync(Termino, EstadoFiltro);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible buscar unidades de inventario.");
            ErrorMessage = "No pudimos realizar la búsqueda. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task LimpiarFiltrosAsync()
    {
        if (BuscandoCodigo) return;
        Termino = string.Empty;
        EstadoFiltro = null;
        MensajeExito = null;
        if (!string.IsNullOrWhiteSpace(EstadoConsulta))
        {
            Navigation.NavigateTo("/inventario");
            return;
        }
        await CargarInventarioAsync();
    }

    private Task RecargarAsync() => BusquedaActiva ? BuscarAsync() : CargarInventarioAsync();


    private async Task CambiarEstadoAsync(UnidadInventarioDto unidad, EstadoUnidadInventario estado)
    {
        if (Ocupado || (estado == EstadoUnidadInventario.Perdida
            ? !InventarioPresentacion.PuedeMarcarPerdida(unidad)
            : InventarioPresentacion.SiguienteEstadoManual(unidad) != estado))
            return;

        UnidadProcesandoId = unidad.Id;
        ErrorMessage = null;
        MensajeExito = null;

        try
        {
            var resultado = await InventarioService.CambiarEstadoAsync(unidad.Id, estado);
            if (!resultado.IsSuccess)
            {
                ErrorMessage = resultado.ErrorMessage ?? "No fue posible actualizar la unidad.";
                return;
            }

            MensajeExito = $"La unidad {unidad.CodigoInterno} ahora está {InventarioPresentacion.Estado(estado).ToLowerInvariant()}.";
            if (estado == EstadoUnidadInventario.Perdida && Recepcion is not null)
                await Recepcion.RefrescarAsync();
            await RecargarDespuesDeOperacionAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cambiar el estado de la unidad {UnidadInventarioId}.", unidad.Id);
            ErrorMessage = "No pudimos actualizar la unidad. Intenta nuevamente.";
        }
        finally
        {
            UnidadProcesandoId = null;
        }
    }

    private async Task RecargarDespuesDeOperacionAsync()
    {
        var mensaje = MensajeExito;
        if (BusquedaActiva)
            await BuscarAsync();
        else
            await CargarInventarioAsync();
        MensajeExito = mensaje;
    }

}
