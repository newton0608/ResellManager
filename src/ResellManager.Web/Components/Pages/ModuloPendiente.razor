@page "/pedidos"
@page "/ventas"
@page "/pagos"
@page "/compras"
@page "/proveedores"
@inject NavigationManager Navigation

<PageTitle>@CurrentModule.Name | ResellManager</PageTitle>

<section class="page-heading" aria-labelledby="titulo-modulo">
    <div>
        <p class="eyebrow">Módulo</p>
        <h1 id="titulo-modulo">@CurrentModule.Name</h1>
        <p class="page-lead">@CurrentModule.Description</p>
    </div>
    <span class="status-badge">Pendiente</span>
</section>

<section class="placeholder-card">
    <span class="placeholder-icon" aria-hidden="true">
        <NavIcon Name="@CurrentModule.Icon" />
    </span>
    <div>
        <h2>Este módulo estará disponible próximamente</h2>
        <p>La navegación ya está preparada, pero las pantallas y operaciones de @CurrentModule.Name.ToLowerInvariant() se implementarán en una fase posterior.</p>
        <a class="secondary-button" href="/">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m15 18-6-6 6-6" />
            </svg>
            Volver al inicio
        </a>
    </div>
</section>

@code {
    private static readonly IReadOnlyDictionary<string, ModuleDefinition> Modules =
        new Dictionary<string, ModuleDefinition>(StringComparer.OrdinalIgnoreCase)
        {
            ["pedidos"] = new("Pedidos", "Seguimiento de pedidos y apartados.", "clipboard"),
            ["ventas"] = new("Ventas", "Registro y consulta de ventas.", "cart"),
            ["pagos"] = new("Pagos", "Registro de pagos y abonos de clientes.", "wallet"),
            ["compras"] = new("Compras", "Control de compras y comprobantes.", "bag"),
            ["proveedores"] = new("Proveedores", "Directorio y seguimiento de proveedores.", "truck")
        };

    private ModuleDefinition CurrentModule
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            return Modules.TryGetValue(path, out var module) ? module : Modules["pedidos"];
        }
    }

    private sealed record ModuleDefinition(string Name, string Description, string Icon);
}
