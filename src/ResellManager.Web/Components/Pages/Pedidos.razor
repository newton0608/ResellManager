@page "/pedidos"
@rendermode InteractiveServer
@using ResellManager.Domain.Enums
@inject IPedidoService PedidoService
@inject NavigationManager Navigation
@inject ILogger<Pedidos> Logger

<PageTitle>Pedidos | ResellManager</PageTitle>

<div class="rm-orders grid min-w-0 gap-6 pb-4">
    <section class="flex items-start justify-between gap-4" aria-labelledby="titulo-pedidos">
        <div class="grid min-w-0 gap-2">
            <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Operación comercial</p>
            <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-pedidos">Pedidos</h1>
            <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">Consulta pedidos, apartados y sus reservas sin registrar ventas.</p>
        </div>
        <a class="ui-button shrink-0 bg-ui-accent text-white hover:bg-ui-accent-hover" href="/pedidos/nuevo">
            <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            <span class="sr-only sm:not-sr-only">Nuevo pedido</span>
        </a>
    </section>

    @if (SoloActivos)
    {
        <div class="ui-card flex flex-wrap items-center justify-between gap-3 p-4 text-sm text-ui-ink" role="status">
            <span>Pedidos activos: pendientes y confirmados</span>
            <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="@UrlEstado("")">Quitar filtro de estado</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(MensajeExito))
    {
        <div class="rounded-2xl border border-solid border-ui-success/20 bg-ui-success/5 px-4 py-3 text-sm leading-6 text-ui-success" role="status">@MensajeExito</div>
    }

    <FiltrosHistorial Id="filtros-pedidos" Modelo="Filtros" Placeholder="Buscar por código de pedido" Ocupado="Cargando" OnAplicar="AplicarFiltrosAsync" OnLimpiar="LimpiarFiltrosAsync">
        <div class="grid min-w-0 gap-2 [&>label]:text-sm [&>label]:font-semibold">
            <label for="estado-historial">Estado / entrega</label>
            <select class="ui-input" id="estado-historial" @bind="Filtros.Estado" disabled="@Cargando">
                <option value="">Todos</option>
                <option value="activos">Activos</option>
                <option value="entrega-pendiente">Con entrega pendiente</option>
            </select>
        </div>
    </FiltrosHistorial>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger" role="alert">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <span>@ErrorMessage</span>
                <button class="ui-button border-ui-danger/30 bg-white text-ui-danger hover:bg-ui-danger/5" type="button" disabled="@Cargando" @onclick="CargarAsync">Reintentar</button>
            </div>
        </div>
    }

    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando pedidos...
        </div>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage) && PedidosEncontrados.Count == 0)
    {
        <section class="empty-state ui-card min-w-0 p-6 text-center text-ui-muted sm:p-8" aria-labelledby="titulo-sin-pedidos">
            <div class="grid justify-items-center gap-4">
                <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-ui-accent/10 text-ui-accent" aria-hidden="true"><NavIcon Name="clipboard" /></span>
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-sin-pedidos">@(Filtros.Activo ? "No se encontraron pedidos con estos filtros" : "Aún no hay pedidos")</h2>
                <p class="m-0 max-w-md text-sm leading-6 text-ui-muted">@(SoloActivos ? "Puedes quitar el filtro para consultar el historial completo." : "Crea el primer pedido con un cliente y al menos un producto.")</p>
                <a class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" href="/pedidos/nuevo">Crear pedido</a>
            </div>
        </section>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="grid min-w-0 gap-4" aria-labelledby="titulo-listado-pedidos">
            <div class="flex flex-wrap items-center justify-between gap-2 px-1">
                <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="titulo-listado-pedidos">Listado de pedidos</h2>
                <span class="text-sm text-ui-muted">@PedidosEncontrados.Count @(PedidosEncontrados.Count == 1 ? "pedido" : "pedidos")</span>
            </div>
            @foreach (var grupo in Grupos)
            {
                <section class="grid min-w-0 gap-3" aria-label="@grupo.Titulo">
                    <h3 class="m-0">
                        <button class="ui-button w-full justify-between border-ui-border bg-ui-canvas text-left text-ui-ink hover:bg-white" type="button"
                                aria-expanded="@(Meses.Abierto(grupo.Anio, grupo.Mes) ? "true" : "false")"
                                @onclick="() => Meses.Alternar(grupo.Anio, grupo.Mes)">
                            <span>@grupo.Titulo</span>
                            <svg class="size-5 shrink-0 @(Meses.Abierto(grupo.Anio, grupo.Mes) ?"rotate-90" : "")" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
                        </button>
                    </h3>
                    <div class="grid min-w-0 gap-3" role="list">
                        @foreach (var pedido in Meses.Abierto(grupo.Anio, grupo.Mes) ? grupo.Registros : Array.Empty<PedidoDto>())
                        {
                            <article class="ui-card min-w-0" role="listitem">
                                <a class="grid min-w-0 grid-cols-[minmax(0,1fr)_1.25rem] items-start gap-x-3 gap-y-2 rounded-3xl p-4 text-ui-ink no-underline transition-colors duration-150 hover:bg-ui-accent/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent motion-reduce:transition-none sm:grid-cols-[minmax(0,1fr)_auto_1.25rem] sm:items-center sm:gap-x-5 sm:p-5"
                                   href="/pedidos/@pedido.Id" aria-label="@($"Ver pedido {pedido.CodigoInterno}")">
                                    <div class="grid min-w-0 gap-1">
                                        <h3 class="m-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@pedido.Cliente</h3>
                                        <span class="max-w-full font-mono text-xs leading-5 break-all text-ui-muted">@pedido.CodigoInterno</span>
                                        <span class="text-sm leading-6 text-ui-muted">@pedido.Fecha.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="col-start-1 min-w-0 sm:col-start-2 sm:row-start-1 sm:text-right">
                                        <p class="m-0 text-lg font-semibold leading-6 tracking-tight text-ui-ink tabular-nums [overflow-wrap:anywhere]">@PedidoPresentacion.Moneda(PedidoPresentacion.Total(pedido))</p>
                                        <span class="text-xs leading-5 text-ui-muted">Total · @pedido.Detalles.Count @(pedido.Detalles.Count == 1 ? "detalle" : "detalles")</span>
                                    </div>
                                    <svg class="col-start-2 row-start-1 row-span-2 mt-1 size-5 text-ui-muted sm:col-start-3 sm:row-span-1 sm:mt-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7" /></svg>
                                </a>
                                <div class="flex flex-wrap items-center justify-between gap-2 border-0 border-t border-solid border-ui-border px-4 py-3 text-xs leading-5 text-ui-muted sm:px-5">
                                    <span class="min-w-0 [overflow-wrap:anywhere]">Tipo: @PedidoPresentacion.Tipo(pedido.TipoPedido) · Canal: @PedidoPresentacion.Canal(pedido.CanalVenta)</span>
                                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold leading-5 @PedidoPresentacion.ClaseEstado(pedido.Estado)">@PedidoPresentacion.Estado(pedido.Estado)</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </section>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarConsulta { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] public string? DesdeConsulta { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] public string? HastaConsulta { get; set; }
    private FiltroHistorialModelo Filtros { get; } = new();
    private MesesDesplegables Meses { get; } = new();
    private string? ErrorConsulta { get; set; }
    private IReadOnlyList<GrupoMensual<PedidoDto>> Grupos { get; set; } = [];

    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoConsulta { get; set; }
    private string UrlEstado(string estado) => new FiltroHistorialModelo { Termino = Filtros.Termino, Desde = Filtros.Desde, Hasta = Filtros.Hasta, Estado = estado }.Url("/pedidos");
    private bool SoloActivos => string.Equals(EstadoConsulta, "activos", StringComparison.OrdinalIgnoreCase);
    private IReadOnlyList<PedidoDto> PedidosEncontrados { get; set; } = [];
    private bool Cargando { get; set; } = true;
    private string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Mensaje { get; set; }

    private string? MensajeExito => Mensaje switch
    {
        "pedido-creado" => "Pedido creado correctamente.",
        _ => null,
    };

    protected override Task OnParametersSetAsync()
    {
        ErrorConsulta = Filtros.Cargar(BuscarConsulta, DesdeConsulta, HastaConsulta, EstadoConsulta);
        if (Filtros.Estado is not ("" or "activos" or "entrega-pendiente")) ErrorConsulta = "El filtro de pedidos no es válido. Selecciona una opción disponible.";
        return CargarAsync();
    }

    private Task AplicarFiltrosAsync()
    {
        if (Cargando) return Task.CompletedTask;
        ErrorConsulta = Filtros.Validar();
        if (ErrorConsulta is not null) { ErrorMessage = ErrorConsulta; return Task.CompletedTask; }
        return Filtros.NavegarAsync(Navigation, "/pedidos", CargarAsync);
    }
    private Task LimpiarFiltrosAsync() { Filtros.Limpiar(); return AplicarFiltrosAsync(); }

    private async Task CargarAsync()
    {
        ErrorMessage = ErrorConsulta ?? Filtros.Validar();
        if (ErrorMessage is not null) { PedidosEncontrados = []; Grupos = []; Cargando = false; return; }
        Cargando = true;
        try
        {
            PedidosEncontrados = await PedidoService.ListarAsync(filtro: Filtros.ToInput(), soloActivos: Filtros.Estado == "activos", conEntregaPendiente: Filtros.Estado == "entrega-pendiente");
            Grupos = HistorialMensual.Agrupar(PedidosEncontrados, x => x.Fecha, x => x.Id);
            Meses.Reiniciar(Grupos);

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar el listado de pedidos.");
            ErrorMessage = "No pudimos cargar los pedidos. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }
}
