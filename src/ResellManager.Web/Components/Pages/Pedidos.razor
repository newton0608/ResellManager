@page "/pedidos"
@rendermode InteractiveServer
@using ResellManager.Domain.Enums
@inject IPedidoService PedidoService
@inject NavigationManager Navigation
@inject ILogger<Pedidos> Logger

<PageTitle>Pedidos | ResellManager</PageTitle>

<section class="page-heading" aria-labelledby="titulo-pedidos">
    <div>
        <p class="eyebrow">Operación comercial</p>
        <h1 id="titulo-pedidos">Pedidos</h1>
        <p class="page-lead">Consulta pedidos, apartados y sus reservas sin registrar ventas.</p>
    </div>
    <div class="heading-actions">
        <a class="primary-button" href="/pedidos/nuevo">Nuevo pedido</a>
    </div>
</section>

@if (SoloActivos)
{
    <div class="origin-guidance context-filter" role="status">
        <span>Pedidos activos: pendientes y confirmados</span>
        <a class="inline-button" href="@UrlEstado("")">Quitar filtro de estado</a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(MensajeExito))
{
    <div class="mensaje-exito" role="status">@MensajeExito</div>
}

<FiltrosHistorial Id="filtros-pedidos" Modelo="Filtros" Placeholder="Buscar por código de pedido" Ocupado="Cargando" OnAplicar="AplicarFiltrosAsync" OnLimpiar="LimpiarFiltrosAsync">
    <div class="form-field">
        <label for="estado-historial">Estado / entrega</label>
        <select id="estado-historial" @bind="Filtros.Estado" disabled="@Cargando">
            <option value="">Todos</option>
            <option value="activos">Activos</option>
            <option value="entrega-pendiente">Con entrega pendiente</option>
        </select>
    </div>
</FiltrosHistorial>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="mensaje-error alert-with-action" role="alert">
        <span>@ErrorMessage</span>
        <button class="inline-button" type="button" disabled="@Cargando" @onclick="CargarAsync">Reintentar</button>
    </div>
}

@if (Cargando)
{
    <div class="loading-state" role="status" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        Cargando pedidos...
    </div>
}
else if (string.IsNullOrWhiteSpace(ErrorMessage) && PedidosEncontrados.Count == 0)
{
    <section class="empty-state" aria-labelledby="titulo-sin-pedidos">
        <span class="empty-state-icon" aria-hidden="true"><NavIcon Name="clipboard" /></span>
        <h2 id="titulo-sin-pedidos">@(Filtros.Activo ? "No se encontraron pedidos con estos filtros" : "Aún no hay pedidos")</h2>
        <p>@(SoloActivos ? "Puedes quitar el filtro para consultar el historial completo." : "Crea el primer pedido con un cliente y al menos un producto.")</p>
        <a class="primary-button" href="/pedidos/nuevo">Crear pedido</a>
    </section>
}
else if (string.IsNullOrWhiteSpace(ErrorMessage))
{
    <section class="data-panel" aria-labelledby="titulo-listado-pedidos">
        <div class="data-panel-heading">
            <h2 id="titulo-listado-pedidos">Listado de pedidos</h2>
            <span>@PedidosEncontrados.Count @(PedidosEncontrados.Count == 1 ? "pedido" : "pedidos")</span>
        </div>

        <div class="desktop-table">
            <table class="data-table order-table">
                <thead>
                    <tr>
                        <th scope="col">Código / fecha</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Canal</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="numeric-cell">Detalles</th>
                        <th scope="col" class="numeric-cell">Total estimado</th>
                        <th scope="col" class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                @foreach (var grupo in Grupos)
                {
                <tbody>
                    <tr class="history-month-row"><th scope="rowgroup" colspan="8">@grupo.Titulo</th></tr>
                    @foreach (var pedido in grupo.Registros)
                    {
                        <tr>
                            <td>
                                <strong class="code-value">@pedido.CodigoInterno</strong>
                                <span class="table-secondary">@pedido.Fecha.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td>@pedido.Cliente</td>
                            <td>@PedidoPresentacion.Tipo(pedido.TipoPedido)</td>
                            <td>@PedidoPresentacion.Canal(pedido.CanalVenta)</td>
                            <td><span class="order-status @PedidoPresentacion.ClaseEstado(pedido.Estado)">@PedidoPresentacion.Estado(pedido.Estado)</span></td>
                            <td class="numeric-cell">@pedido.Detalles.Count</td>
                            <td class="numeric-cell"><strong>@PedidoPresentacion.Moneda(PedidoPresentacion.Total(pedido))</strong></td>
                            <td class="actions-cell"><a class="table-action" href="/pedidos/@pedido.Id">Ver</a></td>
                        </tr>
                    }
                </tbody>
                }
            </table>
        </div>

        <div class="mobile-card-list">
            @foreach (var grupo in Grupos)
            {
                <h3 class="history-month-title">@grupo.Titulo</h3>
            @foreach (var pedido in grupo.Registros)
            {
                <article class="entity-card order-card">
                    <div class="entity-card-heading">
                        <div>
                            <h3 class="code-value">@pedido.CodigoInterno</h3>
                            <span class="table-secondary">@pedido.Fecha.ToString("dd/MM/yyyy") · @pedido.Cliente</span>
                        </div>
                        <span class="order-status @PedidoPresentacion.ClaseEstado(pedido.Estado)">@PedidoPresentacion.Estado(pedido.Estado)</span>
                    </div>
                    <dl class="inventory-card-details">
                        <div><dt>Tipo</dt><dd>@PedidoPresentacion.Tipo(pedido.TipoPedido)</dd></div>
                        <div><dt>Canal</dt><dd>@PedidoPresentacion.Canal(pedido.CanalVenta)</dd></div>
                        <div><dt>Detalles</dt><dd>@pedido.Detalles.Count</dd></div>
                        <div><dt>Total estimado</dt><dd><strong>@PedidoPresentacion.Moneda(PedidoPresentacion.Total(pedido))</strong></dd></div>
                    </dl>
                    <div class="entity-card-actions">
                        <a class="secondary-button" href="/pedidos/@pedido.Id">Ver pedido</a>
                    </div>
                </article>
            }
            }
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "buscar")] public string? BuscarConsulta { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] public string? DesdeConsulta { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] public string? HastaConsulta { get; set; }
    private FiltroHistorialModelo Filtros { get; } = new();
    private string? ErrorConsulta { get; set; }
    private IReadOnlyList<GrupoMensual<PedidoDto>> Grupos { get; set; } = [];

    [SupplyParameterFromQuery(Name = "estado")]
    public string? EstadoConsulta { get; set; }
    private string UrlEstado(string estado) => new FiltroHistorialModelo { Termino = Filtros.Termino, Desde = Filtros.Desde, Hasta = Filtros.Hasta, Estado = estado }.Url("/pedidos");
    private bool SoloActivos => string.Equals(EstadoConsulta, "activos", StringComparison.OrdinalIgnoreCase);
    private IReadOnlyList<PedidoDto> PedidosEncontrados { get; set; } = [];
    private bool Cargando { get; set; } = true;
    private string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Mensaje { get; set; }

    private string? MensajeExito => Mensaje switch
    {
        "pedido-creado" => "Pedido creado correctamente.",
        _ => null,
    };

    protected override Task OnParametersSetAsync()
    {
        ErrorConsulta = Filtros.Cargar(BuscarConsulta, DesdeConsulta, HastaConsulta, EstadoConsulta);
        if (Filtros.Estado is not ("" or "activos" or "entrega-pendiente")) ErrorConsulta = "El filtro de pedidos no es válido. Selecciona una opción disponible.";
        return CargarAsync();
    }

    private Task AplicarFiltrosAsync()
    {
        if (Cargando) return Task.CompletedTask;
        ErrorConsulta = Filtros.Validar();
        if (ErrorConsulta is not null) { ErrorMessage = ErrorConsulta; return Task.CompletedTask; }
        return Filtros.NavegarAsync(Navigation, "/pedidos", CargarAsync);
    }
    private Task LimpiarFiltrosAsync() { Filtros.Limpiar(); return AplicarFiltrosAsync(); }

    private async Task CargarAsync()
    {
        ErrorMessage = ErrorConsulta ?? Filtros.Validar();
        if (ErrorMessage is not null) { PedidosEncontrados = []; Grupos = []; Cargando = false; return; }
        Cargando = true;
        try
        {
            PedidosEncontrados = await PedidoService.ListarAsync(filtro: Filtros.ToInput(), soloActivos: Filtros.Estado == "activos", conEntregaPendiente: Filtros.Estado == "entrega-pendiente");
            Grupos = HistorialMensual.Agrupar(PedidosEncontrados, x => x.Fecha, x => x.Id);

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar el listado de pedidos.");
            ErrorMessage = "No pudimos cargar los pedidos. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }
}
