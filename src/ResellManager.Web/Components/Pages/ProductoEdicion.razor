@page "/productos/nuevo"
@page "/productos/{Id:int}/editar"
@rendermode InteractiveServer
@inject IProductoService ProductoService
@inject IProductoConImagenService ProductoConImagenService
@inject IAltaProductoAsistidaService AltaProductoAsistidaService
@inject ICategoriaService CategoriaService
@inject NavigationManager Navigation
@inject ILogger<ProductoEdicion> Logger

<PageTitle>@(EsEdicion ? "Editar producto" : "Nuevo producto") | ResellManager</PageTitle>

<div class="mx-auto min-w-0 max-w-5xl space-y-6 pb-[env(safe-area-inset-bottom)]">
    <section class="space-y-2" aria-labelledby="titulo-formulario-producto">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Productos</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink sm:text-4xl" id="titulo-formulario-producto">@(EsEdicion ? "Editar producto" : "Nuevo producto")</h1>
        <p class="m-0 max-w-2xl text-sm leading-6 text-ui-muted">@(EsEdicion ? "Actualiza la definición y el precio sugerido del producto." : "Registra una definición de producto; las unidades físicas se administran por separado.")</p>
    </section>

    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="size-5 shrink-0 rounded-full border-[3px] border-solid border-ui-accent/20 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
            Cargando producto y categorías...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorCarga))
    {
        <section class="ui-card space-y-4 border-ui-danger/20 p-5 sm:p-6" role="alert">
            <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink">No fue posible abrir el formulario</h2>
            <p class="m-0 text-sm leading-6 text-ui-muted">@ErrorCarga</p>
            <div class="grid gap-3 sm:flex sm:flex-wrap">
                <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="button" @onclick="CargarAsync">Reintentar</button>
                <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/productos">Volver a productos</a>
            </div>
        </section>
    }
    else
    {
        <section class="rm-product-form min-w-0" aria-label="Formulario de producto">
            <ProductoForm Modelo="Modelo"
                          Categorias="CategoriasDisponibles"
                          Guardando="Guardando"
                          ProductoId="Id"
                          LookupHabilitado="@(!EsEdicion)"
                          ErrorMessage="@ErrorGuardado"
                          OnGuardar="GuardarAsync"
                          CancelarHref="@CancelarHref" />
        </section>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ProductoFormModel Modelo { get; set; } = new();
    private IReadOnlyList<CategoriaDto> CategoriasDisponibles { get; set; } = [];
    private bool Guardando { get; set; }
    private bool Cargando { get; set; } = true;
    private string? ErrorCarga { get; set; }
    private string? ErrorGuardado { get; set; }
    private int? IdCargado { get; set; }

    private bool EsEdicion => Id.HasValue;
    private string CancelarHref => Id > 0 ? $"/productos/{Id}" : "/productos";

    protected override async Task OnParametersSetAsync()
    {
        if (!EsEdicion || IdCargado != Id)
        {
            await CargarAsync();
        }
    }

    private async Task CargarAsync()
    {
        Cargando = true;
        ErrorCarga = null;
        ErrorGuardado = null;

        try
        {
            CategoriasDisponibles = await CategoriaService.ListarAsync();

            if (EsEdicion)
            {
                var resultado = await ProductoService.ObtenerPorIdAsync(Id!.Value);
                if (!resultado.IsSuccess || resultado.Value is null)
                {
                    ErrorCarga = resultado.ErrorMessage ?? "Producto no encontrado.";
                    return;
                }

                Modelo = ProductoFormModel.FromDto(resultado.Value);
                var galeria = await ProductoConImagenService.ObtenerGaleriaAsync(Id.Value);
                if (!galeria.IsSuccess || galeria.Value is null)
                {
                    ErrorCarga = galeria.ErrorMessage ?? "No fue posible cargar las fotografías del producto.";
                    return;
                }
                Modelo.CargarGaleria(galeria.Value);
            }
            else
            {
                Modelo = new ProductoFormModel();
            }

            IdCargado = Id;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No fue posible cargar el formulario del producto {ProductoId}.",
                EsEdicion ? Id : null);
            ErrorCarga = "Ocurrió un problema inesperado al cargar el formulario. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task GuardarAsync(ProductoFormModel modelo)
    {
        if (Guardando || Id is <= 0 || ErrorCarga is not null)
        {
            return;
        }

        if (!CategoriasDisponibles.Any(categoria => categoria.Id == modelo.CategoriaId))
        {
            ErrorGuardado = "Selecciona una categoría válida antes de guardar.";
            return;
        }

        Guardando = true;
        ErrorGuardado = null;

        try
        {
            await using var imagen = modelo.GaleriaCargada || modelo.Galeria.Count > 0
                ? null
                : modelo.ImagenContenido is not null
                    ? new MemoryStream(modelo.ImagenContenido, writable: false)
                    : modelo.ImagenArchivo?.OpenReadStream(
                        ResellManager.Infrastructure.Storage.AlmacenamientoImagenesProductoLocal.TamanoMaximoBytes);
            using var nuevas = new ProductoGaleriaArchivos(modelo);
            string? avisoImagen = null;
            ServiceResult<ProductoDto> resultado;
            if (EsEdicion)
            {
                resultado = modelo.GaleriaCargada
                    ? await ProductoConImagenService.EditarGaleriaAsync(
                        Id!.Value, modelo.ToInput(), modelo.ToGaleriaEdicion(), nuevas.Imagenes)
                    : imagen is null && !modelo.EliminarImagenPrincipal
                        ? await ProductoService.EditarAsync(Id!.Value, modelo.ToInput())
                        : await ProductoConImagenService.EditarAsync(
                            Id!.Value, modelo.ToInput(), imagen, modelo.EliminarImagenPrincipal);
            }
            else if (modelo.Galeria.Count > 0)
            {
                resultado = await ProductoConImagenService.CrearGaleriaAsync(
                    modelo.ToInput(), nuevas.Imagenes, modelo.ToGaleriaEdicion().PortadaIndice, validarCodigoBarras: true);
            }
            else
            {
                var alta = await AltaProductoAsistidaService.CrearAsistidoAsync(
                    modelo.ToInput(), imagen, modelo.ImagenExternaUrl);
                resultado = alta.Producto;
                avisoImagen = alta.AvisoImagen;
            }

            if (!resultado.IsSuccess)
            {
                ErrorGuardado = resultado.ErrorMessage ?? "No fue posible guardar el producto.";
                return;
            }

            Navigation.NavigateTo(
                EsEdicion
                    ? "/productos?mensaje=producto-editado"
                    : avisoImagen is null ? "/productos?mensaje=producto-creado"
                    : "/productos?mensaje=producto-creado-sin-imagen-externa");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No fue posible {Operacion} el producto {ProductoId}.",
                EsEdicion ? "editar" : "crear",
                EsEdicion ? Id : null);
            ErrorGuardado = "Ocurrió un problema inesperado al guardar. Intenta nuevamente.";
        }
        finally
        {
            Guardando = false;
        }
    }
}
