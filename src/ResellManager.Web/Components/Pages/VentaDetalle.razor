@page "/ventas/{Id:int}"
@rendermode InteractiveServer
@using ResellManager.Domain.Enums
@inject IVentaService VentaService
@inject IJSRuntime JS
@inject ILogger<VentaDetalle> Logger

<PageTitle>@(Venta is null ? "Venta" : Venta.CodigoInterno) | ResellManager</PageTitle>

<div class="rm-sales grid min-w-0 gap-6 pb-4">
    @if (Cargando)
    {
        <div class="ui-card flex items-center gap-3 p-6 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            Cargando venta...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorCarga))
    {
        <section class="ui-card grid min-w-0 gap-4 p-6 text-center sm:p-8" role="alert">
            <h1 class="m-0 text-2xl font-semibold tracking-tight text-ui-ink">No fue posible cargar la venta</h1>
            <p class="m-0 text-sm leading-6 text-ui-muted">@ErrorCarga</p>
            <div class="grid gap-3 sm:flex sm:justify-center">
                <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="button" @onclick="CargarAsync">Reintentar</button>
                <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/ventas">Volver a ventas</a>
            </div>
        </section>
    }
    else if (Venta is not null)
    {
        <section class="grid min-w-0 gap-4 xl:grid-cols-[minmax(0,1fr)_auto] xl:items-start" aria-labelledby="titulo-venta">
            <div class="grid min-w-0 gap-2">
                <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Detalle de venta</p>
                <h1 id="titulo-venta" class="m-0 text-2xl font-bold tracking-tight break-all text-ui-ink sm:text-3xl">@Venta.CodigoInterno</h1>
                <p class="m-0 text-sm leading-6 text-ui-muted">Consulta los productos vendidos y el pedido de origen.</p>
            </div>
            <div class="grid min-w-0 gap-3 sm:flex sm:flex-wrap">
                <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/pagos?cliente=@Venta.ClienteId">Pagos del cliente</a>
                @if (Venta.Estado == EstadoVenta.Registrada)
                {
                    <button class="ui-button min-w-0 border-ui-danger/30 bg-white text-ui-danger hover:border-ui-danger hover:bg-ui-danger/5" type="button" disabled="@Cancelando" @onclick="CancelarAsync">
                        @(Cancelando ? "Cancelando..." : "Cancelar venta")
                    </button>
                }
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(MensajeExito))
        {
            <div class="mensaje-exito" role="status">@MensajeExito</div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorOperacion))
        {
            <div class="mensaje-error" role="alert">@ErrorOperacion</div>
        }

        <section class="grid min-w-0 gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumen de venta">
            <article class="ui-card grid min-w-0 content-start gap-2 p-4 sm:p-5">
                <span class="text-xs font-medium leading-5 text-ui-muted">Cliente</span>
                <strong class="text-base leading-6 [overflow-wrap:anywhere]">@Venta.Cliente</strong>
                <a class="inline-flex min-h-12 items-center rounded-xl text-sm font-medium text-ui-accent no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" href="/clientes/@Venta.ClienteId">Ver cliente</a>
            </article>
            <article class="ui-card grid min-w-0 content-start gap-2 p-4 sm:p-5">
                <span class="text-xs font-medium leading-5 text-ui-muted">Pedido</span>
                <a class="inline-flex min-h-12 items-center rounded-xl text-sm font-medium text-ui-accent no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" href="/pedidos/@Venta.PedidoId">Ver pedido</a>
            </article>
            <article class="ui-card grid min-w-0 content-start justify-items-start gap-2 p-4 sm:p-5">
                <span class="text-xs font-medium leading-5 text-ui-muted">Fecha</span>
                <strong class="text-base leading-6">@Venta.Fecha.ToString("dd/MM/yyyy")</strong>
                <span class="status-badge @VentaPresentacion.ClaseEstado(Venta.Estado)">@VentaPresentacion.Estado(Venta.Estado)</span>
            </article>
            <article class="ui-card grid min-w-0 content-start gap-2 p-4 sm:p-5">
                <span class="text-xs font-medium leading-5 text-ui-muted">Total</span>
                <strong class="text-2xl font-semibold leading-8 tracking-tight text-ui-ink tabular-nums [overflow-wrap:anywhere]">@VentaPresentacion.Moneda(Venta.Total)</strong>
                <span class="text-xs leading-5 text-ui-muted">Utilidad: @VentaPresentacion.Moneda(VentaPresentacion.UtilidadTotal(Venta))</span>
            </article>
        </section>

        @if (!string.IsNullOrWhiteSpace(Venta.Observaciones))
        {
            <section class="ui-card grid min-w-0 gap-2 p-4 sm:p-5" aria-labelledby="titulo-observaciones-venta">
                <h2 class="m-0 text-base font-semibold text-ui-ink" id="titulo-observaciones-venta">Observaciones</h2>
                <p class="m-0 text-sm leading-6 text-ui-muted [overflow-wrap:anywhere]">@Venta.Observaciones</p>
            </section>
        }

        <section class="grid min-w-0 gap-4" aria-labelledby="titulo-detalles-venta">
            <div class="flex flex-wrap items-center justify-between gap-2 px-1">
                <h2 id="titulo-detalles-venta" class="m-0 text-xl font-semibold tracking-tight text-ui-ink">Detalles</h2>
                <span class="text-sm text-ui-muted">@Venta.Detalles.Count @(Venta.Detalles.Count == 1 ? "artículo" : "artículos")</span>
            </div>
            <!-- One responsive list serves both desktop and mobile presentations. -->
            <ul class="sale-desktop-table sale-mobile-cards m-0 grid min-w-0 list-none gap-3 p-0" role="list">
                @foreach (var detalle in Venta.Detalles)
                {
                    <li class="ui-card grid min-w-0 gap-4 p-4 sm:p-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
                        <div class="grid min-w-0 content-start gap-1">
                            <h3 class="m-0 text-base font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@detalle.Producto</h3>
                            <p class="m-0 text-sm leading-6 text-ui-muted [overflow-wrap:anywhere]">
                                Unidad: <span class="font-mono text-xs">@(detalle.CodigoUnidad ?? "No aplica · catálogo")</span>
                            </p>
                        </div>
                        <dl class="m-0 grid min-w-0 grid-cols-2 gap-3 rounded-2xl bg-ui-canvas p-3 text-sm leading-6 sm:grid-cols-3 [&_dt]:text-xs [&_dt]:leading-5 [&_dt]:text-ui-muted [&_dd]:m-0 [&_dd]:font-medium [&_dd]:text-ui-ink [&_dd]:tabular-nums [&_dd]:[overflow-wrap:anywhere]">
                            <div class="grid min-w-0 gap-1"><dt>Costo unitario</dt><dd>@VentaPresentacion.Moneda(detalle.CostoUnitario)</dd></div>
                            <div class="grid min-w-0 gap-1"><dt>Precio final</dt><dd>@VentaPresentacion.Moneda(detalle.PrecioFinal)</dd></div>
                            <div class="grid min-w-0 gap-1"><dt>Utilidad</dt><dd>@VentaPresentacion.Moneda(VentaPresentacion.Utilidad(detalle))</dd></div>
                        </dl>
                        <dl class="m-0 grid min-w-0 gap-1 border-0 border-t border-solid border-ui-border pt-3 text-sm leading-6 xl:col-span-2">
                            <dt class="text-xs leading-5 text-ui-muted">Observaciones</dt>
                            <dd class="m-0 text-ui-ink [overflow-wrap:anywhere]">@(detalle.Observaciones ?? "—")</dd>
                        </dl>
                    </li>
                }
            </ul>
            <section class="ui-card grid min-w-0 gap-4 p-4 sm:p-5" aria-label="Totales">
                <h3 class="m-0 text-base font-semibold text-ui-ink">Totales</h3>
                <dl class="m-0 grid min-w-0 gap-4 sm:grid-cols-2 [&_dt]:text-xs [&_dt]:leading-5 [&_dt]:text-ui-muted [&_dd]:m-0 [&_dd]:font-semibold [&_dd]:text-ui-ink [&_dd]:tabular-nums [&_dd]:[overflow-wrap:anywhere]">
                    <div class="grid min-w-0 gap-1"><dt>Total</dt><dd class="text-2xl leading-8 tracking-tight">@VentaPresentacion.Moneda(Venta.Total)</dd></div>
                    <div class="grid min-w-0 gap-1"><dt>Utilidad</dt><dd class="text-2xl leading-8 tracking-tight">@VentaPresentacion.Moneda(VentaPresentacion.UtilidadTotal(Venta))</dd></div>
                </dl>
            </section>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private VentaDto? Venta { get; set; }
    private bool Cargando { get; set; } = true;
    private bool Cancelando { get; set; }
    private string? ErrorCarga { get; set; }
    private string? ErrorOperacion { get; set; }
    private string? MensajeExito { get; set; }

    protected override Task OnParametersSetAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        Cargando = true;
        ErrorCarga = null;
        try
        {
            var resultado = await VentaService.ObtenerPorIdAsync(Id);
            if (!resultado.IsSuccess || resultado.Value is null)
            {
                ErrorCarga = resultado.ErrorMessage ?? "Venta no encontrada.";
                return;
            }
            Venta = resultado.Value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar la venta {VentaId}.", Id);
            ErrorCarga = "Ocurrió un problema inesperado al cargar la venta. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CancelarAsync()
    {
        if (Cancelando || Venta?.Estado != EstadoVenta.Registrada)
            return;

        Cancelando = true;
        ErrorOperacion = null;
        MensajeExito = null;
        try
        {
            var confirmado = await JS.InvokeAsync<bool>(
                "confirm",
                "Cancelar esta venta puede liberar sus unidades y devolver el pedido a pendiente. Los pagos existentes pueden impedir la operación. ¿Deseas continuar?");
            if (!confirmado)
                return;

            var resultado = await VentaService.CancelarAsync(Id);
            if (!resultado.IsSuccess)
            {
                ErrorOperacion = resultado.ErrorMessage ?? "No fue posible cancelar la venta.";
                return;
            }

            await CargarAsync();
            MensajeExito = "Venta cancelada correctamente. El pedido volvió a pendiente; las reservas no se restauraron.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cancelar la venta {VentaId}.", Id);
            ErrorOperacion = "No pudimos cancelar la venta. Intenta nuevamente.";
        }
        finally
        {
            Cancelando = false;
        }
    }
}
