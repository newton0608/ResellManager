        <a class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" href="/">Volver al inicio</a>
        <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/pedidos">Ver pedidos</a>
    </div>
</section>
