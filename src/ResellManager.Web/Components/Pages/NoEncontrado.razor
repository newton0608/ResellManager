@page "/no-encontrado"

<PageTitle>Página no encontrada | ResellManager</PageTitle>

<section class="ui-card mx-auto grid min-w-0 max-w-2xl gap-5 p-5 text-center sm:p-8" aria-labelledby="titulo-no-encontrado">
    <div class="min-w-0 space-y-2">
        <p class="m-0 text-xs font-semibold tracking-wide text-ui-muted uppercase">Navegación</p>
        <h1 class="m-0 text-3xl font-bold tracking-tight text-ui-ink" id="titulo-no-encontrado">Página no encontrada</h1>
