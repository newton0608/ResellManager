@inject ICategoriaService CategoriaService
@inject IProductoService ProductoService
@inject IProductoConImagenService ProductoConImagenService
@inject IAltaProductoAsistidaService AltaProductoAsistidaService
@inject ILogger<ProductoAltaPanel> Logger

<section class="ui-card rm-product-form mb-4 min-w-0 max-w-full space-y-5 border-ui-accent/20 bg-ui-accent/5 p-4 sm:p-6" aria-labelledby="titulo-alta-producto">
    <div class="space-y-2">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" id="titulo-alta-producto" tabindex="-1" @ref="Titulo">Registrar producto para esta compra</h2>
        <p class="m-0 text-sm leading-6 text-ui-muted">La compra permanece abierta. Al guardar se seleccionará este producto en el detalle de origen.</p>
    </div>
    @if (Cargando)
    {
        <p class="m-0 text-sm leading-6 text-ui-muted" role="status">Cargando categorías...</p>
    }
    else
    {
        <ProductoForm Modelo="Modelo" Categorias="Categorias" Guardando="Guardando"
                      ErrorMessage="@Error" OnGuardar="GuardarAsync" OnCancelar="CancelarAsync"
                      LookupHabilitado="LookupHabilitado" BuscarAlIniciar="@(LookupHabilitado && CodigoInicial is not null)"
                      CategoriasEnOtraPestana="true" />
    }
    <button class="ui-button w-full border-ui-control bg-white text-ui-ink hover:bg-ui-canvas sm:w-auto" type="button" disabled="@(Guardando || Cargando)"
            @onclick="CargarCategoriasAsync">Actualizar categorías</button>
</section>

@code {
    [Parameter] public EventCallback<ProductoDto> OnCreado { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }
    [Parameter] public EventCallback<string?> OnAvisoImagen { get; set; }
    [Parameter] public string? CodigoInicial { get; set; }
    [Parameter] public bool LookupHabilitado { get; set; }
    private ProductoFormModel Modelo { get; } = new();
    private IReadOnlyList<CategoriaDto> Categorias { get; set; } = [];
    private bool Cargando { get; set; }
    private bool Guardando { get; set; }
    private string? Error { get; set; }
    private ElementReference Titulo;

    protected override Task OnInitializedAsync()
    {
        Modelo.CodigoBarras = CodigoInicial;
        return CargarCategoriasAsync();
    }
    private Task CancelarAsync() => Guardando ? Task.CompletedTask : OnCancelar.InvokeAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Titulo.FocusAsync();
    }

    private async Task CargarCategoriasAsync()
    {
        if (Cargando || Guardando) return;
        Cargando = true;
        Error = null;
        try { Categorias = await CategoriaService.ListarAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar categorías para alta de producto en compra.");
            Error = "No pudimos cargar las categorías. Actualízalas para reintentar.";
        }
        finally { Cargando = false; }
    }

    private async Task GuardarAsync(ProductoFormModel modelo)
    {
        if (Guardando || Cargando) return;
        if (!Categorias.Any(x => x.Id == modelo.CategoriaId))
        {
            Error = "Selecciona una categoría válida antes de guardar.";
            return;
        }
        Guardando = true;
        Error = null;
        try
        {
            await using var imagen = modelo.ImagenContenido is not null
                ? new MemoryStream(modelo.ImagenContenido, writable: false)
                : modelo.ImagenArchivo?.OpenReadStream(
                    ResellManager.Infrastructure.Storage.AlmacenamientoImagenesProductoLocal.TamanoMaximoBytes);
            string? avisoImagen = null;
            ServiceResult<ProductoDto> resultado;
            if (LookupHabilitado)
            {
                var alta = await AltaProductoAsistidaService.CrearAsistidoAsync(modelo.ToInput(), imagen, modelo.ImagenExternaUrl);
                resultado = alta.Producto;
                avisoImagen = alta.AvisoImagen;
            }
            else resultado = imagen is null
                ? await ProductoService.CrearAsync(modelo.ToInput())
                : await ProductoConImagenService.CrearAsync(modelo.ToInput(), imagen);
            if (!resultado.IsSuccess || resultado.Value is null)
            {
                Error = resultado.ErrorMessage ?? "No fue posible registrar el producto.";
                return;
            }
            await OnAvisoImagen.InvokeAsync(avisoImagen);
            await OnCreado.InvokeAsync(resultado.Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible crear el producto desde la compra.");
            Error = "No pudimos guardar el producto. Intenta nuevamente.";
        }
        finally { Guardando = false; }
    }
}
