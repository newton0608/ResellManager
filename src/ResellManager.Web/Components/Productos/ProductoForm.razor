<EditForm Model="Modelo" OnValidSubmit="GuardarAsync" class="entity-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mensaje-error" role="alert">@ErrorMessage</div>
    }

    @if (Categorias.Count == 0)
    {
        <div class="catalog-warning" role="status">
            <div>
                <strong>No hay categorías disponibles.</strong>
                <p>Crea una categoría antes de registrar un producto.</p>
            </div>
            <a class="secondary-button" href="/categorias"
               target="@(CategoriasEnOtraPestana ? "_blank" : null)" rel="@(CategoriasEnOtraPestana ? "noopener" : null)">Ir a categorías</a>
            @if (CategoriasEnOtraPestana)
            {
                <p>Se abrirá otra pestaña. Conserva esta compra abierta y después actualiza las categorías.</p>
            }
        </div>
    }

    <ValidationSummary class="validation-summary" role="alert" />

    <div class="form-grid">
        <div class="form-field">
            <label for="producto-codigo-barras">Código de barras</label>
            <div class="barcode-input-row">
                <InputText disabled="@Guardando" aria-describedby="producto-codigo-barras-validacion" id="producto-codigo-barras" @bind-Value="Modelo.CodigoBarras" inputmode="numeric" autocomplete="off" />
                <BarcodeScanner Disabled="@Guardando" OnDetected="CodigoEscaneado" />
            </div>
            <div id="producto-codigo-barras-validacion"><ValidationMessage For="() => Modelo.CodigoBarras" /></div>
        </div>

        <div class="form-field form-field-wide">
            <label for="producto-nombre">Nombre <span aria-hidden="true">*</span></label>
            <InputText disabled="@Guardando" aria-describedby="producto-nombre-validacion" aria-required="true" id="producto-nombre" @bind-Value="Modelo.Nombre" autocomplete="off" />
            <div id="producto-nombre-validacion"><ValidationMessage For="() => Modelo.Nombre" /></div>
        </div>

        <div class="form-field form-field-wide">
            <label for="producto-descripcion">Descripción</label>
            <InputTextArea disabled="@Guardando" aria-describedby="producto-descripcion-validacion" id="producto-descripcion" @bind-Value="Modelo.Descripcion" rows="3" />
            <div id="producto-descripcion-validacion"><ValidationMessage For="() => Modelo.Descripcion" /></div>
        </div>

        <div class="form-field">
            <label for="producto-marca">Marca</label>
            <InputText disabled="@Guardando" aria-describedby="producto-marca-validacion" id="producto-marca" @bind-Value="Modelo.Marca" autocomplete="off" />
            <div id="producto-marca-validacion"><ValidationMessage For="() => Modelo.Marca" /></div>
        </div>

        <div class="form-field">
            <label for="producto-modelo">Modelo</label>
            <InputText disabled="@Guardando" aria-describedby="producto-modelo-validacion" id="producto-modelo" @bind-Value="Modelo.Modelo" autocomplete="off" />
            <div id="producto-modelo-validacion"><ValidationMessage For="() => Modelo.Modelo" /></div>
        </div>

        <div class="form-field">
            <label for="producto-color">Color</label>
            <InputText disabled="@Guardando" aria-describedby="producto-color-validacion" id="producto-color" @bind-Value="Modelo.Color" autocomplete="off" />
            <div id="producto-color-validacion"><ValidationMessage For="() => Modelo.Color" /></div>
        </div>

        <div class="form-field">
            <label for="producto-talla">Talla</label>
            <InputText disabled="@Guardando" aria-describedby="producto-talla-validacion" id="producto-talla" @bind-Value="Modelo.Talla" autocomplete="off" />
            <div id="producto-talla-validacion"><ValidationMessage For="() => Modelo.Talla" /></div>
        </div>

        <div class="form-field">
            <label for="producto-precio-sugerido">Precio sugerido <span aria-hidden="true">*</span></label>
            <InputNumber inputmode="decimal" data-select-once="true" disabled="@Guardando" aria-describedby="producto-precio-sugerido-validacion" aria-required="true" id="producto-precio-sugerido" @bind-Value="Modelo.PrecioSugerido" min="0" step="0.01" />
            <div id="producto-precio-sugerido-validacion"><ValidationMessage For="() => Modelo.PrecioSugerido" /></div>
            <p class="field-help">Valor de referencia; el precio final se define al vender.</p>
        </div>

        <div class="form-field">
            <label for="producto-categoria">Categoría <span aria-hidden="true">*</span></label>
            <InputSelect aria-describedby="producto-categoria-validacion" aria-required="true" id="producto-categoria" @bind-Value="Modelo.CategoriaId" disabled="@(Guardando || Categorias.Count == 0)">
                <option value="0">Selecciona una categoría</option>
                @foreach (var categoria in Categorias)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </InputSelect>
            <div id="producto-categoria-validacion"><ValidationMessage For="() => Modelo.CategoriaId" /></div>
        </div>
        <div class="form-field">
            <label for="producto-volumen">Volumen</label>
            <div class="product-measure-row">
                <input id="producto-volumen" type="number" inputmode="decimal" min="0" step="any"
                       disabled="@(Guardando || Modelo.Peso.HasValue)" aria-describedby="producto-volumen-validacion producto-medidas-ayuda"
                       @bind="Modelo.Volumen" @bind:event="oninput" />
                <select aria-label="Unidad de volumen" disabled="@(Guardando || Modelo.Peso.HasValue)"
                        @bind="Modelo.VolumenUnidad">
                    <option value="@UnidadVolumen.Ml">ml</option>
                    <option value="@UnidadVolumen.L">L</option>
                </select>
            </div>
            <div id="producto-volumen-validacion"><ValidationMessage For="() => Modelo.Volumen" /></div>
        </div>

        <div class="form-field">
            <label for="producto-peso">Peso</label>
            <div class="product-measure-row">
                <input id="producto-peso" type="number" inputmode="decimal" min="0" step="any"
                       disabled="@(Guardando || Modelo.Volumen.HasValue)" aria-describedby="producto-peso-validacion producto-medidas-ayuda"
                       @bind="Modelo.Peso" @bind:event="oninput" />
                <select aria-label="Unidad de peso" disabled="@(Guardando || Modelo.Volumen.HasValue)"
                        @bind="Modelo.PesoUnidad">
                    <option value="@UnidadPeso.G">g</option>
                    <option value="@UnidadPeso.Kg">kg</option>
                    <option value="@UnidadPeso.Lb">lb</option>
                </select>
            </div>
            <div id="producto-peso-validacion"><ValidationMessage For="() => Modelo.Peso" /></div>
        </div>

        <p id="producto-medidas-ayuda" class="field-help form-field-wide">Indica volumen o peso, nunca ambos. Deja la medida vacía para habilitar la otra.</p>

        <div class="form-field form-field-wide">
            <label for="producto-presentacion">Presentación</label>
            <InputText disabled="@Guardando" aria-describedby="producto-presentacion-validacion" id="producto-presentacion"
                       @bind-Value="Modelo.Presentacion" maxlength="100" autocomplete="off" />
            <div id="producto-presentacion-validacion"><ValidationMessage For="() => Modelo.Presentacion" /></div>
        </div>
    </div>

    <p class="required-note"><span aria-hidden="true">*</span> Campos obligatorios</p>

    <div class="form-actions">
        <button class="primary-button" type="submit" disabled="@(!PuedeGuardar)">
            @(Guardando ? "Guardando..." : "Guardar producto")
        </button>
        @if (OnCancelar.HasDelegate)
        {
            <button class="secondary-button" type="button" disabled="@Guardando" @onclick="OnCancelar">Cancelar</button>
        }
        else
        {
            <a class="secondary-button" href="@CancelarHref">Cancelar</a>
        }
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public ProductoFormModel Modelo { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<CategoriaDto> Categorias { get; set; } = [];

    [Parameter]
    public bool Guardando { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ProductoFormModel> OnGuardar { get; set; }

    [Parameter]
    public string CancelarHref { get; set; } = "/productos";

    [Parameter] public EventCallback OnCancelar { get; set; }
    [Parameter] public bool CategoriasEnOtraPestana { get; set; }

    private bool PuedeGuardar => !Guardando && Categorias.Count > 0;

    private Task GuardarAsync() => OnGuardar.InvokeAsync(Modelo);
    private void CodigoEscaneado(string codigo) => Modelo.CodigoBarras = codigo;
}
