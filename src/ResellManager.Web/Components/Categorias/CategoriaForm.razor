<EditForm Model="Modelo" OnValidSubmit="GuardarAsync" class="entity-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mensaje-error" role="alert">@ErrorMessage</div>
    }

    <ValidationSummary class="validation-summary" role="alert" />

    <div class="form-grid">
        <div class="form-field form-field-wide">
            <label for="categoria-nombre">Nombre <span aria-hidden="true">*</span></label>
            <InputText disabled="@Guardando" aria-describedby="categoria-nombre-validacion" aria-required="true" id="categoria-nombre" @bind-Value="Modelo.Nombre" autocomplete="off" />
            <div id="categoria-nombre-validacion"><ValidationMessage For="() => Modelo.Nombre" /></div>
        </div>

        <div class="form-field form-field-wide">
            <label for="categoria-observaciones">Observaciones</label>
            <InputTextArea disabled="@Guardando" aria-describedby="categoria-observaciones-validacion" id="categoria-observaciones" @bind-Value="Modelo.Observaciones" rows="4" />
            <div id="categoria-observaciones-validacion"><ValidationMessage For="() => Modelo.Observaciones" /></div>
        </div>
    </div>

    <p class="required-note"><span aria-hidden="true">*</span> Campos obligatorios</p>

    <div class="form-actions">
        <button class="primary-button" type="submit" disabled="@Guardando">
            @(Guardando ? "Guardando..." : "Guardar categoría")
        </button>
        <a class="secondary-button" href="/categorias">Cancelar</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public CategoriaFormModel Modelo { get; set; } = null!;

    [Parameter]
    public bool Guardando { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CategoriaFormModel> OnGuardar { get; set; }

    private Task GuardarAsync() => OnGuardar.InvokeAsync(Modelo);
}
