<div class="rm-category-form min-w-0">
    <EditForm Model="Modelo" OnValidSubmit="GuardarAsync" class="entity-form grid min-w-0 gap-6">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger" role="alert">@ErrorMessage</div>
        }

        <ValidationSummary class="rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger empty:hidden [&_ul]:m-0 [&_ul]:pl-5" role="alert" />

        <div class="grid min-w-0 gap-5">
            <div class="grid min-w-0 gap-2">
                <label class="text-sm font-medium" for="categoria-nombre">Nombre <span aria-hidden="true">*</span></label>
                <InputText class="ui-input" disabled="@Guardando" aria-describedby="categoria-nombre-validacion" aria-required="true" id="categoria-nombre" @bind-Value="Modelo.Nombre" autocomplete="off" />
                <div class="empty:hidden" id="categoria-nombre-validacion"><ValidationMessage For="() => Modelo.Nombre" /></div>
            </div>

            <div class="grid min-w-0 gap-2">
                <label class="text-sm font-medium" for="categoria-observaciones">Observaciones</label>
                <InputTextArea class="ui-input min-h-28 resize-y" disabled="@Guardando" aria-describedby="categoria-observaciones-validacion" id="categoria-observaciones" @bind-Value="Modelo.Observaciones" rows="4" />
                <div class="empty:hidden" id="categoria-observaciones-validacion"><ValidationMessage For="() => Modelo.Observaciones" /></div>
            </div>
        </div>

        <p class="m-0 text-xs leading-5 text-ui-muted"><span aria-hidden="true">*</span> Campos obligatorios</p>

        <div class="grid min-w-0 gap-2 border-0 border-t border-solid border-ui-border pt-5 sm:flex">
            <button class="ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="submit" disabled="@Guardando">
                @(Guardando ? "Guardando..." : "Guardar categoría")
            </button>
            <a class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" href="/categorias">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired]
    public CategoriaFormModel Modelo { get; set; } = null!;

    [Parameter]
    public bool Guardando { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CategoriaFormModel> OnGuardar { get; set; }

    private Task GuardarAsync() => OnGuardar.InvokeAsync(Modelo);
}
