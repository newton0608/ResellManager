@inject IServiceScopeFactory Scopes

<div class="grid min-w-0 items-start gap-4 xl:grid-cols-2">
    <ActividadMensual T="VentaDto" ClienteId="ClienteId" Titulo="Ventas" Vacio="No hay ventas registradas para este cliente." Consultar="VentasAsync">
        <Registro Context="venta">
            <article class="grid min-w-0 gap-3 rounded-2xl border border-solid border-ui-border p-4">
                <div class="flex min-w-0 flex-wrap items-start justify-between gap-2">
                    <div class="min-w-0">
                        <a class="inline-flex min-h-12 max-w-full items-center rounded-xl text-sm font-semibold text-ui-accent no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" href="/ventas/@venta.Id"><span class="inline-block max-w-full font-mono break-all">@venta.CodigoInterno</span></a>
                        <time class="block text-xs leading-5 text-ui-muted" datetime="@venta.Fecha.ToString("yyyy-MM-dd")">@venta.Fecha.ToString("dd/MM/yyyy")</time>
                    </div>
                    <span class="status-badge @VentaPresentacion.ClaseEstado(venta.Estado)">@VentaPresentacion.Estado(venta.Estado)</span>
                </div>
                <p class="m-0 text-xl font-semibold tracking-tight text-ui-ink tabular-nums [overflow-wrap:anywhere]">@ClientePresentacion.Moneda(venta.Total)</p>
                @if (!string.IsNullOrWhiteSpace(venta.Observaciones))
                {
                    <p class="m-0 text-sm leading-6 text-ui-muted [overflow-wrap:anywhere]">@venta.Observaciones</p>
                }
                <ul class="m-0 grid min-w-0 list-none gap-3 border-0 border-t border-solid border-ui-border pt-3 pl-0" role="list">
                    @foreach (var detalle in venta.Detalles)
                    {
                        <li class="grid min-w-0 gap-1 text-sm leading-6 sm:flex sm:items-baseline sm:justify-between sm:gap-3">
                            <span class="min-w-0 text-ui-muted [overflow-wrap:anywhere]">@detalle.Producto@(string.IsNullOrWhiteSpace(detalle.CodigoUnidad) ? "" : $" · {detalle.CodigoUnidad}")</span>
                            <strong class="text-ui-ink tabular-nums [overflow-wrap:anywhere] sm:shrink-0">@ClientePresentacion.Moneda(detalle.PrecioFinal)</strong>
                        </li>
                    }
                </ul>
            </article>
        </Registro>
    </ActividadMensual>
    <ActividadMensual T="PagoDto" ClienteId="ClienteId" Titulo="Pagos y abonos" Vacio="No hay pagos o abonos registrados para este cliente." Consultar="PagosAsync">
        <Registro Context="pago">
            <article class="grid min-w-0 gap-3 rounded-2xl border border-solid border-ui-border p-4">
                <div class="flex min-w-0 flex-wrap items-start justify-between gap-2">
                    <div class="min-w-0">
                        <strong class="block text-sm font-semibold leading-6 text-ui-ink">Pago recibido</strong>
                        <time class="block text-xs leading-5 text-ui-muted" datetime="@pago.Fecha.ToString("yyyy-MM-dd")">@pago.Fecha.ToString("dd/MM/yyyy")</time>
                    </div>
                    <span class="status-badge status-badge-payment">@PagoPresentacion.Metodo(pago.MetodoPago)</span>
                </div>
                <p class="m-0 text-xl font-semibold tracking-tight text-ui-accent tabular-nums [overflow-wrap:anywhere]">@ClientePresentacion.Moneda(pago.Monto)</p>
                @if (!string.IsNullOrWhiteSpace(pago.Referencia))
                {
                    <p class="m-0 text-sm leading-6 text-ui-muted [overflow-wrap:anywhere]"><span class="font-medium">Referencia:</span> @pago.Referencia</p>
                }
                @if (!string.IsNullOrWhiteSpace(pago.Observaciones))
                {
                    <p class="m-0 text-sm leading-6 text-ui-muted [overflow-wrap:anywhere]">@pago.Observaciones</p>
                }
            </article>
        </Registro>
    </ActividadMensual>
</div>

@code {
    [Parameter] public int ClienteId { get; set; }
    private async Task<PaginaMes<VentaDto>> VentasAsync(int cliente, DateOnly? mes)
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IActividadClienteService>().VentasAsync(cliente, mes);
    }
    private async Task<PaginaMes<PagoDto>> PagosAsync(int cliente, DateOnly? mes)
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IActividadClienteService>().PagosAsync(cliente, mes);
    }
}
