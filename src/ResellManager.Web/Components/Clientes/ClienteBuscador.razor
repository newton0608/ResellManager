@inject IServiceScopeFactory ScopeFactory

<div class="rm-client-picker min-w-0">
    <BuscadorEntidad TItem="ClienteDto" Id="@Id" Etiqueta="Cliente"
                     Placeholder="Buscar por nombre completo o teléfono"
                     SinResultados="No se encontraron clientes. Puedes registrar uno desde Clientes."
                     Seleccionado="Seleccionado" TextoSeleccionado="@(Seleccionado is null ? null : ClientePresentacion.NombreCompleto(Seleccionado))"
                     Deshabilitado="Deshabilitado" Buscar="BuscarAsync" OnSeleccionado="OnSeleccionado">
        <Resultado Context="cliente">
            <strong class="min-w-0 text-sm font-semibold leading-6 text-ui-ink [overflow-wrap:anywhere]">@ClientePresentacion.NombreCompleto(cliente)</strong>
            <span class="text-sm leading-5 text-ui-muted [overflow-wrap:anywhere]">@cliente.Telefono</span>
        </Resultado>
    </BuscadorEntidad>
</div>

@code {
    [Parameter] public string Id { get; set; } = "pago-cliente";
    [Parameter] public ClienteDto? Seleccionado { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public EventCallback<ClienteDto?> OnSeleccionado { get; set; }

    private async Task<IReadOnlyList<ClienteDto>> BuscarAsync(string termino, CancellationToken ct)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        return await scope.ServiceProvider.GetRequiredService<IClienteService>().BuscarAsync(termino, ct, 12);
    }
}
