<form class="history-filter-form" @onsubmit="OnAplicar" @onsubmit:preventDefault aria-label="Filtrar historial">
    @if (MostrarBusqueda)
    {
        <div class="form-field history-search">
            <label for="@(Id + "-buscar")">Buscar</label>
            <input id="@(Id + "-buscar")" type="search" placeholder="@Placeholder" @bind="Modelo.Termino" disabled="@Ocupado" />
        </div>
    }
    @ChildContent
    <div class="form-field">
        <label for="@(Id + "-desde")">Desde</label>
        <input id="@(Id + "-desde")" type="date" @bind="Modelo.Desde" disabled="@Ocupado" />
    </div>
    <div class="form-field">
        <label for="@(Id + "-hasta")">Hasta</label>
        <input id="@(Id + "-hasta")" type="date" @bind="Modelo.Hasta" disabled="@Ocupado" />
    </div>
    <div class="search-actions">
        <button class="primary-button" type="submit" disabled="@Ocupado">Aplicar</button>
        <button class="secondary-button" type="button" disabled="@Ocupado" @onclick="OnLimpiar">Limpiar</button>
    </div>
</form>

@code {
    [Parameter, EditorRequired] public FiltroHistorialModelo Modelo { get; set; } = default!;
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "Buscar por código";
    [Parameter] public bool MostrarBusqueda { get; set; } = true;
    [Parameter] public bool Ocupado { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnAplicar { get; set; }
    [Parameter] public EventCallback OnLimpiar { get; set; }
}
