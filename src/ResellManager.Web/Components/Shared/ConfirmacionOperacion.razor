@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog class="operation-review ui-card box-border m-auto min-w-0 w-[min(38rem,calc(100%_-_2rem))] max-w-[calc(100%_-_2rem)] max-h-[calc(100dvh_-_2rem)] overflow-y-auto p-5 text-ui-ink shadow-ui-sheet backdrop:bg-ui-ink/40 sm:p-6"
        @ref="Dialogo" aria-labelledby="@TituloId"
        aria-busy="@Bloqueado.ToString().ToLowerInvariant()" data-ocupado="@Bloqueado.ToString().ToLowerInvariant()">
    <h2 class="m-0 mb-4 text-xl font-semibold tracking-tight text-ui-ink [overflow-wrap:anywhere]" id="@TituloId">@Titulo</h2>
    <div class="operation-review-content grid min-w-0 gap-3 text-sm leading-6 [overflow-wrap:anywhere]">@ChildContent</div>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="mensaje-error m-0 mt-4 rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger [overflow-wrap:anywhere]" role="alert">@Error</p>
    }
    <div class="mt-5 grid min-w-0 grid-cols-1 gap-3 sm:grid-cols-2">
        <button class="ui-button border-ui-control bg-white text-ui-ink hover:bg-ui-canvas" type="button" disabled="@Bloqueado" @onclick="EditarAsync">@TextoEditar</button>
        <button class="rm-operation-confirm ui-button bg-ui-accent text-white hover:bg-ui-accent-hover" type="button" disabled="@Bloqueado" @onclick="ConfirmarAsync">
            @(Bloqueado ? "Procesando..." : TextoConfirmar)
        </button>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string TextoEditar { get; set; } = "Editar";
    [Parameter] public string TextoConfirmar { get; set; } = "Confirmar";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Ocupado { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnEditar { get; set; }
    [Parameter] public EventCallback OnConfirmar { get; set; }
    private bool Enviando;
    private bool Bloqueado => Ocupado || Enviando;
    private string TituloId { get; } = "revision-" + Guid.NewGuid().ToString("N");
    private ElementReference Dialogo;
    private IJSObjectReference? Modulo;
    private DotNetObjectReference<ConfirmacionOperacion>? Referencia;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./operation-review.js");
        Referencia = DotNetObjectReference.Create(this);
        await Modulo.InvokeVoidAsync("abrir", Dialogo, Referencia);
    }

    private async Task ConfirmarAsync()
    {
        if (Bloqueado) return;
        Enviando = true;
        try { await OnConfirmar.InvokeAsync(); }
        finally { Enviando = false; }
    }

    private Task EditarAsync() => Bloqueado ? Task.CompletedTask : OnEditar.InvokeAsync();

    [JSInvokable]
    public Task CancelarDesdeTeclado() => EditarAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Modulo is not null)
            {
                await Modulo.InvokeVoidAsync("cerrar", Dialogo);
                await Modulo.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        finally { Referencia?.Dispose(); }
    }
}
