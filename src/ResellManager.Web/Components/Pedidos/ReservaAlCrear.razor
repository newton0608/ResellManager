@inject IServiceScopeFactory Scopes
@inject ILogger<ReservaAlCrear> Logger
<section class="ui-card mt-5 grid min-w-0 max-w-full gap-4 p-4 sm:p-5" aria-label="Reserva opcional">
    @if (Error is not null)
    {
        <p class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger" role="alert">@Error</p>
        <button type="button" class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:border-ui-ink hover:bg-ui-canvas" disabled="@(Deshabilitado || Cargando)" @onclick="CargarAsync">Reintentar consulta</button>
    }
    @if (Cargando) { <p class="m-0 text-sm leading-6 text-ui-muted" role="status">Consultando unidades para reservar...</p> }
    else if (!Aceptada)
    {
        <p class="m-0 text-sm leading-6 text-ui-muted">Hay @Opciones.Count unidades compatibles sin reserva. Puedes reservar mercancía comprada, en tránsito o disponible.</p>
        <div class="grid min-w-0 gap-3 sm:grid-cols-2">
            <button type="button" class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:border-ui-ink hover:bg-ui-canvas" disabled="@(Deshabilitado || Opciones.Count == 0)" @onclick="AceptarAsync">Reservar para este pedido</button>
            <button type="button" class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:border-ui-ink hover:bg-ui-canvas" disabled="@Deshabilitado" @onclick="Continuar">Continuar sin reservar</button>
        </div>
    }
    else
    {
        <div class="grid min-w-0 gap-2">
            <label class="text-sm font-medium text-ui-ink" for="@Id">Unidad para reservar</label>
            <select class="ui-input" id="@Id" value="" disabled="@(Deshabilitado || Seleccionadas.Count >= Cantidad || Opciones.Count == 0)" @onchange="Elegir">
                <option value="">Selecciona una unidad</option>
                @foreach (var unidad in Opciones)
                {
                    <option value="@unidad.Id">@unidad.CodigoInterno · @InventarioPresentacion.Estado(unidad.Estado) · @VentaPresentacion.Moneda(unidad.Costo)</option>
                }
            </select>
        </div>
        <p class="m-0 text-sm leading-6 text-ui-muted">Selecciona hasta @Cantidad unidades. No se reservarán hasta confirmar el pedido.</p>
        <ul class="m-0 grid min-w-0 list-none gap-3 p-0">
            @foreach (var unidad in Seleccionadas)
            {
                <li class="grid min-w-0 gap-3 rounded-2xl border border-solid border-ui-border bg-ui-canvas p-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                    <span class="min-w-0 text-sm font-medium leading-6 text-ui-ink [overflow-wrap:anywhere]">@unidad.CodigoInterno · @InventarioPresentacion.Estado(unidad.Estado) · <span class="inline-block max-w-full [overflow-wrap:anywhere]">@VentaPresentacion.Moneda(unidad.Costo)</span></span>
                    <button type="button" class="ui-button min-w-0 border-ui-danger/30 bg-white text-ui-danger hover:border-ui-danger hover:bg-ui-danger/5" disabled="@Deshabilitado" @onclick="() => Quitar(unidad)">Quitar</button>
                </li>
            }
        </ul>
        @if (Seleccionadas.Count > Cantidad) { <p class="mensaje-error rounded-2xl border border-solid border-ui-danger/20 bg-ui-danger/5 px-4 py-3 text-sm leading-6 text-ui-danger" role="alert">Quita unidades: la selección supera la cantidad del detalle.</p> }
        <div class="grid min-w-0 gap-3 sm:grid-cols-2">
            <button type="button" class="ui-button min-w-0 border-ui-control bg-white text-ui-ink hover:border-ui-ink hover:bg-ui-canvas" disabled="@Deshabilitado" @onclick="Continuar">Continuar sin reservar</button>
        </div>
    }
</section>
@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public int ProductoId { get; set; }
    [Parameter] public int Cantidad { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public List<UnidadInventarioDto> Seleccionadas { get; set; } = [];
    [Parameter] public IReadOnlyCollection<int> OtrasUnidades { get; set; } = [];
    private IReadOnlyList<UnidadInventarioDto> Unidades = [];
    private IReadOnlyList<UnidadInventarioDto> Opciones => Unidades.Where(x => !OtrasUnidades.Contains(x.Id) && !Seleccionadas.Any(s => s.Id == x.Id)).ToArray();
    private string? Error;
    private int Cargado;
    private bool Aceptada;
    private bool Cargando;
    protected override async Task OnParametersSetAsync()
    {
        if (Cargado == ProductoId) return;
        Cargado = ProductoId;
        Aceptada = Seleccionadas.Count > 0;
        await CargarAsync();
    }
    private async Task CargarAsync()
    {
        Cargando = true; Error = null;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            Unidades = await scope.ServiceProvider.GetRequiredService<ISeleccionOperativaService>().ListarReservablesAsync(ProductoId);
        }
        catch (Exception ex) { Logger.LogError(ex, "No se pudo consultar disponibilidad para reserva."); Error = "No pudimos consultar las unidades. Puedes continuar sin reserva o volver a intentarlo."; }
        finally { Cargando = false; }
    }
    private async Task AceptarAsync()
    {
        if (Deshabilitado || Cargando) return;
        await CargarAsync();
        if (Error is not null || Deshabilitado) return;
        Aceptada = true;
        if (Opciones.Count == 1) Agregar(Opciones[0]);
    }
    private void Elegir(ChangeEventArgs evento)
    {
        if (int.TryParse(evento.Value?.ToString(), out var id)) Agregar(Opciones.FirstOrDefault(x => x.Id == id));
    }
    private void Agregar(UnidadInventarioDto? unidad)
    {
        if (Deshabilitado || unidad is null || Seleccionadas.Count >= Cantidad || !Opciones.Any(x => x.Id == unidad.Id)) return;
        Seleccionadas.Add(unidad);
    }
    private void Quitar(UnidadInventarioDto unidad) { if (!Deshabilitado) Seleccionadas.Remove(unidad); }
    private void Continuar() { if (!Deshabilitado) { Seleccionadas.Clear(); Aceptada = false; } }
}
