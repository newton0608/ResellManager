@using ResellManager.Domain.Enums
@inject IPedidoService PedidoService
@inject IVentaService VentaService
@inject IInventarioService InventarioService
@inject IClienteService ClienteService
@inject IProductoService ProductoService
@inject ISeleccionOperativaService SeleccionService
@inject NavigationManager Navigation
@inject ILogger<VentaDirectaForm> Logger

@if (Cargando)
{
    <div class="loading-state" role="status" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        Cargando clientes e inventario elegible...
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorCarga))
{
    <section class="error-state" role="alert">
        <h2>No fue posible preparar la venta directa</h2>
        <p>@ErrorCarga</p>
        <div class="form-actions">
            <button class="primary-button" type="button" @onclick="CargarAsync">Reintentar</button>
            <a class="secondary-button" href="/ventas">Volver a ventas</a>
        </div>
    </section>
}
else
{
    <section class="direct-sale-intro" aria-labelledby="titulo-venta-directa">
        <div>
            <p class="eyebrow">Venta presencial</p>
            <h2 id="titulo-venta-directa">Venta directa con pedido automático</h2>
            <p>Se creará primero un pedido <strong>Venta directa</strong> y después la venta. No existen ventas sin pedido.</p>
        </div>
        <span class="status-badge status-badge-neutral">Sin reserva intermedia</span>
    </section>

        <EditForm Model="Modelo" OnValidSubmit="RevisarVentaDirectaAsync" class="entity-form direct-sale-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            @if (!string.IsNullOrWhiteSpace(ErrorGuardado))
            {
                @if (PedidoAutomaticoCreado is null)
                {
                    <div class="mensaje-error" role="alert">@ErrorGuardado</div>
                }
                else
                {
                    <section class="direct-sale-partial-warning" role="alert">
                        <div>
                            <h3>El pedido existe, pero la venta no se registró</h3>
                            <p>@ErrorGuardado</p>
                            <p>El pedido permanece pendiente. Puedes reintentar aquí, o abrir el pedido para revisarlo o cancelarlo.</p>
                        </div>
                        <a class="secondary-button" href="/pedidos/@PedidoAutomaticoCreado.Id">Ver pedido @PedidoAutomaticoCreado.CodigoInterno</a>
                    </section>
                }
            }

            <section class="form-panel" aria-label="Datos generales de la venta directa">
                <div class="form-grid">
                    <div class="form-field">
                        <ClienteBuscador Id="venta-directa-cliente" Seleccionado="ClienteSeleccionado"
                            Deshabilitado="@(Registrando || RevisandoVenta || PedidoAutomaticoCreado is not null)" OnSeleccionado="ElegirCliente" />
                        <ValidationMessage id="venta-directa-cliente-error" For="() => Modelo.ClienteId" />
                    </div>
                    <div class="form-field">
                        <label for="venta-directa-fecha">Fecha <span aria-hidden="true">*</span></label>
                        <InputDate id="venta-directa-fecha" @bind-Value="Modelo.Fecha" disabled="@(Registrando || PedidoAutomaticoCreado is not null)" />
                    </div>
                    <div class="form-field form-field-wide">
                        <label for="venta-directa-observaciones">Observaciones</label>
                        <InputTextArea id="venta-directa-observaciones"
                                       @bind-Value="Modelo.Observaciones"
                                       rows="3" maxlength="500" aria-describedby="venta-directa-observaciones-error"
                                       disabled="@(Registrando || PedidoAutomaticoCreado is not null)" />
                        <ValidationMessage id="venta-directa-observaciones-error" For="() => Modelo.Observaciones" />
                    </div>
                </div>
            </section>

            <section class="form-panel" aria-label="Buscar y agregar artículos">
                <UnidadBuscador @key="RevisionBuscador" Id="directa-unidad" Excluir="@Unidades.Select(x => x.Unidad.Id).ToArray()"
                    Deshabilitado="@(Registrando || RevisandoVenta || AgregandoUnidad || PedidoAutomaticoCreado is not null)" OnSeleccionado="AgregarUnidadAsync" />
                <h2>Artículos agregados a la venta</h2>
                @if (Unidades.Count == 0) { <p>Busca una unidad disponible y agrégala a la venta.</p> }
                @foreach (var detalle in Unidades)
                {
                    <article class="order-line-editor" @key="detalle.Unidad.Id">
                        <h3>@detalle.Unidad.Producto</h3>
                        <p class="code-value">@detalle.Unidad.CodigoInterno</p>
                        <div class="form-field">
                            <label for="precio-directo-@detalle.Unidad.Id">Precio final</label>
                            <input inputmode="decimal" data-select-once="true" id="precio-directo-@detalle.Unidad.Id" type="number" step="0.01" min="0" @bind="detalle.PrecioFinal"
                                disabled="@(Registrando || RevisandoVenta || PedidoAutomaticoCreado is not null)" />
                        </div>
                        <button type="button" class="inline-button" disabled="@(Registrando || RevisandoVenta || PedidoAutomaticoCreado is not null)"
                            @onclick="() => QuitarUnidad(detalle)">Quitar artículo</button>
                    </article>
                }
            </section>

            <div class="form-actions sale-submit-actions">
                <button class="primary-button" type="submit" disabled="@(Registrando || RevisandoVenta || AgregandoUnidad || Seleccionadas.Count == 0)">
                    @(Registrando
                        ? "Registrando..."
                        : PedidoAutomaticoCreado is null
                            ? "Revisar venta"
                            : "Revisar reintento de venta")
                </button>
                <a class="secondary-button" href="/ventas">Cancelar</a>
            </div>
        </EditForm>
}

@if (RevisandoVenta)
{
    <ConfirmacionOperacion Titulo="Confirmar venta directa" TextoConfirmar="Confirmar venta"
                           Ocupado="Registrando" Error="@ErrorGuardado" OnEditar="EditarVentaAsync" OnConfirmar="ConfirmarVentaAsync">
        <p>Cliente: @ClientePresentacion.NombreCompleto(Clientes.First(x => x.Id == Modelo.ClienteId))</p>
        <p>Venta directa · Presencial · @Modelo.Fecha.ToString("dd/MM/yyyy")</p>
        <ul>
            @foreach (var detalle in Seleccionadas)
            {
                <li>@detalle.Unidad.Producto · @detalle.Unidad.CodigoInterno:
                    1 × @VentaPresentacion.Moneda(detalle.PrecioFinal) = @VentaPresentacion.Moneda(detalle.PrecioFinal)</li>
            }
        </ul>
        <p><strong>Total: @VentaPresentacion.Moneda(Seleccionadas.Sum(x => x.PrecioFinal))</strong></p>
        <p>Saldo estimado: @ClientePresentacion.Moneda(Clientes.First(x => x.Id == Modelo.ClienteId).Saldo + Seleccionadas.Sum(x => x.PrecioFinal)). Los abonos se registran por separado.</p>
        @if (PedidoAutomaticoCreado is not null)
        {
            <p>Se reutilizará el pedido @PedidoAutomaticoCreado.CodigoInterno. Los datos ya registrados en él no se pueden editar aquí.</p>
        }
    </ConfirmacionOperacion>
}

@code {
    private bool RevisandoVenta { get; set; }
    private async Task RevisarVentaDirectaAsync()
    {
        if (Registrando || AgregandoUnidad || RevisandoVenta) return;
        ErrorGuardado = ValidacionFormulario.PrimerError(Modelo) ?? Validar(Seleccionadas);
        if (ErrorGuardado is not null) return;
        RevisandoVenta = true;
        await OcupadoChanged.InvokeAsync(true);
    }
    private async Task EditarVentaAsync()
    {
        if (Registrando) return;
        RevisandoVenta = false;
        await OcupadoChanged.InvokeAsync(false);
    }
    private Task ConfirmarVentaAsync() => RevisandoVenta && !Registrando ? RegistrarVentaDirectaAsync() : Task.CompletedTask;
    [Parameter]
    public EventCallback<bool> OcupadoChanged { get; set; }

    private VentaDirectaFormModel Modelo { get; } = new();
    private string CodigoPedidoDirecto { get; } = VentaPresentacion.CrearCodigoPedidoVentaDirecta();
    private string CodigoVentaDirecta { get; } = VentaPresentacion.CrearCodigoVentaDirecta();
    private IReadOnlyList<ClienteDto> Clientes { get; set; } = [];
    private List<UnidadVentaDirectaFormModel> Unidades { get; set; } = [];
    private PedidoDto? PedidoAutomaticoCreado { get; set; }
    private bool Cargando { get; set; } = true;
    private bool Registrando { get; set; }
    private string? ErrorCarga { get; set; }
    private string? ErrorGuardado { get; set; }

    private IReadOnlyList<UnidadVentaDirectaFormModel> Seleccionadas =>
        Unidades.Where(x => x.Seleccionada).ToList();

    [Parameter] public string? ClienteDesdeQuery { get; set; }
    private string? ClienteQueryCargado;
    private bool Inicializado;
    private bool AgregandoUnidad;
    private int RevisionBuscador;
    private ClienteDto? ClienteSeleccionado { get; set; }
    protected override Task OnParametersSetAsync() => !Registrando && !RevisandoVenta && PedidoAutomaticoCreado is null
        && (!Inicializado || ClienteQueryCargado != ClienteDesdeQuery) ? CargarAsync() : Task.CompletedTask;
    private void ElegirCliente(ClienteDto? cliente)
    {
        if (Registrando || RevisandoVenta || PedidoAutomaticoCreado is not null) return;
        ClienteSeleccionado = cliente; Modelo.ClienteId = cliente?.Id ?? 0; Clientes = cliente is null ? [] : [cliente];
        ErrorGuardado = null;
    }
    private async Task AgregarUnidadAsync(UnidadInventarioDto? unidad)
    {
        if (unidad is null || Registrando || RevisandoVenta || AgregandoUnidad || PedidoAutomaticoCreado is not null || Unidades.Any(x => x.Unidad.Id == unidad.Id)) return;
        AgregandoUnidad = true;
        try
        {
            var producto = await ProductoService.ObtenerPorIdAsync(unidad.ProductoId);
            if (!producto.IsSuccess || producto.Value is null) { ErrorGuardado = "No pudimos cargar el producto. Vuelve a buscar la unidad."; return; }
            Unidades.Add(new UnidadVentaDirectaFormModel { Unidad = unidad, Seleccionada = true, PrecioFinal = producto.Value.PrecioSugerido });
            RevisionBuscador++;
        }
        catch (Exception ex) { Logger.LogError(ex, "No fue posible agregar la unidad a la venta."); ErrorGuardado = "No pudimos agregar la unidad. Intenta nuevamente."; }
        finally { AgregandoUnidad = false; }
    }
    private void QuitarUnidad(UnidadVentaDirectaFormModel detalle)
    {
        if (!Registrando && !RevisandoVenta && PedidoAutomaticoCreado is null) Unidades.Remove(detalle);
    }

    private async Task CargarAsync()
    {
        Cargando = true;
        ErrorCarga = null;
        try
        {
            await OcupadoChanged.InvokeAsync(true);
            Inicializado = true; ClienteQueryCargado = ClienteDesdeQuery;
            if (ClienteDesdeQuery is not null)
            {
                if (!int.TryParse(ClienteDesdeQuery, out var id) || id <= 0) { ElegirCliente(null); ErrorGuardado = "El cliente del enlace no es válido. Busca otro cliente."; }
                else
                {
                    var cliente = await ClienteService.ObtenerPorIdAsync(id);
                    ElegirCliente(cliente.IsSuccess ? cliente.Value : null);
                    if (ClienteSeleccionado is null) ErrorGuardado = "El cliente del enlace no está disponible. Busca otro cliente.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No fue posible cargar clientes e inventario para venta directa.");
            ErrorCarga = "Ocurrió un problema inesperado al cargar clientes e inventario. Intenta nuevamente.";
        }
        finally
        {
            Cargando = false;
            await OcupadoChanged.InvokeAsync(false);
        }
    }

    private async Task RegistrarVentaDirectaAsync()
    {
        if (Registrando || AgregandoUnidad)
            return;

        var seleccionadas = Seleccionadas;
        ErrorGuardado = Validar(seleccionadas);
        if (ErrorGuardado is not null)
            return;

        Registrando = true;
        try
        {
            await OcupadoChanged.InvokeAsync(true);
            if (PedidoAutomaticoCreado is null)
            {
                if (!await SiguenElegiblesAsync(seleccionadas))
                    return;

                var pedidoInput = new PedidoInput(
                    CodigoPedidoDirecto,
                    Modelo.Fecha,
                    TipoPedido.VentaDirecta,
                    CanalVenta.Presencial,
                    Modelo.ClienteId,
                    ConstruirObservacionesPedido(),
                    seleccionadas.Select(x => x.ToPedidoInput()).ToArray());
                var pedido = await PedidoService.CrearAsync(pedidoInput);
                if (!pedido.IsSuccess || pedido.Value is null)
                {
                    ErrorGuardado = pedido.ErrorMessage ?? "No fue posible crear el pedido automático.";
                    return;
                }

                PedidoAutomaticoCreado = pedido.Value;
            }

            var ventaInput = new VentaInput(
                PedidoAutomaticoCreado.Id,
                CodigoVentaDirecta,
                Modelo.Fecha,
                Modelo.Observaciones,
                seleccionadas.Select(x => x.ToVentaInput()).ToArray());
            var venta = await VentaService.RegistrarDesdePedidoAsync(ventaInput);
            if (!venta.IsSuccess || venta.Value is null)
            {
                ErrorGuardado =
                    $"El pedido automático {PedidoAutomaticoCreado.CodigoInterno} fue creado, "
                    + $"pero la venta no pudo registrarse: {venta.ErrorMessage ?? "error no especificado"}.";
                return;
            }

            RevisandoVenta = false;
            Navigation.NavigateTo($"/ventas/{venta.Value.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No fue posible registrar la venta directa. Pedido automático: {PedidoId}.",
                PedidoAutomaticoCreado?.Id);
            ErrorGuardado = PedidoAutomaticoCreado is null
                ? "Ocurrió un problema inesperado antes de crear el pedido automático. Intenta nuevamente."
                : $"El pedido automático {PedidoAutomaticoCreado.CodigoInterno} fue creado, pero ocurrió un problema inesperado al registrar la venta.";
        }
        finally
        {
            Registrando = false;
            await OcupadoChanged.InvokeAsync(RevisandoVenta);
        }
    }

    private async Task<bool> SiguenElegiblesAsync(
        IReadOnlyCollection<UnidadVentaDirectaFormModel> seleccionadas)
    {
        if (await SeleccionService.UnidadesDirectasDisponiblesAsync(seleccionadas.Select(x => x.Unidad.Id).ToArray()))
            return true;

        ErrorGuardado = "Una o más unidades ya no están disponibles o recibieron una reserva. Actualiza la página antes de continuar.";
        return false;
    }

    private string? Validar(IReadOnlyCollection<UnidadVentaDirectaFormModel> seleccionadas)
    {
        if (!Clientes.Any(x => x.Id == Modelo.ClienteId))
            return "Selecciona un cliente válido.";
        if (seleccionadas.Count == 0)
            return "Selecciona al menos una unidad física.";
        if (seleccionadas.Any(x => !VentaPresentacion.EsUnidadElegibleVentaDirecta(x.Unidad)))
            return "Solo pueden venderse unidades disponibles y sin reserva activa.";
        if (VentaPresentacion.TieneUnidadesDuplicadas(seleccionadas.Select(x => x.Unidad.Id)))
            return "Una unidad de inventario no puede seleccionarse dos veces.";
        if (seleccionadas.Any(x => x.PrecioFinal < 0))
            return "El precio final no puede ser negativo.";
        return null;
    }

    private string ConstruirObservacionesPedido() =>
        string.IsNullOrWhiteSpace(Modelo.Observaciones)
            ? "Pedido generado automáticamente desde una venta directa presencial."
            : Modelo.Observaciones.Trim();
}
