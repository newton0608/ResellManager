@* Blazor actualiza las clases de estado y los contadores de este único elemento. *@
<dialog id="components-reconnect-modal" class="components-reconnect-hide ui-card m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-md overflow-y-auto p-5 font-sans text-ui-ink shadow-ui-sheet [overflow-wrap:anywhere] backdrop:bg-ui-ink/40 sm:p-6" data-permanent
        aria-modal="true" aria-labelledby="reconnect-title-show" aria-busy="false">
    <section class="reconnect-state reconnect-state-show min-w-0 justify-items-center gap-4 rounded-2xl text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" tabindex="-1"
             role="status" aria-live="polite" aria-atomic="true">
        <span class="inline-block size-10 rounded-full border-4 border-solid border-ui-accent/15 border-t-ui-accent motion-safe:animate-spin" aria-hidden="true"></span>
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="reconnect-title-show">Reconectando…</h2>
        <p class="m-0 text-sm leading-6 text-ui-muted" id="reconnect-description-show">Intentando conectar con el servidor.</p>
        <p class="reconnect-attempts m-0 text-sm leading-6 text-ui-muted tabular-nums">
            Intento <span id="components-reconnect-current-attempt"></span>
            de <span id="components-reconnect-max-retries"></span>
        </p>
    </section>
    <section class="reconnect-state reconnect-state-failed min-w-0 justify-items-center gap-4 rounded-2xl text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" tabindex="-1"
             role="alert" aria-live="assertive" aria-atomic="true">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="reconnect-title-failed">No se pudo restablecer la conexión</h2>
        <p class="m-0 text-sm leading-6 text-ui-muted" id="reconnect-description-failed">Revisa tu conexión a Internet e intenta nuevamente.</p>
        <button id="reconnect-retry" class="ui-button w-full bg-ui-accent text-white hover:bg-ui-accent-hover" type="button">Reintentar</button>
    </section>
    <section class="reconnect-state reconnect-state-rejected min-w-0 justify-items-center gap-4 rounded-2xl text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ui-accent" tabindex="-1"
             role="alert" aria-live="assertive" aria-atomic="true">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ui-ink" id="reconnect-title-rejected">La sesión ya no está disponible</h2>
        <p class="m-0 text-sm leading-6 text-ui-muted" id="reconnect-description-rejected">Recarga la página para continuar.</p>
        <button id="reconnect-reload" class="ui-button w-full bg-ui-accent text-white hover:bg-ui-accent-hover" type="button">Recargar página</button>
    </section>
</dialog>
