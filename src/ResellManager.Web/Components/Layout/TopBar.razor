<header class="topbar">
    <div class="topbar-start">
        <button class="icon-button menu-button" type="button" popovertarget="navegacion-movil"
                popovertargetaction="show" aria-controls="navegacion-movil" aria-label="Abrir menú">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
        <span class="topbar-title">Panel de administración</span>
    </div>

    <AuthorizeView>
        <Authorized Context="estadoAutenticacion">
            <div class="session-area">
                <div class="user-summary" title="@estadoAutenticacion.User.Identity?.Name">
                    <span class="user-avatar" aria-hidden="true">@GetInitial(estadoAutenticacion.User.Identity?.Name)</span>
                    <span class="user-copy">
                        <small>Sesión iniciada</small>
                        <strong>@estadoAutenticacion.User.Identity?.Name</strong>
                    </span>
                </div>
                <form method="post" action="/account/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="confirmacion" value="true" />
                    <button class="logout-button" type="submit">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10 17l5-5-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        </svg>
                        <span>Cerrar sesión</span>
                    </button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

@code {
    private static string GetInitial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "U" : name.Trim()[0].ToString().ToUpperInvariant();
}
