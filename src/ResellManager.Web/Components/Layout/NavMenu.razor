<div class="brand" aria-label="ResellManager">
    <img src="branding/resellmanager-logo-light.png" alt="ResellManager"
         class="block h-10 w-40 max-w-full object-cover" width="1536" height="1024" />
</div>

<nav class="primary-nav" aria-label="Navegación principal">
    <p class="nav-section-label">Menú principal</p>
    <ul>
        @foreach (var item in Items)
        {
            <li>
                <NavLink href="@item.Href" Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <NavIcon Name="@item.Icon" />
                    <span>@item.Label</span>
                </NavLink>
            </li>
        }
    </ul>
</nav>

<div class="sidebar-note">
    <span class="status-dot" aria-hidden="true"></span>
    <span>Acceso privado</span>
</div>

@code {
    private static readonly NavigationItem[] Items =
    [
        new("/", "Dashboard", "home", true),
        new("/clientes", "Clientes", "users"),
        new("/productos", "Productos", "tag"),
        new("/inventario", "Inventario", "boxes"),
        new("/pedidos", "Pedidos", "clipboard"),
        new("/ventas", "Ventas", "cart"),
        new("/pagos", "Pagos", "wallet"),
        new("/compras", "Compras", "bag"),
        new("/proveedores", "Proveedores", "truck"),
        new("/categorias", "Categorías", "grid")
    ];

    private sealed record NavigationItem(string Href, string Label, string Icon, bool Exact = false);
}
