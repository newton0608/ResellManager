<div class="relative flex aspect-[4/5] items-center justify-center overflow-hidden bg-ui-canvas">
    <div class="flex flex-col items-center gap-3 p-4 text-center text-ui-muted" aria-hidden="@((Decorativa || (TieneImagen && !Fallida)) ? "true" : null)">
        <svg class="size-10 opacity-60 sm:size-12" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="9" y="9" width="30" height="30" rx="5" />
            <circle cx="19" cy="19" r="3" />
            <path d="m10 34 9-9 7 7 5-5 8 8" />
        </svg>
        <span class="text-xs sm:text-sm">Imagen no disponible</span>
    </div>
    @if (TieneImagen && !Fallida)
    {
        <img src="/api/catalogo/productos/@ProductoId/imagen" alt="@(Decorativa ? "" : Nombre)"
             class="absolute inset-0 h-full w-full bg-ui-canvas object-contain p-3 sm:p-5"
             loading="@(Prioritaria ? "eager" : "lazy")" decoding="async" @onerror="ImagenFallida" />
    }
</div>

@code {
    [Parameter, EditorRequired] public int ProductoId { get; set; }
    [Parameter] public string Nombre { get; set; } = string.Empty;
    [Parameter] public bool TieneImagen { get; set; }
    [Parameter] public bool Decorativa { get; set; }
    [Parameter] public bool Prioritaria { get; set; }
    private bool Fallida { get; set; }
    private (int Id, bool TieneImagen)? Anterior;
    protected override void OnParametersSet()
    {
        if (Anterior != (ProductoId, TieneImagen)) { Fallida = false; Anterior = (ProductoId, TieneImagen); }
    }
    private void ImagenFallida() => Fallida = true;
}
