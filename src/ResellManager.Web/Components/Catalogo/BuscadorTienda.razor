@implements IDisposable
@inject BusquedaTiendaEstado Estado
@inject NavigationManager Navegacion

<form method="get" action="/catalogo" class="store-search" role="search"
      @onsubmit="EnviarAsync" @onsubmit:preventDefault>
    <svg class="store-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.6" /><path d="m16 16 4.3 4.3" />
    </svg>
    <label class="sr-only" for="catalogo-busqueda">Buscar productos</label>
    <input id="catalogo-busqueda" name="termino" type="search" class="store-search-input"
           placeholder="Buscar en la tienda" autocomplete="off" value="@Estado.Termino"
           @oninput="CambiarTextoAsync" />
    <button class="store-search-button" type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 5 7 7-7 7" />
        </svg>
    </button>
</form>

@code {
    private bool descartado;

    protected override void OnInitialized()
    {
        Estado.Cambio += Actualizar;
        Navegacion.LocationChanged += UbicacionCambiada;
        Estado.FijarTermino(LeerTermino());
    }

    private string LeerTermino()
    {
        var uri = new Uri(Navegacion.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        return query.TryGetValue("termino", out var termino) ? termino.ToString() : string.Empty;
    }

    private void UbicacionCambiada(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => Estado.FijarTermino(LeerTermino());

    private void Actualizar()
    {
        if (!descartado) _ = InvokeAsync(StateHasChanged);
    }

    private Task CambiarTextoAsync(ChangeEventArgs e)
    {
        var termino = e.Value?.ToString() ?? string.Empty;
        if (Estado.TieneCatalogo) return Estado.BuscarAsync(termino);
        Estado.FijarTermino(termino);
        return Task.CompletedTask;
    }

    private async Task EnviarAsync()
    {
        if (Estado.TieneCatalogo)
        {
            await Estado.EnviarAsync();
            return;
        }

        var limpio = Estado.Termino.Trim();
        Navegacion.NavigateTo(limpio.Length == 0
            ? "/catalogo"
            : "/catalogo?termino=" + Uri.EscapeDataString(limpio));
    }

    public void Dispose()
    {
        descartado = true;
        Navegacion.LocationChanged -= UbicacionCambiada;
        Estado.Cambio -= Actualizar;
    }
}