@page "/catalogo"
@attribute [AllowAnonymous]
@layout CatalogoLayout
@rendermode InteractiveServer
@implements IDisposable
@inject ICatalogoPublicoClient Cliente
@inject ILogger<Catalogo> Logger
@inject BusquedaTiendaEstado Busqueda
@inject NavigationManager Navegacion

<PageTitle>Catálogo | Virtuosa Store</PageTitle>
<CatalogoVista Modelo="Modelo" OnCategoria="FiltrarCategoriaAsync" OnMarca="FiltrarMarcaAsync"
               OnLimpiar="LimpiarAsync" OnReintentar="Modelo.CargarAsync" OnMas="Modelo.CargarMasAsync" />

@code {
    [SupplyParameterFromQuery(Name = "termino")] public string? TerminoInicial { get; set; }
    [SupplyParameterFromQuery(Name = "categoriaId")] public int? CategoriaInicial { get; set; }
    [SupplyParameterFromQuery(Name = "marca")] public string? MarcaInicial { get; set; }
    private CatalogoListadoModelo Modelo = null!;
    private (string? Termino, int? Categoria, string? Marca)? Anterior;
    private bool Pendiente;
    private bool Descartado;

    protected override void OnInitialized()
    {
        Modelo = new(Cliente, Logger);
        Busqueda.Registrar(this, BuscarDesdeEncabezadoAsync, BuscarAhoraDesdeEncabezadoAsync);
    }

    protected override void OnParametersSet()
    {
        if (Anterior == (TerminoInicial, CategoriaInicial, MarcaInicial)) return;
        Anterior = (TerminoInicial, CategoriaInicial, MarcaInicial);
        Modelo.EstablecerFiltros(TerminoInicial, CategoriaInicial, MarcaInicial);
        Busqueda.FijarTermino(Modelo.Termino);
        Pendiente = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Pendiente) return;
        Pendiente = false;
        await Modelo.CargarAsync();
        if (!Descartado) StateHasChanged();
    }

    private async Task BuscarDesdeEncabezadoAsync(string termino)
    {
        var carga = Modelo.BuscarAsync(termino);
        await ActualizarUrlAsync(reemplazar: true);
        await InvokeAsync(StateHasChanged);
        await carga;
        if (!Descartado) await InvokeAsync(StateHasChanged);
    }

    private async Task BuscarAhoraDesdeEncabezadoAsync()
    {
        var carga = Modelo.CargarAsync();
        await InvokeAsync(StateHasChanged);
        await carga;
        if (!Descartado) await InvokeAsync(StateHasChanged);
    }

    private async Task LimpiarAsync()
    {
        Busqueda.FijarTermino(string.Empty);
        await Modelo.LimpiarAsync();
        await ActualizarUrlAsync();
    }

    private async Task FiltrarCategoriaAsync(int? id)
    {
        await Modelo.FiltrarCategoriaAsync(id);
        await ActualizarUrlAsync();
    }
    private async Task FiltrarMarcaAsync(string? marca)
    {
        await Modelo.FiltrarMarcaAsync(marca);
        await ActualizarUrlAsync();
    }
    private Task ActualizarUrlAsync(bool reemplazar = false)
    {
        if (Descartado) return Task.CompletedTask;
        var termino = string.IsNullOrWhiteSpace(Modelo.Termino) ? null : Modelo.Termino.Trim();
        var marca = string.IsNullOrWhiteSpace(Modelo.Marca) ? null : Modelo.Marca;
        var uri = Navegacion.GetUriWithQueryParameters(new Dictionary<string, object?>
        { ["termino"] = termino, ["categoriaId"] = Modelo.CategoriaId, ["marca"] = marca });
        // El modelo ya consultó estos filtros; el router conserva historial y back/forward.
        Anterior = (termino, Modelo.CategoriaId, marca);
        if (Navegacion.Uri != uri) Navegacion.NavigateTo(uri, replace: reemplazar);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Descartado = true;
        Busqueda.Liberar(this);
        Modelo.Dispose();
    }
}