@page "/catalogo"
@attribute [AllowAnonymous]
@layout CatalogoLayout
@rendermode InteractiveServer
@implements IDisposable
@inject ICatalogoPublicoClient Cliente
@inject ILogger<Catalogo> Logger

<PageTitle>Catálogo | ResellManager</PageTitle>
<CatalogoVista Modelo="Modelo" OnBuscar="Modelo.BuscarAsync" OnCategoria="Modelo.FiltrarCategoriaAsync"
               OnBuscarAhora="Modelo.CargarAsync" OnLimpiar="Modelo.LimpiarAsync" OnReintentar="Modelo.CargarAsync" />

@code {
    [SupplyParameterFromQuery(Name = "termino")] public string? TerminoInicial { get; set; }
    [SupplyParameterFromQuery(Name = "categoriaId")] public int? CategoriaInicial { get; set; }
    private CatalogoListadoModelo Modelo = null!;
    private (string? Termino, int? Categoria)? Anterior;
    private bool Pendiente;
    private bool Descartado;

    protected override void OnInitialized() => Modelo = new(Cliente, Logger);
    protected override void OnParametersSet()
    {
        if (Anterior == (TerminoInicial, CategoriaInicial)) return;
        Anterior = (TerminoInicial, CategoriaInicial);
        Modelo.EstablecerFiltros(TerminoInicial, CategoriaInicial);
        Pendiente = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Pendiente) return;
        Pendiente = false;
        await Modelo.CargarAsync();
        if (!Descartado) StateHasChanged();
    }
    public void Dispose() { Descartado = true; Modelo.Dispose(); }
}
