<section class="store-hero" aria-labelledby="titulo-catalogo">
    <p class="store-eyebrow">Virtuosa Store · Catálogo</p>
    <h1 id="titulo-catalogo" class="store-hero-title">Encuentra lo que va contigo.</h1>
    <p class="store-hero-copy">Ropa, accesorios, perfumes y más. Descubre nuestra selección disponible.</p>
</section>

<section id="productos" aria-labelledby="titulo-seleccion" aria-busy="@(Modelo.Cargando ? "true" : "false")">
    <div class="store-collection-head">
        <div>
            <p class="store-eyebrow">La colección</p>
            <h2 id="titulo-seleccion" class="store-section-title">Para explorar hoy</h2>
            <p class="store-section-subtitle">Piezas para cada estilo y ocasión.</p>
        </div>
    </div>
    <div class="store-filter-row" aria-label="Filtrar productos">
        <div class="store-filter-field">
            <label class="store-filter-label" for="catalogo-categoria">Categoría</label>
            <select @key="Modelo.Categorias" id="catalogo-categoria" name="categoriaId" class="store-input"
                    value="@(Modelo.CategoriaId?.ToString() ?? "")"
                    @onchange="CambiarCategoriaAsync" disabled="@(!Modelo.CategoriasCargadas)">
                <option value="">Todas las categorías</option>
                @if (Modelo.CategoriaId is { } seleccionada && !Modelo.Categorias.Any(c => c.Id == seleccionada))
                {
                    <option value="@seleccionada">Categoría no disponible</option>
                }
                @foreach (var categoria in Modelo.Categorias)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </select>
        </div>
        @if (!string.IsNullOrWhiteSpace(Modelo.Termino))
        {
            <span class="store-active-filter">Búsqueda: @Modelo.Termino.Trim()</span>
        }
        @if (Modelo.TieneFiltros)
        {
            <button class="store-button store-button--quiet" type="button" @onclick="OnLimpiar">Limpiar</button>
        }
        @if (!Modelo.Cargando && Modelo.Error is null)
        {
            <span class="store-product-count" aria-live="polite">@Modelo.Productos.Count @(Modelo.Productos.Count == 1 ? "producto" : "productos")</span>
        }
    </div>

    @if (Modelo.Cargando)
    {
        <p class="store-loading" role="status" aria-live="polite">
            <span class="store-spinner" aria-hidden="true"></span>Cargando productos…
        </p>
    }
    @if (Modelo.Error is not null)
    {
        <CatalogoEstado Titulo="El catálogo no está disponible por el momento" Mensaje="@Modelo.Error" EsError="true" OnAccion="OnReintentar" />
    }
    else if (Modelo.Productos.Count > 0)
    {
        <div class="store-grid">
            @foreach (var producto in Modelo.Productos)
            {
                <ProductoCatalogoTarjeta @key="producto.Id" Producto="producto" />
            }
        </div>
    }
    else if (Modelo.Cargando)
    {
        <div class="store-grid" aria-hidden="true">
            @for (var i = 0; i < 4; i++)
            {
                <div class="store-skeleton">
                    <div class="store-skeleton-photo"></div>
                    <div class="store-skeleton-lines"><i></i><i></i><i></i></div>
                </div>
            }
        </div>
    }
    else if (Modelo.TieneFiltros)
    {
        <CatalogoEstado Titulo="No encontramos productos con estos filtros" Mensaje="Prueba con otro nombre o explora todas las categorías."
                        TextoAccion="Ver todos los productos" OnAccion="OnLimpiar" />
    }
    else
    {
        <CatalogoEstado Titulo="Por ahora no hay productos disponibles" Mensaje="Vuelve a consultar más adelante para descubrir nuestra selección." />
    }
</section>

@code {
    [Parameter, EditorRequired] public CatalogoListadoModelo Modelo { get; set; } = null!;
    [Parameter] public EventCallback<int?> OnCategoria { get; set; }
    [Parameter] public EventCallback OnLimpiar { get; set; }
    [Parameter] public EventCallback OnReintentar { get; set; }
    private Task CambiarCategoriaAsync(ChangeEventArgs e) => OnCategoria.InvokeAsync(int.TryParse(e.Value?.ToString(), out var id) ? id : null);
}