<section class="mb-8 rounded-3xl bg-ui-accent/5 px-5 py-8 sm:px-8 sm:py-10" aria-labelledby="titulo-catalogo">
    <p class="eyebrow">Catálogo de ResellManager</p>
    <h1 id="titulo-catalogo"><span class="block max-w-2xl text-3xl leading-tight tracking-tight sm:text-4xl lg:text-5xl">Descubre algo para ti.</span></h1>
    <p class="mb-0 mt-4 max-w-xl text-sm text-ui-muted sm:text-base">Explora ropa, accesorios, perfumes y más. Encuentra aquí nuestra selección disponible.</p>
</section>

<form method="get" action="/catalogo" class="mb-8 grid grid-cols-1 items-end gap-4 rounded-2xl border border-solid border-ui-border bg-white p-4 sm:p-5 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_auto]"
      @onsubmit="OnBuscarAhora" @onsubmit:preventDefault aria-label="Buscar y filtrar productos">
    <div class="form-field min-w-0">
        <label for="catalogo-busqueda">Buscar productos</label>
        <input id="catalogo-busqueda" name="termino" type="search" placeholder="¿Qué estás buscando?" autocomplete="off"
               value="@Modelo.Termino" @oninput="CambiarTextoAsync" disabled="@(!Modelo.CategoriasCargadas)" />
    </div>
    <div class="form-field min-w-0">
        <label for="catalogo-categoria">Categoría</label>
        <select @key="Modelo.Categorias" id="catalogo-categoria" name="categoriaId" value="@(Modelo.CategoriaId?.ToString() ?? "")"
                @onchange="CambiarCategoriaAsync" disabled="@(!Modelo.CategoriasCargadas)">
            <option value="">Todas las categorías</option>
            @if (Modelo.CategoriaId is { } seleccionada && !Modelo.Categorias.Any(c => c.Id == seleccionada))
            {
                <option value="@seleccionada">Categoría no disponible</option>
            }
            @foreach (var categoria in Modelo.Categorias)
            {
                <option value="@categoria.Id">@categoria.Nombre</option>
            }
        </select>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="primary-button grow md:grow-0" type="submit" disabled="@(!Modelo.CategoriasCargadas)">Buscar</button>
        <button class="secondary-button grow md:grow-0" type="button" @onclick="OnLimpiar" disabled="@(!Modelo.TieneFiltros)">Limpiar</button>
    </div>
</form>

<section id="productos" aria-labelledby="titulo-seleccion" aria-busy="@(Modelo.Cargando ? "true" : "false")">
    <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="titulo-seleccion">Explora nuestra selección</h2>
        @if (!Modelo.Cargando && Modelo.Error is null)
        {
            <span class="text-sm text-ui-muted">@Modelo.Productos.Count @(Modelo.Productos.Count == 1 ? "producto" : "productos")</span>
        }
    </div>
    @if (Modelo.Cargando)
    {
        <p class="mb-5 mt-0 flex items-center gap-3 text-sm text-ui-muted" role="status" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>Cargando productos…
        </p>
    }
    @if (Modelo.Error is not null)
    {
        <CatalogoEstado Titulo="El catálogo no está disponible por el momento" Mensaje="@Modelo.Error" EsError="true" OnAccion="OnReintentar" />
    }
    else if (Modelo.Productos.Count > 0)
    {
        <div class="grid grid-cols-1 gap-4 min-[360px]:grid-cols-2 md:grid-cols-3 md:gap-5 xl:grid-cols-4">
            @foreach (var producto in Modelo.Productos)
            {
                <ProductoCatalogoTarjeta @key="producto.Id" Producto="producto" />
            }
        </div>
    }
    else if (Modelo.Cargando)
    {
        <div class="grid grid-cols-1 gap-4 min-[360px]:grid-cols-2 md:grid-cols-3 md:gap-5 xl:grid-cols-4" aria-hidden="true">
            @for (var i = 0; i < 4; i++)
            {
                <div class="overflow-hidden rounded-2xl border border-solid border-ui-border bg-white motion-safe:animate-pulse">
                    <div class="aspect-[4/5] bg-slate-200/60"></div>
                    <div class="space-y-3 p-5"><div class="h-3 w-1/3 rounded bg-slate-100"></div><div class="h-4 w-3/4 rounded bg-slate-200"></div><div class="h-5 w-1/2 rounded bg-slate-200"></div></div>
                </div>
            }
        </div>
    }
    else if (Modelo.TieneFiltros)
    {
        <CatalogoEstado Titulo="No encontramos productos con estos filtros" Mensaje="Prueba con otro nombre o explora todas las categorías."
                        TextoAccion="Ver todos los productos" OnAccion="OnLimpiar" />
    }
    else
    {
        <CatalogoEstado Titulo="Por ahora no hay productos disponibles" Mensaje="Vuelve a consultar más adelante para descubrir nuestra selección." />
    }
</section>

@code {
    [Parameter, EditorRequired] public CatalogoListadoModelo Modelo { get; set; } = null!;
    [Parameter] public EventCallback<string> OnBuscar { get; set; }
    [Parameter] public EventCallback<int?> OnCategoria { get; set; }
    [Parameter] public EventCallback OnBuscarAhora { get; set; }
    [Parameter] public EventCallback OnLimpiar { get; set; }
    [Parameter] public EventCallback OnReintentar { get; set; }
    private Task CambiarTextoAsync(ChangeEventArgs e) => OnBuscar.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    private Task CambiarCategoriaAsync(ChangeEventArgs e) => OnCategoria.InvokeAsync(int.TryParse(e.Value?.ToString(), out var id) ? id : null);
}
