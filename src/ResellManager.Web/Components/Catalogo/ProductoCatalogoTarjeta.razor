<article class="group h-full overflow-hidden rounded-2xl border border-solid border-ui-border bg-white motion-safe:transition-shadow hover:shadow-md">
    <a href="/catalogo/@Producto.Id" class="flex h-full flex-col no-underline">
        <ImagenCatalogo ProductoId="Producto.Id" Nombre="@Producto.Nombre" TieneImagen="Producto.TieneImagenPrincipal" Decorativa="true" />
        <div class="flex flex-1 flex-col gap-2 p-3 sm:p-5">
            <p class="m-0 text-xs text-ui-muted sm:text-sm">@Producto.Categoria</p>
            <h3 class="m-0 line-clamp-2 break-words text-sm leading-snug font-semibold sm:text-base">@Producto.Nombre</h3>
            <div class="mt-auto flex flex-col items-start gap-2 pt-2 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
                <p class="m-0 text-base font-bold tabular-nums sm:text-xl">@CatalogoPresentacion.Precio(Producto.PrecioPublico)</p>
                @if (Producto.Disponible)
                {
                    <span class="rounded-full bg-ui-success/5 px-2 py-1 text-xs font-medium text-ui-success">Disponible</span>
                }
            </div>
            <span class="mt-1 flex items-center gap-1 text-xs font-semibold text-ui-accent sm:text-sm">
                Ver producto
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
            </span>
        </div>
    </a>
</article>

@code {
    [Parameter, EditorRequired] public ProductoCatalogoDto Producto { get; set; } = null!;
}
